---
pagination:
  data: stores.pagesTestA
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% if store.theme == "wagyu" %}
{% set IMG = {
  hero:    "/images/ロコ_あり和牛.mp4",
  poster:  "/images/ロコ_あり和牛-poster.jpg",
  lead:    "/images/wagyu-lead.jpg",
  concept: "/images/course-kobe-premium.jpg",
  band:    "/images/cat-wagyu.jpg",
  col_a:   "/images/course-wagyu-standard.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/chef3.jpg"
} %}
{% else %}
{% set IMG = {
  hero:    "/images/ロコ_あり寿司.mp4",
  poster:  "/images/ロコ_あり寿司-poster.jpg",
  lead:    "/images/sushi1.jpg",
  concept: "/images/sushi2.jpg",
  band:    "/images/cat-sushi.jpg",
  col_a:   "/images/course-sushi-premium.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/sushi4.jpg"
} %}
{% endif %}
{% set TCATS = courses.themes[store.theme] or courses.themes.all %}
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
{% macro circ() %}<span class="circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Sushi &amp; Wagyu Halal Omakase Experience — {{ store.name_full_en }}"/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-a',theme:'{{ store.theme }}'});</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>

<style>
:root{
  --navy:#111a2b; --navy-2:#162034; --navy-3:#0c1322;
  --w:#f4f2ef; --w-d:rgba(244,242,239,.86); --w-f:rgba(244,242,239,.62);
  --shu:#a8342a; --shu-l:#c4463a; --gold:#d6b878;
  --line:rgba(244,242,239,.20);
  --disp:'Lora',serif; --body:'Jost',sans-serif;
  --gut:clamp(22px,5.5vw,80px);
  --rv-bg:var(--navy-2); --rv-panel:var(--navy-3); --rv-line:var(--line);
  --rv-text:var(--w); --rv-muted:var(--w-f); --rv-accent:var(--shu-l);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:4px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--navy);color:var(--w);font-family:var(--body);font-weight:400;line-height:1.8;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
  background-image:repeating-radial-gradient(circle at 16% 34%,rgba(242,240,236,.022) 0 1px,transparent 1px 58px);}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
.wrap{width:100%;max-width:1320px;margin-inline:auto;padding-inline:var(--gut);}
.narrow{width:100%;max-width:820px;margin-inline:auto;padding-inline:var(--gut);}
.pad{padding:clamp(66px,10vw,142px) 0;}

.eyebrow{display:inline-block;font-family:var(--body);font-weight:500;font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);}
.h-en{font-family:var(--disp);font-weight:400;line-height:1.28;font-size:clamp(26px,4.2vw,50px);letter-spacing:-.006em;}
.p{font-size:16px;line-height:1.95;color:var(--w-d);}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
html.no-js .reveal{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}


/* ---------- header ---------- */
.hd{position:sticky;top:0;z-index:95;padding:14px 0;background:var(--navy);
  border-bottom:1px solid var(--line);transition:padding .4s,box-shadow .4s;}
.hd.solid{padding:10px 0;box-shadow:0 10px 30px -18px rgba(0,0,0,.9);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:clamp(10px,2vw,26px);}
/* 左上：ロゴ＋フル店名。折り返して全文を出す（省略しない） */
.mark{display:flex;align-items:center;gap:10px;min-width:0;flex:1 1 auto;max-width:min(58%,620px);}
.mark img{width:clamp(38px,4.4vw,56px);height:auto;flex-shrink:0;}
.mark b{display:block;font-family:var(--disp);font-weight:500;line-height:1.3;
  font-size:clamp(10.5px,1.15vw,15px);letter-spacing:.005em;
  white-space:normal;overflow-wrap:anywhere;word-break:normal;}
@media(max-width:900px){.mark{max-width:none;}}
@media(max-width:520px){.mark img{width:34px;} .mark b{font-size:10px;line-height:1.28;}}
.hd-r{display:flex;align-items:center;gap:clamp(8px,1.4vw,22px);flex-shrink:0;}

/* 言語：ボタン＋選択シート */
.langbtn{display:flex;align-items:center;gap:7px;background:transparent;border:1px solid var(--line);
  cursor:pointer;color:var(--w);font-family:var(--body);font-weight:500;font-size:13.5px;letter-spacing:.04em;padding:10px 14px;transition:color .3s,border-color .3s;}
.langbtn:hover{color:var(--w);border-color:rgba(242,240,236,.35);}
.langbtn svg{width:15px;height:15px;flex-shrink:0;color:var(--gold);}
@media(max-width:560px){.langbtn span{display:none;} .langbtn{padding:10px 12px;}}
.sheet{position:fixed;inset:0;z-index:96;display:none;place-items:center;padding:20px;background:rgba(10,15,26,.72);backdrop-filter:blur(4px);}
.sheet.open{display:grid;}
.sheet-in{background:var(--navy-2);border:1px solid var(--line);width:100%;max-width:400px;padding:26px;
  animation:sheetUp .34s cubic-bezier(.16,1,.3,1) both;}
@keyframes sheetUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
@media(prefers-reduced-motion:reduce){.sheet-in{animation:none;}}
.sheet-in h4{font-family:var(--disp);font-weight:500;font-size:20px;}
.sheet-in p{font-size:13.5px;line-height:1.75;color:var(--w-d);margin:5px 0 18px;}
.sheet-list{display:grid;gap:2px;}
.sheet-list button{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;
  background:none;border:none;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--w);text-align:left;padding:13px 14px;transition:background .25s;}
.sheet-list button:hover{background:rgba(242,240,236,.06);}
.sheet-list button[aria-current="true"]{background:rgba(200,168,106,.14);color:var(--gold);}
.sheet-list .code{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.1em;color:var(--w-d);}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(242,240,236,.55);background:transparent;
  color:var(--w);cursor:pointer;font-family:var(--body);font-weight:500;font-size:13px;letter-spacing:.06em;
  padding:10px 20px;transition:background .3s,color .3s,border-color .3s;}
.pill svg{width:15px;height:15px;}
.pill:hover{background:var(--w);color:var(--navy);border-color:var(--w);}
@media(max-width:700px){.pill span{display:none;} .pill{padding:10px 12px;}}

.burger{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;padding:2px 0;width:44px;}
.burger .bl{width:30px;height:1.5px;background:var(--w);transition:transform .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.burger .btx{font-family:var(--body);font-size:9px;letter-spacing:.16em;color:var(--w);line-height:1;margin-top:1px;}
.nav-open .burger .bl:nth-child(1){transform:translateY(4px) rotate(45deg);}
.nav-open .burger .bl:nth-child(2){transform:translateY(-2.5px) rotate(-45deg);}

/* ---------- full-screen overlay menu ---------- */
.ovl{position:fixed;inset:0;z-index:90;background:rgba(10,15,26,.96);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s;}
.ovl.open{opacity:1;visibility:visible;}
.ovl-in{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);}
.ovl a{display:block;width:max-content;font-family:var(--disp);font-weight:400;letter-spacing:-.005em;
  font-size:clamp(28px,5.4vw,60px);line-height:1.5;color:var(--w);
  opacity:0;transform:translateY(16px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1),color .3s;}
.ovl.open a{opacity:1;transform:none;}
.ovl.open a:nth-child(1){transition-delay:.10s;}
.ovl.open a:nth-child(2){transition-delay:.16s;}
.ovl.open a:nth-child(3){transition-delay:.22s;}
.ovl.open a:nth-child(4){transition-delay:.28s;}
.ovl.open a:nth-child(5){transition-delay:.34s;}
.ovl.open a:nth-child(6){transition-delay:.40s;}
.ovl a:hover{color:var(--shu-l);}
.ovl-foot{position:absolute;left:0;right:0;bottom:clamp(24px,5vw,52px);}
.ovl-logo{width:clamp(96px,12vw,150px);height:auto;margin-bottom:14px;opacity:.9;}
.ovl-foot p{font-size:12.5px;line-height:1.9;color:var(--w-f);}

/* ---------- circle chevron button ---------- */
.cbtn{display:inline-flex;align-items:center;gap:clamp(14px,2vw,24px);background:none;border:none;cursor:pointer;
  color:var(--w);font-family:var(--body);padding:0;}
.cbtn .circ{position:relative;flex-shrink:0;width:clamp(52px,6vw,72px);height:clamp(52px,6vw,72px);border-radius:50%;
  border:1px solid rgba(242,240,236,.45);display:grid;place-items:center;overflow:hidden;transition:border-color .4s;}
.cbtn .circ::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--shu);
  transform:scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.cbtn .circ svg{position:relative;z-index:1;width:20px;height:20px;transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cbtn:hover .circ{border-color:var(--shu);}
.cbtn:hover .circ::before{transform:scale(1);}
.cbtn:hover .circ svg{transform:translateX(3px);}
.cbtn .lbl{font-size:15px;font-weight:500;letter-spacing:.1em;}
.cbtn.sm .circ{width:46px;height:46px;} .cbtn.sm .circ svg{width:17px;height:17px;} .cbtn.sm .lbl{font-size:13px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;}

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;}
@media(min-width:900px){.hero-media{max-height:calc(92vh - 72px);}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-media::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(10,15,26,0) 0%,rgba(10,15,26,0) 60%,rgba(17,26,43,.55) 90%,var(--navy) 100%);}

/* 参考サイトのコンセプト面：見出し左・写真右 */
.lead-sec{position:relative;padding-top:clamp(30px,5vw,70px);}
.lead-grid{display:grid;gap:clamp(26px,4vw,50px);align-items:start;}
@media(min-width:1000px){.lead-grid{grid-template-columns:1fr 1fr;gap:clamp(40px,5vw,80px);}}
.lead-h{font-family:var(--disp);font-weight:400;line-height:1.24;font-size:clamp(30px,5.4vw,60px);letter-spacing:-.012em;}
.lead-h em{font-style:normal;display:block;}
.lead-shot{position:relative;}
.lead-shot img{width:100%;aspect-ratio:16/11;object-fit:cover;}
@media(min-width:1000px){.lead-shot{margin-right:calc(var(--gut) * -1);}}
.hero-name{margin-top:clamp(26px,4vw,44px);padding-top:20px;border-top:1px solid var(--line);
  font-family:var(--disp);font-weight:500;font-size:clamp(16px,2.2vw,23px);line-height:1.5;color:var(--gold);}
.hero-meta{margin-top:12px;display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--body);font-weight:500;font-size:11.5px;
  letter-spacing:.14em;text-transform:uppercase;color:var(--w-d);}
.hero-meta b{color:var(--gold);font-weight:600;}

/* ---------- interior band（内観） ---------- */
.band-photo{position:relative;width:100%;}
.band-photo img{width:100%;aspect-ratio:21/9;object-fit:cover;}
@media(max-width:760px){.band-photo img{aspect-ratio:4/3;}}
.band-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,15,26,.15) 0%,rgba(10,15,26,.55) 62%,rgba(10,15,26,.8) 100%);}
.band-txt{position:absolute;right:0;top:50%;transform:translateY(-50%);z-index:2;width:100%;}
.band-txt .in{max-width:520px;margin-left:auto;}
@media(max-width:760px){.band-photo::after{background:linear-gradient(180deg,rgba(10,15,26,.2) 0%,rgba(10,15,26,.75) 100%);}}
.band-over{margin-top:clamp(-40px,-4vw,-20px);position:relative;z-index:3;}
/* 写真をずらして重ねるコラージュ */
.collage{display:grid;gap:clamp(20px,3vw,40px);align-items:center;}
@media(min-width:1000px){.collage{grid-template-columns:.9fr 1.1fr;}}
.collage-imgs{position:relative;padding-bottom:clamp(30px,4vw,52px);}
.collage-imgs .a{width:76%;aspect-ratio:4/3;object-fit:cover;}
.collage-imgs .b{position:absolute;right:0;bottom:0;width:42%;aspect-ratio:4/3;object-fit:cover;
  border:5px solid var(--navy);box-shadow:0 18px 44px -22px rgba(0,0,0,.9);}
@media(max-width:760px){
  .collage-imgs{padding-bottom:0;}
  .collage-imgs .a{width:100%;aspect-ratio:16/10;}
  .collage-imgs .b{position:static;width:62%;margin:10px 0 0 auto;border:none;box-shadow:none;}
}


/* ---------- 内観スライドショー ---------- */
.slider{position:relative;width:100%;overflow:hidden;background:var(--navy-3);}
.slides{position:relative;width:100%;aspect-ratio:16/9;}
.slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;
  transition:opacity 1.1s cubic-bezier(.4,0,.2,1);}
.slides img.on{opacity:1;}
.s-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:46px;height:46px;border-radius:50%;
  border:1px solid rgba(242,240,236,.4);background:rgba(10,15,26,.4);backdrop-filter:blur(6px);
  color:var(--w);display:grid;place-items:center;cursor:pointer;transition:background .3s,border-color .3s;}
.s-nav svg{width:18px;height:18px;}
.s-nav:hover{background:var(--shu);border-color:var(--shu);}
.s-nav.prev{left:14px;} .s-nav.next{right:14px;}
@media(max-width:600px){.s-nav{width:38px;height:38px;} .s-nav.prev{left:8px;} .s-nav.next{right:8px;}}
.s-dots{position:absolute;left:0;right:0;bottom:14px;z-index:3;display:flex;justify-content:center;gap:8px;}
.s-dots button{width:28px;height:2px;border:none;padding:0;cursor:pointer;background:rgba(242,240,236,.35);transition:background .3s,width .3s;}
.s-dots button.on{background:var(--gold);width:44px;}

/* ---------- パフォーマンス ---------- */
.reels{display:grid;gap:clamp(16px,2.6vw,30px);margin-top:clamp(28px,4vw,46px);}
@media(min-width:700px){.reels{grid-template-columns:repeat(2,1fr);max-width:840px;}}
.reel{position:relative;overflow:hidden;background:#000;border:1px solid var(--line);}
.reel video{width:100%;aspect-ratio:9/16;object-fit:cover;display:block;}
.reel::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(10,15,26,.28) 0%,rgba(10,15,26,0) 22%,rgba(10,15,26,0) 74%,rgba(10,15,26,.6) 100%);}
.reel-cap{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:18px 20px;}
.reel-cap b{display:block;font-family:var(--disp);font-weight:500;font-size:clamp(15px,1.9vw,19px);line-height:1.35;color:#fff;}
.reel-cap span{display:block;margin-top:5px;font-family:var(--body);font-weight:500;font-size:11px;
  letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.72);}

/* ---------- Google レビュー ---------- */
.gcard{max-width:520px;margin:clamp(28px,4.5vw,48px) auto 0;background:rgba(242,240,236,.04);
  border:1px solid rgba(242,240,236,.16);border-radius:12px;padding:clamp(26px,4vw,38px) clamp(22px,3.4vw,34px);text-align:center;}
.gword{font-family:var(--body);font-weight:500;font-size:clamp(22px,3vw,28px);letter-spacing:-.01em;line-height:1;}
.gword i{font-style:normal;}
.g1{color:#4285F4}.g2{color:#EA4335}.g3{color:#FBBC05}.g4{color:#4285F4}.g5{color:#34A853}.g6{color:#EA4335}
.g-sub{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-d);margin-top:8px;}
.g-row{display:flex;align-items:center;justify-content:center;gap:clamp(14px,2.4vw,22px);margin-top:20px;}
.g-num{font-family:var(--disp);font-weight:500;font-size:clamp(50px,8vw,74px);line-height:.88;letter-spacing:-.03em;}
.g-right{text-align:left;}
.g-stars{display:flex;gap:3px;}
.g-stars svg{width:20px;height:20px;fill:#FBBC05;}
.g-out{font-family:var(--body);font-size:12.5px;color:var(--w-d);margin-top:5px;letter-spacing:.04em;}
.g-count{margin-top:16px;padding-top:16px;border-top:1px solid rgba(242,240,236,.14);
  font-family:var(--disp);font-size:clamp(17px,2.2vw,22px);}
.g-count small{display:block;font-family:var(--body);font-weight:500;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--w-d);margin-top:5px;}
.g-link{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-family:var(--body);font-weight:500;font-size:13px;
  letter-spacing:.08em;color:var(--gold);border-bottom:1px solid rgba(200,168,106,.4);padding-bottom:2px;}

/* ---------- menu ---------- */
.cg{border-top:1px solid var(--line);padding-top:clamp(30px,4.5vw,54px);margin-top:clamp(30px,4.5vw,54px);}
.cg:first-of-type{border-top:none;margin-top:0;padding-top:0;}
.cg-head{display:grid;gap:22px;align-items:end;}
@media(min-width:900px){.cg-head{grid-template-columns:1fr 1fr;gap:48px;}}
.cg-photo{aspect-ratio:16/10;overflow:hidden;background:var(--navy-2);}
.cg-photo img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s cubic-bezier(.16,1,.3,1);}
.cg:hover .cg-photo img{transform:scale(1.035);}
.cg-name{font-family:var(--disp);font-weight:500;font-size:clamp(21px,2.9vw,32px);line-height:1.26;letter-spacing:-.006em;margin-top:10px;}
.cg-lead{margin-top:10px;font-size:15px;line-height:1.9;color:var(--w-d);}
.item{border-top:1px solid var(--line);}
.item:last-child{border-bottom:1px solid var(--line);}
.item-btn{width:100%;background:none;border:none;cursor:pointer;color:inherit;text-align:left;display:flex;align-items:center;gap:14px;padding:19px 0;font-family:inherit;}
.item-btn:hover .item-name{color:var(--gold);}
.item-name{flex:1;font-family:var(--disp);font-weight:500;font-size:18px;line-height:1.4;transition:color .3s;}
.item-tag{font-family:var(--body);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:var(--shu);padding:4px 9px;flex-shrink:0;white-space:nowrap;}
.item-price{font-family:var(--disp);font-size:15.5px;color:var(--gold);flex-shrink:0;}
.item-x{width:11px;height:11px;flex-shrink:0;position:relative;}
.item-x::before,.item-x::after{content:'';position:absolute;background:var(--gold);transition:transform .35s;}
.item-x::before{left:0;top:5px;width:11px;height:1px;}
.item-x::after{left:5px;top:0;width:1px;height:11px;}
.item.open .item-x::after{transform:scaleY(0);}
.item-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.16,1,.3,1);}
.item.open .item-body{max-height:900px;}
.item-inner{padding:0 0 26px;}
.flow{counter-reset:f;}
.flow-row{display:grid;grid-template-columns:26px 1fr;gap:12px;align-items:baseline;padding:9px 0;border-top:1px dotted rgba(242,240,236,.11);}
.flow-row:first-child{border-top:none;}
.fl-n{counter-increment:f;font-family:var(--disp);font-size:10px;color:var(--gold);}
.fl-n::before{content:counter(f,decimal-leading-zero);}
.fl-t{font-size:14.5px;line-height:1.8;color:var(--w-d);}
.item-note{margin-top:15px;font-size:13px;color:var(--w-f);}

/* ---------- badges / voices ---------- */
.badges{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px;}
.badge{border:1px solid rgba(214,184,120,.55);color:var(--gold);font-family:var(--body);font-weight:500;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;padding:9px 16px;}
.rev-grid{display:grid;gap:14px;margin-top:32px;}
@media(min-width:820px){.rev-grid{grid-template-columns:repeat(2,1fr);}}
.rev{border:1px solid var(--line);padding:24px 22px;background:rgba(242,240,236,.02);}
.stars{color:var(--gold);font-size:13px;letter-spacing:2px;}
.rev-src{font-family:var(--body);font-weight:500;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--w-f);margin-left:9px;}
.rev p{font-family:var(--disp);font-size:16px;line-height:1.8;margin:13px 0 14px;}
.rev cite{font-style:normal;font-family:var(--body);font-size:12.5px;color:var(--w-f);}

/* ---------- story / access ---------- */
.split{display:grid;gap:clamp(28px,5vw,66px);align-items:center;}
@media(min-width:900px){.split{grid-template-columns:1.05fr .95fr;} .split.rev-o>*:first-child{order:2;}}
.frame img{width:100%;aspect-ratio:4/5;object-fit:cover;}
.quote{font-family:var(--disp);font-size:clamp(18px,2.5vw,25px);line-height:1.65;border-left:2px solid var(--shu);padding-left:24px;margin:28px 0 10px;}
.by{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);padding-left:26px;}
.blocks{display:grid;gap:30px;margin-top:38px;}
@media(min-width:820px){.blocks{grid-template-columns:repeat(3,1fr);gap:42px;}}
.blocks h4{font-family:var(--body);font-weight:600;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
.info{display:grid;gap:clamp(28px,5vw,56px);}
@media(min-width:900px){.info{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--line);}
@media(max-width:520px){.dl div{grid-template-columns:1fr;gap:5px;}}
.dl dt{font-family:var(--body);font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--w-f);padding-top:4px;}
.dl dd{font-size:15px;line-height:1.8;}
.dl dd a{color:var(--gold);border-bottom:1px solid rgba(200,168,106,.35);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--line);}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- footer（参考サイト構成：左ブランド／右ナビ） ---------- */
footer{background:var(--navy-3);padding:clamp(56px,8vw,110px) 0 clamp(30px,4vw,52px);}
.ft-grid{display:grid;gap:clamp(34px,5vw,60px);}
@media(min-width:820px){.ft-grid{grid-template-columns:1.4fr 1fr;}}
.ft-small{font-family:var(--body);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-f);}
.ft-logo{width:clamp(120px,16vw,190px);height:auto;margin-bottom:20px;}
.ft-name{font-family:var(--disp);font-weight:500;font-size:clamp(23px,3.4vw,38px);line-height:1.24;letter-spacing:-.008em;margin-top:4px;}
.ft-addr{margin-top:22px;font-size:14px;line-height:1.95;color:var(--w-d);}
.ft-addr a{color:var(--gold);}
.ft-nav{display:grid;gap:2px;}
@media(min-width:820px){.ft-nav{justify-items:start;margin-left:auto;}}
.ft-nav a{font-family:var(--disp);font-weight:500;font-size:clamp(16px,1.9vw,20px);letter-spacing:.04em;padding:9px 0;color:var(--w);transition:color .3s;}
.ft-nav a:hover{color:var(--w);}
.ft-bar{margin-top:clamp(38px,5vw,66px);padding-top:22px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-family:var(--body);font-size:12px;letter-spacing:.1em;color:var(--w-f);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header class="hd" id="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top"><img src="/images/logo-gtj-light.png" alt="Gastronomic Tour of JAPAN"/><b>{{ store.name_full_en }}</b></a>
    <div class="hd-r">
      <button class="langbtn" id="langOpen" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.5 2.6 2.5 15 0 17.2M12 3.4c-2.5 2.6-2.5 15 0 17.2"/></svg>
        <span id="langNow">English</span>
      </button>
      <button class="pill" onclick="openReserve('header')" data-ga-event="reserve_click" data-ga-location="header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v3M16 3v3M3.5 9h17M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5z" stroke-linecap="round"/></svg>
        <span data-i18n="nav.reserve">Reserve</span>
      </button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span class="bl"></span><span class="bl"></span><span class="btx" id="btx">MENU</span>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="langSheet" role="dialog" aria-modal="true" aria-label="Language">
  <div class="sheet-in">
    <h4 data-i18n="lang.h">Language</h4>
    <p data-i18n="lang.p">The menu and information are the same in every language.</p>
    <div class="sheet-list" id="langList"></div>
  </div>
</div>

<div class="ovl" id="ovl">
  <div class="ovl-in wrap">
    <nav>
      <a href="#concept" data-nav data-i18n="nav.experience">The Experience</a>
      <a href="#interior" data-nav data-i18n="nav.interior">Interior</a>
      <a href="#performance" data-nav data-i18n="nav.performance">Performance</a>
      <a href="#menu" data-nav data-i18n="nav.menu">Menu</a>
      <a href="#story" data-nav data-i18n="nav.story">Our Story</a>
      <a href="#halal" data-nav data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#access" data-nav data-i18n="nav.access">Access</a>
    </nav>
  </div>
  <div class="ovl-foot wrap">
    <img class="ovl-logo" src="/images/logo-gtj-light.png" alt=""/>
    <p>{{ store.name_full_en }}<br/>{{ store.address_en_line1 }}{% if store.tel_display != 'TBD' %} &middot; <a href="tel:{{ store.tel_raw }}" style="color:var(--gold);">{{ store.tel_display }}</a>{% endif %}</p>
  </div>
</div>

<!-- ================= HERO ================= -->
<section id="top">
  <div class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" poster="{{ IMG.poster }}"><source src="{{ IMG.hero }}" type="video/mp4"/></video>
  </div>

  <div class="wrap lead-sec">
    <div class="lead-grid">
      <div>
        <p class="eyebrow" data-i18n="hero.tour">Gastronomic Tour of Japan</p>
        <h1 class="lead-h" style="margin-top:10px;">
          <span data-i18n="theme.{{ store.theme }}">{{ store.theme | capitalize }}</span><em data-i18n="hero.halal">Halal Omakase Experience</em>
        </h1>
        <p class="p" style="margin-top:clamp(18px,3vw,30px);max-width:520px;" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
        <p class="hero-name">{{ store.name_full_en }}</p>
        <div class="hero-meta">
          <span><b>&#9733; {{ store.rating }}</b> Google &middot; {{ store.rating_count }}</span>
          <span>{{ store.hours }}</span>
          <span>{{ store.station_en }}</span>
        </div>
        <div style="margin-top:clamp(26px,4vw,46px);">
          <a class="cbtn" href="#concept">{{ circ() }}<span class="lbl" data-i18n="nav.experience">The Experience</span></a>
        </div>
      </div>
      <div class="lead-shot"><img src="{{ IMG.lead }}" alt="" loading="lazy"/></div>
    </div>
  </div>
</section>

<!-- ================= CONCEPT ================= -->
<section class="pad" id="concept">
  <div class="wrap">
    <div class="reveal" style="max-width:680px;margin-bottom:clamp(26px,4vw,44px);">
      <span class="eyebrow" data-i18n="exp.label">The Experience</span>
      {% if store.projection_mapping %}
      <h2 class="h-en" style="margin-top:14px;" data-i18n="exp.pm.h">Sushi &amp; Wagyu Course &times; Projection Mapping</h2>
      <p class="p" style="margin-top:22px;" data-i18n="exp.pm.p">Not just a meal — a journey through Japan.</p>
      {% else %}
      <h2 class="h-en" style="margin-top:14px;" data-i18n="exp.h">A Journey Through Japan</h2>
      <p class="p" style="margin-top:22px;" data-i18n="exp.p">A journey through Japan's food culture — wagyu, sushi, and projection-mapped dining.</p>
      {% endif %}
    </div>
      <div class="slider" data-slider>
        <div class="slides">
          <img src="/images/interior-01.jpg" alt="" class="on"/>
          <img src="/images/interior-02.jpg" alt="" loading="lazy"/>
          <img src="/images/interior-03.jpg" alt="" loading="lazy"/>
          <img src="/images/interior-04.jpg" alt="" loading="lazy"/>
        </div>
        <button class="s-nav prev" data-slide-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button class="s-nav next" data-slide-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <div class="s-dots" data-slide-dots></div>
      </div>
    <div style="margin-top:26px;"><a class="cbtn sm" href="#menu">{{ circ() }}<span class="lbl" data-i18n="nav.menu">Menu</span></a></div>
  </div>
</section>

<!-- ================= PERFORMANCE ================= -->
<section class="pad" id="performance" style="background:var(--navy-2);">
  <div class="wrap">
    <div class="reveal" style="max-width:660px;">
      <span class="eyebrow" data-i18n="menu.chefs">Chef&rsquo;s Omakase</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="nav.performance">Performance</h2>
      <p class="p" style="margin-top:20px;" data-i18n="exp.pm.p">Not just a meal — a journey through Japan.</p>
    </div>
    <div class="reels reveal">
      <div class="reel">
        <video autoplay muted loop playsinline preload="none" poster="/images/perf-01-poster.jpg"><source src="/images/perf-01.mp4" type="video/mp4"/></video>
        <div class="reel-cap"><b>{{ store.region_label }}</b><span data-i18n="nav.performance">Performance</span></div>
      </div>
      <div class="reel">
        <video autoplay muted loop playsinline preload="none" poster="/images/perf-02-poster.jpg"><source src="/images/perf-02.mp4" type="video/mp4"/></video>
        <div class="reel-cap"><b>{{ store.region_label }}</b><span data-i18n="nav.performance">Performance</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= MENU ================= -->
<section class="pad" id="menu" style="background:var(--navy-2);">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:clamp(40px,6vw,74px);max-width:660px;">
      <span class="eyebrow" data-i18n="menu.chefs">Chef&rsquo;s Omakase</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="menu.{{ store.theme }}H">Omakase Course</h2>
      <p class="p" style="margin-top:20px;" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
      <p class="p" style="margin-top:10px;font-size:12.5px;font-style:italic;" data-i18n="menu.follows">Our omakase follows the season — ingredients may vary.</p>
    </div>

    {% for ck in TCATS %}{% for cat in courses.cats %}{% if cat.key == ck %}
    <div class="cg reveal">
      <div class="cg-head">
        <div class="cg-photo"><img src="{{ cat.img }}" alt="{{ cat.label.en }}" loading="lazy"/></div>
        <div>
          <span class="eyebrow">0{{ loop.index }} / 0{{ TCATS | length }}</span>
          {% if cat.tag %}<span class="item-tag" style="margin-left:10px;" data-i18n="tag.popular">Most Popular</span>{% endif %}
          <h3 class="cg-name" data-i18n="cat.{{ cat.key }}.label">{{ cat.label.en }}</h3>
          <p class="cg-lead" data-i18n="cat.{{ cat.key }}.lead">{{ cat.lead.en }}</p>
          <p class="cg-lead" style="font-size:12.5px;color:var(--gold);" data-i18n="cat.{{ cat.key }}.note">{{ cat.note.en }}</p>
        </div>
      </div>
      <div style="margin-top:clamp(20px,3vw,36px);">
      {% for c in courses.list %}{% if c.cat == cat.key %}
        <div class="item">
          <button class="item-btn" type="button" data-item="{{ c.id }}" aria-expanded="false" aria-controls="body-{{ c.id }}">
            <span class="item-name" data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</span>
            {% if c.web_only %}<span class="item-tag" data-i18n="tag.web">Web exclusive</span>{% endif %}
            {% if c.lunch_only %}<span class="item-tag" data-i18n="tag.lunch">Lunch only</span>{% endif %}
            {% if showPrice %}{% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}<span class="item-price">&yen;{{ yen(p) }}</span>{% endif %}
            <span class="item-x" aria-hidden="true"></span>
          </button>
          <div class="item-body" id="body-{{ c.id }}">
            <div class="item-inner">
              <p class="p" style="font-size:13.5px;margin-bottom:16px;" data-i18n="course.{{ c.id }}.lead">{{ c.lead.en }}</p>
              <div class="flow">{% for r in c.rows %}<div class="flow-row"><span class="fl-n"></span><span class="fl-t">{{ r }}</span></div>{% endfor %}</div>
{% if showPrice %}{% set p2 = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}
              <p class="item-note">&yen;{{ yen((p2 * 1.1) | round(0,"floor") | int) }} <span data-i18n="course.incl">incl. tax</span></p>{% endif %}
              <div style="margin-top:16px;"><button class="cbtn sm" type="button" onclick="openReserve('menu_{{ c.id }}','{{ c.id }}')" data-ga-event="reserve_click" data-ga-location="menu_{{ c.id }}">{{ circ() }}<span class="lbl" data-i18n="course.reserve">Reserve this course</span></button></div>
            </div>
          </div>
        </div>
      {% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}{% endfor %}{% endfor %}
    <p class="p reveal" style="margin-top:36px;font-size:12px;" data-i18n="menu.season">* Ingredients may vary depending on the season.</p>
  </div>
</section>

<!-- ================= OUR STORY ================= -->
<section class="pad" id="story">
  <div class="wrap split rev-o">
    <div class="reveal">
      <span class="eyebrow" data-i18n="story.label">Our Story</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="story.h">The Story Begins in 1962</h2>
      <p class="p" style="margin-top:22px;" data-i18n="story.p1">The first generation started this journey as a Wagyu merchant.</p>
      <blockquote class="quote" data-i18n="story.quote">Wagyu was never a &lsquo;special occasion treat&rsquo; for me.</blockquote>
      <p class="by" data-i18n="story.by">— 5th Generation Owner</p>
    </div>
    <div class="frame reveal"><img src="{{ IMG.story }}" alt="" loading="lazy"/></div>
  </div>
  <div class="wrap blocks reveal">
    <div><h4 data-i18n="story.t.label">The Turning Point</h4>
      <p class="p" style="font-size:13.5px;" data-i18n="story.t.p1">However, in my 30s, when I visited America, that feeling was greatly shaken.</p>
      <p class="p" style="font-size:13.5px;margin-top:14px;" data-i18n="story.t.p2">Seeing that scene brought me both surprise and frustration.</p></div>
    <div><h4 data-i18n="story.q.label">Our Commitment to Quality</h4>
      <p class="p" style="font-size:13.5px;" data-i18n="story.q.p">I visit livestock farms all over Japan.</p></div>
    <div><h4 data-i18n="story.w.label">For Everyone in the World</h4>
      <p class="p" style="font-size:13.5px;" data-i18n="story.w.p">I personally select Wagyu processed at trusted suppliers in Japan.</p></div>
  </div>
</section>

<!-- ================= MUSLIM-FRIENDLY ================= -->
<section class="pad" id="halal" style="background:var(--navy-2);">
  <div class="wrap split">
    <div class="frame reveal"><img src="{{ IMG.halal }}" alt="" loading="lazy" style="aspect-ratio:16/11;"/></div>
    <div class="reveal">
      <span class="eyebrow" data-i18n="halal.label">Muslim-Friendly Dining</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="halal.h">A Muslim-Friendly Dining Experience in {{ store.city.split(',')[0] }}</h2>
      <p class="p" style="margin-top:22px;" data-i18n="halal.p1">Welcome to our restaurant — a warm, inclusive space where guests from all cultures can dine with peace of mind.</p>
      <p class="p" style="margin-top:14px;" data-i18n="halal.p2">Please feel free to share any dietary preferences or restrictions when making your reservation.</p>
      <div class="badges">
        <span class="badge" data-i18n="badge.nopork">No pork</span>
        <span class="badge" data-i18n="badge.noalc">No alcohol in food</span>
        <span class="badge" data-i18n="badge.mf">Muslim-friendly</span>
      </div>
    </div>
  </div>
</section>

<!-- ================= VOICES ================= -->
<section class="pad" id="voices">
  <div class="wrap">
    <div class="reveal" style="max-width:620px;">
      <span class="eyebrow" data-i18n="voices.label">Guest Voices</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="voices.h">From Around the World</h2>
      <p class="p" style="margin-top:18px;" data-i18n="voices.p">A selection of impressions shared by our guests.</p>
    </div>
    <div class="rev-grid reveal">
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span><p>Beautifully presented Wagyu, thoughtfully served. The Muslim-friendly menu meant my family from Dubai could fully enjoy the experience. Truly felt at home.</p><cite>Dubai, UAE</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span><p>The course was theatrical — watching the chef carve the wagyu felt like a performance. The quality of the beef is on another level. Worth every yen.</p><cite>New York, USA</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span><p>真正的日本和牛體驗，完全不同於香港吃到的。低溫慢煮帶出的甘甜讓人難忘。師傅對每一片肉的態度就像對藝術品一樣。</p><cite>Hong Kong</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span><p>As a Muslim food lover, finding an authentic Muslim-friendly omakase in Japan was a dream. The attention to dietary detail and respect for our needs really showed. The wagyu itself was sublime.</p><cite>Kuala Lumpur</cite></div>
    </div>
    <div class="gcard reveal">
      <div class="gword" aria-label="Google"><i class="g1">G</i><i class="g2">o</i><i class="g3">o</i><i class="g4">g</i><i class="g5">l</i><i class="g6">e</i></div>
      <p class="g-sub" data-i18n="ui.googleReviews">Google reviews</p>
      <div class="g-row">
        <span class="g-num">{{ store.rating }}</span>
        <span class="g-right">
          <span class="g-stars"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></span>
          <span class="g-out" data-i18n="ui.outOf5">out of 5</span>
        </span>
      </div>
      <p class="g-count">{{ store.rating_count }}<small data-i18n="ui.reviews">reviews</small></p>
      {% if store.maps_link != 'TBD' %}
      <a class="g-link" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="reviews_click" data-ga-location="voices"><span data-i18n="ui.seeReviews">See reviews on Google</span></a>
      {% endif %}
    </div>
  </div>
</section>

<!-- ================= ACCESS ================= -->
<section class="pad" id="access" style="background:var(--navy-2);">
  <div class="wrap">
    <div class="reveal" style="margin-bottom:clamp(30px,4.5vw,52px);">
      <span class="eyebrow" data-i18n="access.label">Access</span>
      <h2 class="h-en" style="margin-top:14px;" data-i18n="access.h">Find Us</h2>
    </div>
    <div class="info">
      <div class="reveal">
        <dl class="dl">
          <div><dt data-i18n="access.name">Restaurant</dt><dd>{{ store.name_full_en }}</dd></div>
          <div><dt data-i18n="access.addr">Address</dt><dd>&#12306;{{ store.address_postal }}<br/>{{ store.address_en_line1 }}<br/><span style="color:var(--w-f);">{{ store.address_jp_line1 }}</span></dd></div>
          <div><dt data-i18n="access.hours">Hours</dt><dd>{{ store.hours }}</dd></div>
          {% if store.tel_display != 'TBD' %}<div><dt data-i18n="access.tel">Tel</dt><dd><a href="tel:{{ store.tel_raw }}" data-ga-event="tel_click" data-ga-location="access">{{ store.tel_display }}</a></dd></div>{% endif %}
          <div><dt data-i18n="access.stations">Nearest station</dt><dd>{% for s in store.stations %}{{ s.name }} &mdash; {{ s.min }} <span data-i18n="access.min">min</span>{% if not loop.last %}<br/>{% endif %}{% endfor %}</dd></div>
        </dl>
        {% if store.maps_link != 'TBD' %}
        <div style="margin-top:22px;"><a class="cbtn sm" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="directions_click" data-ga-location="access">{{ circ() }}<span class="lbl" data-i18n="access.maps">Open in Google Maps</span></a></div>
        {% endif %}
      </div>
      <div class="reveal"><div class="mapbox"><iframe src="{{ store.maps_embed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe></div></div>
    </div>
  </div>
</section>

<!-- ================= RESERVE ================= -->
<section class="pad" id="reserve">
  <div class="narrow reveal" style="text-align:center;">
    <span class="eyebrow" data-i18n="reserve.label">Reserve</span>
    <h2 class="h-en" style="margin-top:14px;" data-i18n="reserve.h">Begin Your Experience</h2>
    <p class="p" style="margin-top:18px;" data-i18n="reserve.p">Reservations recommended 2 weeks in advance. Walk-ins welcome subject to availability.</p>
    <div style="margin-top:30px;display:flex;justify-content:center;">
      <button class="cbtn" onclick="openReserve('reservation_section')" data-ga-event="reserve_click" data-ga-location="reservation_section">
        {{ circ() }}<span class="lbl" data-i18n="{% if store.reserve_system == 'form' %}reserve.btn{{ store.theme | capitalize }}{% else %}reserve.btnTc{% endif %}">{% if store.reserve_system == 'form' %}Reserve Your Omakase{% else %}Reserve on TableCheck{% endif %}</span>
      </button>
    </div>
    <p class="p" style="margin-top:18px;font-size:11.5px;" data-i18n="{% if store.reserve_system == 'form' %}reserve.noteForm{% else %}reserve.noteTc{% endif %}">{% if store.reserve_system == 'form' %}* Reservation is confirmed after email from {{ stores.brand.brand_name }}.{% else %}* Reservation handled by TableCheck — secure &amp; instant.{% endif %}</p>
    {% if store.tel_display != 'TBD' %}
    <p class="p" style="margin-top:8px;font-size:12px;"><span data-i18n="reserve.tel">Prefer to call?</span> <a href="tel:{{ store.tel_raw }}" style="color:var(--gold);border-bottom:1px solid rgba(200,168,106,.4);" data-ga-event="tel_click" data-ga-location="reservation_section">{{ store.tel_display }}</a></p>
    {% endif %}
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="ft-grid">
      <div>
        <img class="ft-logo" src="/images/logo-gtj-light.png" alt="Gastronomic Tour of JAPAN"/>
        <p class="ft-name">{{ store.name_full_en }}</p>
        <p class="ft-addr">
          &#12306;{{ store.address_postal }}<br/>{{ store.address_en_line1 }}<br/>
          {{ store.hours }}{% if store.tel_display != 'TBD' %}<br/><a href="tel:{{ store.tel_raw }}">{{ store.tel_display }}</a>{% endif %}<br/>
          <span style="opacity:.7;">&copy; {{ stores.brand.brand_name }} all rights reserved.</span>
        </p>
      </div>
      <nav class="ft-nav">
        <a href="#concept" data-i18n="nav.experience">The Experience</a>
        <a href="#interior" data-i18n="nav.interior">Interior</a>
        <a href="#performance" data-i18n="nav.performance">Performance</a>
        <a href="#menu" data-i18n="nav.menu">Menu</a>
        <a href="#story" data-i18n="nav.story">Our Story</a>
        <a href="#halal" data-i18n="nav.halal">Muslim-Friendly</a>
        <a href="#access" data-i18n="nav.access">Access</a>
        <a href="#reserve" data-i18n="nav.reserve">Reserve</a>
      </nav>
    </div>
    <div class="ft-bar">
      <span>{{ store.region_label }}</span>
      <span>{% for l in ui.langs %}{% if not loop.first %} / {% endif %}<a href="#" data-lang-btn="{{ l.code }}">{{ l.short }}</a>{% endfor %}</span>
    </div>
  </div>
</footer>

<script>
document.documentElement.classList.remove('no-js');

window.I18N = {{ ui.dict | dump | safe }};
window.LANGS = {{ ui.langs | dump | safe }};
{% for L in courses.langs %}
{% for cat in courses.cats %}
window.I18N["{{ L }}"]["cat.{{ cat.key }}.label"] = {{ cat.label[L] | dump | safe }};
window.I18N["{{ L }}"]["cat.{{ cat.key }}.lead"]  = {{ cat.lead[L] | dump | safe }};
window.I18N["{{ L }}"]["cat.{{ cat.key }}.note"]  = {{ cat.note[L] | dump | safe }};
{% endfor %}
{% for c in courses.list %}
window.I18N["{{ L }}"]["course.{{ c.id }}.name"] = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.opt"]  = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.lead"] = {{ c.lead[L] | dump | safe }};
{% endfor %}
{% endfor %}

var VARS = { brand: {{ stores.brand.brand_name | dump | safe }}, city: {{ (store.city.split(',')[0]) | dump | safe }}, tel: {{ store.tel_display | dump | safe }} };
function fill(s){ return String(s).replace(/\{brand\}/g,VARS.brand).replace(/\{city\}/g,VARS.city).replace(/\{tel\}/g,VARS.tel); }

window.CURRENT_LANG = 'en';
function applyLang(code){
  var meta = window.LANGS.filter(function(l){ return l.code === code; })[0];
  if(!meta || !window.I18N[code]){ code = 'en'; meta = window.LANGS[0]; }
  window.CURRENT_LANG = code;
  var d = window.I18N[code];
  document.documentElement.setAttribute('lang', meta.html);
  document.documentElement.setAttribute('data-lang', code);
  if(meta.font) loadFont(meta.font, code);
  document.querySelectorAll('[data-i18n]').forEach(function(el){ var v = d[el.getAttribute('data-i18n')]; if(v != null) el.innerHTML = fill(v); });
  document.querySelectorAll('[data-i18n-ph]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-ph')]; if(v != null) el.setAttribute('placeholder', fill(v)); });
  document.querySelectorAll('[data-i18n-og]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-og')]; if(v != null) el.setAttribute('label', fill(v)); });
  document.querySelectorAll('[data-lang-btn]').forEach(function(b){ b.setAttribute('aria-current', String(b.getAttribute('data-lang-btn') === code)); });
  document.getElementById('langNow').textContent = meta.short;
  try{ localStorage.setItem('omakase_lang', code); }catch(e){}
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({event:'lang_switch', lang:code});
}
var FONTS = {};
function loadFont(family, code){
  if(FONTS[family]) return; FONTS[family] = 1;
  var l = document.createElement('link'); l.rel='stylesheet';
  l.href = 'https://fonts.googleapis.com/css2?family=' + family + '&display=swap';
  document.head.appendChild(l);
  var st = document.createElement('style');
  st.textContent = 'html[data-lang="' + code + '"] body{font-family:"' + family.split(':')[0].replace(/\+/g,' ') + '",serif;}';
  document.head.appendChild(st);
}
function initLang(){
  var q = new URLSearchParams(location.search).get('lang');
  var saved = null; try{ saved = localStorage.getItem('omakase_lang'); }catch(e){}
  var n = (navigator.language || 'en').toLowerCase(), auto = 'en';
  if(n.indexOf('ja') === 0) auto = 'ja';
  else if(n.indexOf('ko') === 0) auto = 'ko';
  else if(n.indexOf('id') === 0 || n.indexOf('in') === 0) auto = 'id';
  else if(n.indexOf('zh') === 0) auto = (n.indexOf('tw') > -1 || n.indexOf('hk') > -1 || n.indexOf('hant') > -1) ? 'zht' : 'zhs';
  applyLang(q || saved || auto);
}
/* 言語選択シート */
(function(){
  var list = document.getElementById('langList');
  window.LANGS.forEach(function(l){
    var b = document.createElement('button');
    b.setAttribute('data-lang-btn', l.code);
    b.innerHTML = '<span>' + l.label + '</span><span class="code">' + l.short + '</span>';
    b.addEventListener('click', function(){ applyLang(l.code); closeSheet(); });
    list.appendChild(b);
  });
})();
var sheet = document.getElementById('langSheet');
function closeSheet(){ sheet.classList.remove('open'); document.body.style.overflow = ''; }
document.getElementById('langOpen').addEventListener('click', function(){ sheet.classList.add('open'); document.body.style.overflow = 'hidden'; });
sheet.addEventListener('click', function(e){ if(e.target === sheet) closeSheet(); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeSheet(); });
document.querySelectorAll('[data-lang-btn]:not(.sheet-list button)').forEach(function(b){
  b.addEventListener('click', function(e){ e.preventDefault(); applyLang(b.getAttribute('data-lang-btn')); });
});

/* header + overlay menu */
var hd = document.getElementById('hd');
addEventListener('scroll', function(){ hd.classList.toggle('solid', scrollY > 40); }, {passive:true});
var ovl = document.getElementById('ovl'), burger = document.getElementById('burger'), btx = document.getElementById('btx');
function openMenu(){ ovl.classList.add('open'); document.body.classList.add('nav-open'); document.body.style.overflow='hidden'; burger.setAttribute('aria-expanded','true'); btx.textContent='CLOSE'; }
window.closeMenu = function(){ ovl.classList.remove('open'); document.body.classList.remove('nav-open'); document.body.style.overflow=''; burger.setAttribute('aria-expanded','false'); btx.textContent='MENU'; };
burger.addEventListener('click', function(){ ovl.classList.contains('open') ? closeMenu() : openMenu(); });
document.querySelectorAll('[data-nav]').forEach(function(a){ a.addEventListener('click', closeMenu); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });

/* accordions */
document.querySelectorAll('[data-item]').forEach(function(btn){
  btn.addEventListener('click', function(){
    var item = btn.closest('.item'), open = item.classList.contains('open');
    item.classList.toggle('open', !open);
    btn.setAttribute('aria-expanded', String(!open));
    if(!open){ window.dataLayer = window.dataLayer || []; window.dataLayer.push({event:'course_detail_view', event_label: btn.getAttribute('data-item')}); }
  });
});

/* 内観スライドショー */
document.querySelectorAll('[data-slider]').forEach(function(root){
  var imgs = root.querySelectorAll('.slides img');
  var dots = root.querySelector('[data-slide-dots]');
  var i = 0, timer;
  imgs.forEach(function(_, n){
    var b = document.createElement('button');
    b.setAttribute('aria-label', 'Slide ' + (n + 1));
    if(n === 0) b.className = 'on';
    b.addEventListener('click', function(){ go(n); });
    dots.appendChild(b);
  });
  function go(n){
    i = (n + imgs.length) % imgs.length;
    imgs.forEach(function(im, k){ im.classList.toggle('on', k === i); });
    dots.querySelectorAll('button').forEach(function(d, k){ d.classList.toggle('on', k === i); });
    restart();
  }
  function restart(){ clearInterval(timer); timer = setInterval(function(){ go(i + 1); }, 5000); }
  root.querySelector('[data-slide-prev]').addEventListener('click', function(){ go(i - 1); });
  root.querySelector('[data-slide-next]').addEventListener('click', function(){ go(i + 1); });
  var sx = null;
  root.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, {passive:true});
  root.addEventListener('touchend', function(e){
    if(sx === null) return;
    var dx = e.changedTouches[0].clientX - sx;
    if(Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
    sx = null;
  });
  restart();
});

/* reveal */
(function(){
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {threshold:.12, rootMargin:'0px 0px -7% 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
})();

document.addEventListener('click', function(e){
  var t = e.target.closest('[data-ga-event]'); if(!t) return;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({event:t.getAttribute('data-ga-event'), event_label:t.getAttribute('data-ga-location')||''});
});
document.addEventListener('DOMContentLoaded', initLang);
</script>

{% if store.reserve_system == 'form' %}
  {% include "partials/reserve-v2.njk" %}
{% else %}
  <script>
  window.openReserve = window.openReserveModal = function(label, courseId){
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({event:'reserve_click', event_label: label || '', course_id: courseId || ''});
    window.location.href = '{{ tablecheck_with_utm | safe }}';
  };
  </script>
{% endif %}
</body>
</html>

    </div>
  </div>
</footer>

<script>
document.documentElement.classList.remove('no-js');

window.I18N = {{ ui.dict | dump | safe }};
window.LANGS = {{ ui.langs | dump | safe }};
{% for L in courses.langs %}
{% for cat in courses.cats %}
window.I18N["{{ L }}"]["cat.{{ cat.key }}.label"] = {{ cat.label[L] | dump | safe }};
window.I18N["{{ L }}"]["cat.{{ cat.key }}.lead"]  = {{ cat.lead[L] | dump | safe }};
{% endfor %}
{% for c in courses.list %}
window.I18N["{{ L }}"]["course.{{ c.id }}.name"] = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.opt"]  = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.lead"] = {{ c.lead[L] | dump | safe }};
{% endfor %}
{% endfor %}

var VARS = { brand: {{ stores.brand.brand_name | dump | safe }}, city: {{ (store.city.split(',')[0]) | dump | safe }}, tel: {{ store.tel_display | dump | safe }} };
function fill(s){ return String(s).replace(/\{brand\}/g,VARS.brand).replace(/\{city\}/g,VARS.city).replace(/\{tel\}/g,VARS.tel); }

window.CURRENT_LANG = 'en';
function applyLang(code){
  var meta = window.LANGS.filter(function(l){ return l.code === code; })[0];
  if(!meta || !window.I18N[code]){ code = 'en'; meta = window.LANGS[0]; }
  window.CURRENT_LANG = code;
  var d = window.I18N[code];
  document.documentElement.setAttribute('lang', meta.html);
  document.documentElement.setAttribute('data-lang', code);
  if(meta.font) loadFont(meta.font, code);
  document.querySelectorAll('[data-i18n]').forEach(function(el){ var v = d[el.getAttribute('data-i18n')]; if(v != null) el.innerHTML = fill(v); });
  document.querySelectorAll('[data-i18n-ph]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-ph')]; if(v != null) el.setAttribute('placeholder', fill(v)); });
  document.querySelectorAll('[data-i18n-og]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-og')]; if(v != null) el.setAttribute('label', fill(v)); });
  document.querySelectorAll('[data-lang-btn]').forEach(function(b){ b.setAttribute('aria-current', String(b.getAttribute('data-lang-btn') === code)); });
  document.getElementById('langNow').textContent = meta.short;
  try{ localStorage.setItem('omakase_lang', code); }catch(e){}
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({event:'lang_switch', lang:code});
}
var FONTS = {};
function loadFont(family, code){
  if(FONTS[family]) return; FONTS[family] = 1;
  var l = document.createElement('link'); l.rel='stylesheet';
  l.href = 'https://fonts.googleapis.com/css2?family=' + family + '&display=swap';
  document.head.appendChild(l);
  var st = document.createElement('style');
  st.textContent = 'html[data-lang="' + code + '"] body{font-family:"' + family.split(':')[0].replace(/\+/g,' ') + '",serif;}';
  document.head.appendChild(st);
}
function initLang(){
  var q = new URLSearchParams(location.search).get('lang');
  var saved = null; try{ saved = localStorage.getItem('omakase_lang'); }catch(e){}
  var n = (navigator.language || 'en').toLowerCase(), auto = 'en';
  if(n.indexOf('ja') === 0) auto = 'ja';
  else if(n.indexOf('ko') === 0) auto = 'ko';
  else if(n.indexOf('id') === 0 || n.indexOf('in') === 0) auto = 'id';
  else if(n.indexOf('zh') === 0) auto = (n.indexOf('tw') > -1 || n.indexOf('hk') > -1 || n.indexOf('hant') > -1) ? 'zht' : 'zhs';
  applyLang(q || saved || auto);
}
/* 言語選択シート */
(function(){
  var list = document.getElementById('langList');
  window.LANGS.forEach(function(l){
    var b = document.createElement('button');
    b.setAttribute('data-lang-btn', l.code);
    b.innerHTML = '<span>' + l.label + '</span><span class="code">' + l.short + '</span>';
    b.addEventListener('click', function(){ applyLang(l.code); closeSheet(); });
    list.appendChild(b);
  });
})();
var sheet = document.getElementById('langSheet');
function closeSheet(){ sheet.classList.remove('open'); document.body.style.overflow = ''; }
document.getElementById('langOpen').addEventListener('click', function(){ sheet.classList.add('open'); document.body.style.overflow = 'hidden'; });
sheet.addEventListener('click', function(e){ if(e.target === sheet) closeSheet(); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeSheet(); });
document.querySelectorAll('[data-lang-btn]:not(.sheet-list button)').forEach(function(b){
  b.addEventListener('click', function(e){ e.preventDefault(); applyLang(b.getAttribute('data-lang-btn')); });
});

/* header + overlay menu */
var hd = document.getElementById('hd');
addEventListener('scroll', function(){ hd.classList.toggle('solid', scrollY > 40); }, {passive:true});
var ovl = document.getElementById('ovl'), burger = document.getElementById('burger'), btx = document.getElementById('btx');
function openMenu(){ ovl.classList.add('open'); document.body.classList.add('nav-open'); document.body.style.overflow='hidden'; burger.setAttribute('aria-expanded','true'); btx.textContent='CLOSE'; }
window.closeMenu = function(){ ovl.classList.remove('open'); document.body.classList.remove('nav-open'); document.body.style.overflow=''; burger.setAttribute('aria-expanded','false'); btx.textContent='MENU'; };
burger.addEventListener('click', function(){ ovl.classList.contains('open') ? closeMenu() : openMenu(); });
document.querySelectorAll('[data-nav]').forEach(function(a){ a.addEventListener('click', closeMenu); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });

/* accordions */
document.querySelectorAll('[data-item]').forEach(function(btn){
  btn.addEventListener('click', function(){
    var item = btn.closest('.item'), open = item.classList.contains('open');
    item.classList.toggle('open', !open);
    btn.setAttribute('aria-expanded', String(!open));
    if(!open){ window.dataLayer = window.dataLayer || []; window.dataLayer.push({event:'course_detail_view', event_label: btn.getAttribute('data-item')}); }
  });
});

/* 内観スライドショー */
document.querySelectorAll('[data-slider]').forEach(function(root){
  var imgs = root.querySelectorAll('.slides img');
  var dots = root.querySelector('[data-slide-dots]');
  var i = 0, timer;
  imgs.forEach(function(_, n){
    var b = document.createElement('button');
    b.setAttribute('aria-label', 'Slide ' + (n + 1));
    if(n === 0) b.className = 'on';
    b.addEventListener('click', function(){ go(n); });
    dots.appendChild(b);
  });
  function go(n){
    i = (n + imgs.length) % imgs.length;
    imgs.forEach(function(im, k){ im.classList.toggle('on', k === i); });
    dots.querySelectorAll('button').forEach(function(d, k){ d.classList.toggle('on', k === i); });
    restart();
  }
  function restart(){ clearInterval(timer); timer = setInterval(function(){ go(i + 1); }, 5000); }
  root.querySelector('[data-slide-prev]').addEventListener('click', function(){ go(i - 1); });
  root.querySelector('[data-slide-next]').addEventListener('click', function(){ go(i + 1); });
  var sx = null;
  root.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, {passive:true});
  root.addEventListener('touchend', function(e){
    if(sx === null) return;
    var dx = e.changedTouches[0].clientX - sx;
    if(Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1));
    sx = null;
  });
  restart();
});

/* フローティングCTAの閲覧人数。約7分ごとに決まる値をベースに、滞在中ゆるく揺らす */
(function(){
  function seeded(min,max,bucket){ var h=(bucket*2654435761)%2147483647; var r=(h>>>0)/2147483647; return min+Math.floor(r*(max-min+1)); }
  var v = document.getElementById('viewer-count'); if(!v) return;
  v.textContent = seeded(4,8,Math.floor(Date.now()/(7*60*1000)));
  setInterval(function(){
    var cur = parseInt(v.textContent,10) || 5;
    cur = Math.max(4, Math.min(8, cur + (Math.random() < .5 ? -1 : 1)));
    v.textContent = cur;
  }, 26000);
})();

/* 見出しの下にえんじの罫 */
document.querySelectorAll('[data-mark]').forEach(function(h){
  var s = document.createElement('span'); s.className = 'sec-mark'; h.insertAdjacentElement('afterend', s);
});

/* reveal */
(function(){
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {threshold:.12, rootMargin:'0px 0px -7% 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
})();


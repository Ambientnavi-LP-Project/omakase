/* ---------- menu ---------- */
.cg{border-top:1px solid var(--line);padding-top:clamp(30px,4.5vw,54px);margin-top:clamp(30px,4.5vw,54px);}
.cg:first-of-type{border-top:none;margin-top:0;padding-top:0;}
.cg-head{display:grid;gap:22px;align-items:end;}
.cg-head{max-width:760px;}
.cg:hover .cg-name{font-family:var(--disp);font-weight:500;font-size:clamp(21px,2.9vw,32px);line-height:1.26;letter-spacing:-.006em;margin-top:10px;}
.cg-lead{margin-top:10px;font-size:15px;line-height:1.9;color:var(--w-d);}
/* ---------- コース選択の導入（内観写真を背景に） ---------- */
.msel{position:relative;isolation:isolate;overflow:hidden;text-align:center;
  margin:clamp(30px,4vw,52px) 0 clamp(28px,3.8vw,44px);
  padding:clamp(40px,6vw,80px) clamp(22px,4vw,60px);
  background-image:url("{{ IMG.band }}");background-size:cover;background-position:center;}
.msel::before{content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(180deg,rgba(6,5,4,.62) 0%,rgba(6,5,4,.78) 100%);}
.msel .eyebrow{color:#e0c793;}
.msel .eyebrow::before{background:#9c2c3d;}
.msel-p{max-width:640px;margin:16px auto 0;font-size:16px;line-height:1.95;color:rgba(255,255,255,.9);}
.msel-tap{margin-top:16px;font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.1em;
  text-transform:uppercase;color:rgba(255,255,255,.66);}
.scar{margin-top:22px;padding-top:20px;border-top:1px solid rgba(255,255,255,.22);}
.scar-1{font-family:var(--body);font-weight:600;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:#e0c793;}
.scar-2{margin-top:8px;display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-weight:500;
  font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.72);}
.scar-dot{width:7px;height:7px;border-radius:50%;background:#3fae6a;box-shadow:0 0 0 3px rgba(63,174,106,.22);}
.clist{display:grid;gap:clamp(18px,2.6vw,30px);}
@media(min-width:760px){.clist{grid-template-columns:repeat(2,1fr);}}
.ccard{display:flex;flex-direction:column;border:1px solid var(--line);background:rgba(201,169,110,.04);}
.sec-light .ccard{background:rgba(23,19,16,.03);}
.ccard-photo{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--navy-3);}
.ccard-photo img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s cubic-bezier(.16,1,.3,1);}
.ccard:hover .ccard-photo img{transform:scale(1.04);}
.ccard-tag{position:absolute;left:0;top:0;z-index:2;background:var(--shu);color:#fff;font-family:var(--body);
  font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:7px 13px;}
.ccard-in{padding:clamp(20px,2.4vw,28px);display:flex;flex-direction:column;flex:1;}
.ccard-cat{font-family:var(--body);font-weight:600;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);}
.ccard-name{font-family:var(--disp);font-weight:500;font-size:clamp(19px,2.2vw,25px);line-height:1.3;margin-top:9px;}
.ccard-price{margin-top:12px;font-family:var(--disp);font-weight:500;font-size:clamp(22px,2.4vw,28px);color:var(--gold);line-height:1;}
.ccard-price small{font-family:var(--body);font-size:12px;font-weight:400;color:var(--w-f);margin-left:8px;}
.ccard-lead{margin-top:12px;font-size:14.5px;line-height:1.9;color:var(--w-d);flex:1;}
.ccard-go{margin-top:18px;display:inline-flex;align-items:center;gap:12px;align-self:flex-start;
  background:none;border:none;cursor:pointer;color:var(--gold);font-family:var(--body);font-weight:600;
  font-size:12.5px;letter-spacing:.18em;text-transform:uppercase;padding:0;}
.ccard-go .arw{position:relative;display:block;width:40px;height:1px;background:rgba(201,169,110,.45);overflow:hidden;}
.ccard-go .arw::after{content:'';position:absolute;inset:0;background:var(--gold);transform:translateX(-101%);
  transition:transform .55s cubic-bezier(.16,1,.3,1);}
.ccard-go:hover .arw::after{transform:none;}

/* ---------- badges / voices ---------- */
.rev-grid{display:grid;gap:14px;margin-top:32px;}
@media(min-width:820px){.rev-grid{grid-template-columns:repeat(2,1fr);}}
.rev{border:1px solid var(--line);padding:24px 22px;background:rgba(242,240,236,.02);}
.stars{color:var(--gold);font-size:13px;letter-spacing:2px;}
.rev-src{font-family:var(--body);font-weight:500;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--w-f);margin-left:9px;}
.rev p{font-family:var(--disp);font-size:16px;line-height:1.8;margin:13px 0 14px;}
.rev cite{font-style:normal;font-family:var(--body);font-size:12.5px;color:var(--w-f);}

/* ---------- story / access ---------- */
.split{display:grid;gap:clamp(28px,5vw,66px);align-items:center;}
@media(min-width:900px){.split{grid-template-columns:1.05fr .95fr;} .split.rev-o>*:first-child{order:2;}}
.frame img{width:100%;aspect-ratio:4/5;object-fit:cover;}
.quote{font-family:var(--disp);font-size:clamp(18px,2.5vw,25px);line-height:1.65;border-left:2px solid var(--shu);padding-left:24px;margin:28px 0 10px;}
.by{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);padding-left:26px;}
.blocks{display:grid;gap:30px;margin-top:38px;}
@media(min-width:820px){.blocks{grid-template-columns:repeat(3,1fr);gap:42px;}}
.blocks h4{font-family:var(--body);font-weight:600;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
.info{display:grid;gap:clamp(28px,5vw,56px);}
@media(min-width:900px){.info{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--line);}
@media(max-width:520px){.dl div{grid-template-columns:1fr;gap:5px;}}
.dl dt{font-family:var(--body);font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--w-f);padding-top:4px;}
.dl dd{font-size:15px;line-height:1.8;}
.dl dd a{color:var(--gold);border-bottom:1px solid rgba(201,169,110,.4);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--line);}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- footer（参考サイト構成：左ブランド／右ナビ） ---------- */
footer{background:var(--navy-3);padding:clamp(56px,8vw,110px) 0 clamp(30px,4vw,52px);}
.ft-grid{display:grid;gap:clamp(34px,5vw,60px);}
@media(min-width:820px){.ft-grid{grid-template-columns:1.4fr 1fr;}}
.ft-small{font-family:var(--body);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-f);}
.ft-logo{width:clamp(120px,16vw,190px);height:auto;margin-bottom:20px;}
.ft-name{font-family:var(--disp);font-weight:500;font-size:clamp(23px,3.4vw,38px);line-height:1.24;letter-spacing:-.008em;margin-top:4px;}
.ft-addr{margin-top:22px;font-size:14px;line-height:1.95;color:var(--w-d);}
.ft-addr a{color:var(--gold);}
.ft-nav{display:grid;gap:2px;}
@media(min-width:820px){.ft-nav{justify-items:start;margin-left:auto;}}
.ft-nav a{font-family:var(--disp);font-weight:500;font-size:clamp(16px,1.9vw,20px);letter-spacing:.04em;padding:9px 0;color:var(--w);transition:color .3s;}
.ft-nav a:hover{color:var(--w);}
.ft-bar{margin-top:clamp(38px,5vw,66px);padding-top:22px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-family:var(--body);font-size:12px;letter-spacing:.1em;color:var(--w-f);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header class="hd" id="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top" aria-label="{{ store.name_full_en }}"><img src="/images/logo-gtj-light.png" alt="Gastronomic Tour of JAPAN"/></a>
    <div class="hd-r">
      <button class="langbtn" id="langOpen" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.5 2.6 2.5 15 0 17.2M12 3.4c-2.5 2.6-2.5 15 0 17.2"/></svg>
        <span id="langNow">English</span>
      </button>
      <button class="pill" onclick="openReserve('header')" data-ga-event="reserve_click" data-ga-location="header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v3M16 3v3M3.5 9h17M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5z" stroke-linecap="round"/></svg>
        <span data-i18n="nav.reserve">Reserve</span>
      </button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span class="bl"></span><span class="bl"></span><span class="btx" id="btx">MENU</span>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="langSheet" role="dialog" aria-modal="true" aria-label="Language">
  <div class="sheet-in">
    <h4 data-i18n="lang.h">Language</h4>
    <p data-i18n="lang.p">The menu and information are the same in every language.</p>
    <div class="sheet-list" id="langList"></div>
  </div>
</div>

<div class="ovl" id="ovl">
  <div class="ovl-in wrap">
    <nav>
      <a href="#concept" data-nav data-i18n="nav.experience">The Experience</a>
      {% if SHOW_PERFORMANCE %}<a href="#performance" data-nav data-i18n="nav.performance">Performance</a>{% endif %}
      <a href="#menu" data-nav data-i18n="nav.menu">Menu</a>
      <a href="#halal" data-nav data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#access" data-nav data-i18n="nav.access">Access</a>
    </nav>
  </div>
  <div class="ovl-foot wrap">
    <img class="ovl-logo" src="/images/logo-gtj-light.png" alt=""/>
    <p>{{ store.name_full_en }}<br/>{{ store.address_en_line1 }}{% if store.tel_display != 'TBD' %} &middot; <a href="tel:{{ store.tel_raw }}" style="color:var(--gold);">{{ store.tel_display }}</a>{% endif %}</p>
  </div>
</div>

<!-- ================= HERO ================= -->
<section id="top">
  <div class="hero-stage">
  <div class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" poster="{{ IMG.poster }}"><source src="{{ IMG.hero }}" type="video/mp4"/></video>
  <nav class="hero-nav">
    <div class="wrap">
      <a href="#concept" data-i18n="nav.experience">The Experience</a>
      <a href="#menu" data-i18n="nav.menu">Menu</a>
      {% if SHOW_PERFORMANCE %}<a href="#performance" data-i18n="nav.performance">Performance</a>{% endif %}
      <a href="#voices" data-i18n="voices.label">Guest Voices</a>
      <a href="#halal" data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#access" data-i18n="nav.access">Access</a>
      <a href="#reserve" data-i18n="nav.reserve">Reserve</a>
    </div>
  </nav>
  </div>
  </div>


  <div class="wrap lead-sec">
    <div class="lead-grid">
      <div>
        <p class="eyebrow" data-i18n="hero.tour">Gastronomic Tour of Japan</p>
        <h1 class="lead-h" style="margin-top:10px;">{{ store.name_full_en }}</h1>
        <p class="p" style="margin-top:clamp(18px,3vw,30px);max-width:520px;" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
        <div class="trust">
          <span class="chip"><b>&#9733; {{ store.rating }}</b> Google &middot; {{ store.rating_count }} <span data-i18n="ui.reviews">reviews</span></span>
        </div>
        <div style="margin-top:22px;">
          <button class="cta-lg" onclick="openReserve('hero')" data-ga-event="reserve_click" data-ga-location="hero">
            <strong data-i18n="{% if store.reserve_system == 'form' %}reserve.btn{{ store.theme | capitalize }}{% else %}reserve.btnTc{% endif %}">{% if store.reserve_system == 'form' %}Reserve Your Omakase{% else %}Reserve on TableCheck{% endif %}</strong>
            <span data-i18n="menu.note">All Muslim-friendly &middot; Seasonal menu</span>
          </button>
          <p class="cta-sub" data-i18n="{% if store.reserve_system == 'form' %}reserve.noteForm{% else %}reserve.noteTc{% endif %}">{% if store.reserve_system == 'form' %}* Reservation is confirmed after email from {{ stores.brand.brand_name }}.{% else %}* Reservation handled by TableCheck — secure &amp; instant.{% endif %}</p>
        </div>
        <div class="hero-meta">
          <span>{{ store.hours }}</span>
          <span>{{ store.station_en }}</span>
        </div>
          </div>
      <div class="lead-shot">

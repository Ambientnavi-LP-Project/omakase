.hero-stage{position:relative;}
/* ---------- ヒーロー目次（動画の内側に配置＝はみ出し不可） ---------- */
.hero-stage{position:relative;}
.hero-nav{position:absolute;inset:0;z-index:4;display:flex;align-items:flex-end;
  pointer-events:none;padding-bottom:clamp(14px,min(2.6vh,2.6vw),40px);}
.hero-nav .wrap{pointer-events:auto;}
.hero-nav a{display:block;width:max-content;font-family:var(--disp);font-weight:400;
  text-transform:uppercase;letter-spacing:.045em;color:#fff;
  font-size:clamp(15px,min(2.2vw,2.9vh),32px);line-height:1;
  padding:clamp(4px,min(.9vh,1vw),13px) 0;
  text-shadow:0 2px 22px rgba(0,0,0,.8);
  transition:color .3s,transform .4s cubic-bezier(.16,1,.3,1);}
.hero-nav a:hover{color:var(--gold-l);transform:translateX(8px);}
@media(max-width:899px){ .hero-nav{display:none;} }
/* 左端を落として文字を読ませる */
.hero-media::before{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(90deg,rgba(6,5,4,.68) 0%,rgba(6,5,4,.32) 34%,rgba(6,5,4,0) 60%);}
@media(max-width:899px){.hero-media::before{display:none;}}


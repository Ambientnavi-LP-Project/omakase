---
pagination:
  data: stores.pagesTestA
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% set TCATS = courses.themes[store.theme] or courses.themes.all %}
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
{% macro circ() %}<span class="circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Sushi &amp; Wagyu Halal Omakase Experience — {{ store.name_full_en }}"/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-a',theme:'{{ store.theme }}'});</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@300;400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>

<style>
:root{
  --navy:#111a2b; --navy-2:#162034; --navy-3:#0c1322;
  --w:#f2f0ec; --w-d:rgba(242,240,236,.68); --w-f:rgba(242,240,236,.42);
  --shu:#a8342a; --shu-l:#c4463a; --gold:#c8a86a;
  --line:rgba(242,240,236,.14);
  --disp:'Zilla Slab',serif; --body:'Jost',sans-serif;
  --gut:clamp(22px,5.5vw,80px);
  --rv-bg:var(--navy-2); --rv-panel:var(--navy-3); --rv-line:var(--line);
  --rv-text:var(--w); --rv-muted:var(--w-f); --rv-accent:var(--shu-l);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:4px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--navy);color:var(--w);font-family:var(--body);font-weight:300;line-height:1.85;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
  background-image:repeating-radial-gradient(circle at 16% 34%,rgba(242,240,236,.022) 0 1px,transparent 1px 58px);}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
.wrap{width:100%;max-width:1320px;margin-inline:auto;padding-inline:var(--gut);}
.narrow{width:100%;max-width:820px;margin-inline:auto;padding-inline:var(--gut);}
.pad{padding:clamp(66px,10vw,142px) 0;}

.eyebrow{display:inline-block;font-family:var(--body);font-size:10px;letter-spacing:.36em;text-transform:uppercase;color:var(--gold);}
.h-en{font-family:var(--disp);font-weight:400;line-height:1.3;font-size:clamp(26px,4.2vw,50px);letter-spacing:-.005em;}
.p{font-size:14.5px;line-height:2.15;color:var(--w-d);}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
html.no-js .reveal{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}


/* ---------- header ---------- */
.hd{position:fixed;top:0;left:0;right:0;z-index:95;padding:14px 0;transition:background .4s,padding .4s;}
.hd.solid{background:rgba(17,26,43,.94);backdrop-filter:blur(14px);padding:10px 0;}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:14px;}
.mark b{display:block;font-family:var(--disp);font-weight:500;font-size:16px;letter-spacing:.02em;}
.mark i{font-style:normal;display:block;font-family:var(--body);font-size:8px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);}
.hd-r{display:flex;align-items:center;gap:clamp(10px,1.6vw,26px);}

/* 言語：参考サイトと同じスラッシュ区切り。5言語なので横スクロール可 */
.langs{display:flex;align-items:center;gap:9px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none;max-width:min(46vw,340px);}
.langs::-webkit-scrollbar{display:none;}
.lang{background:none;border:none;cursor:pointer;white-space:nowrap;font-family:var(--body);font-size:13px;
  letter-spacing:.04em;color:var(--w-f);padding:4px 1px;transition:color .3s;}
.lang:hover{color:var(--w-d);}
.lang[aria-current="true"]{color:var(--w);}
.langs .sep{color:rgba(242,240,236,.25);font-size:12px;}

.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(242,240,236,.55);background:transparent;
  color:var(--w);cursor:pointer;font-family:var(--body);font-weight:500;font-size:13px;letter-spacing:.06em;
  padding:10px 20px;transition:background .3s,color .3s,border-color .3s;}
.pill svg{width:15px;height:15px;}
.pill:hover{background:var(--w);color:var(--navy);border-color:var(--w);}
@media(max-width:700px){.pill span{display:none;} .pill{padding:10px 12px;}}

.burger{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;padding:2px 0;width:44px;}
.burger .bl{width:30px;height:1.5px;background:var(--w);transition:transform .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.burger .btx{font-family:var(--body);font-size:9px;letter-spacing:.16em;color:var(--w);line-height:1;margin-top:1px;}
.nav-open .burger .bl:nth-child(1){transform:translateY(4px) rotate(45deg);}
.nav-open .burger .bl:nth-child(2){transform:translateY(-2.5px) rotate(-45deg);}

/* ---------- full-screen overlay menu ---------- */
.ovl{position:fixed;inset:0;z-index:90;background:rgba(10,15,26,.96);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s;}
.ovl.open{opacity:1;visibility:visible;}
.ovl-in{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);}
.ovl a{display:block;width:max-content;font-family:var(--disp);font-weight:400;letter-spacing:.01em;
  font-size:clamp(28px,5.4vw,60px);line-height:1.5;color:var(--w);
  opacity:0;transform:translateY(16px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1),color .3s;}
.ovl.open a{opacity:1;transform:none;}
.ovl.open a:nth-child(1){transition-delay:.10s;}
.ovl.open a:nth-child(2){transition-delay:.16s;}
.ovl.open a:nth-child(3){transition-delay:.22s;}
.ovl.open a:nth-child(4){transition-delay:.28s;}
.ovl.open a:nth-child(5){transition-delay:.34s;}
.ovl.open a:nth-child(6){transition-delay:.40s;}
.ovl a:hover{color:var(--shu-l);}
.ovl-foot{position:absolute;left:0;right:0;bottom:clamp(24px,5vw,52px);}
.ovl-foot p{font-size:12.5px;line-height:1.9;color:var(--w-f);}

/* ---------- circle chevron button ---------- */
.cbtn{display:inline-flex;align-items:center;gap:clamp(14px,2vw,24px);background:none;border:none;cursor:pointer;
  color:var(--w);font-family:var(--body);padding:0;}
.cbtn .circ{position:relative;flex-shrink:0;width:clamp(52px,6vw,72px);height:clamp(52px,6vw,72px);border-radius:50%;
  border:1px solid rgba(242,240,236,.45);display:grid;place-items:center;overflow:hidden;transition:border-color .4s;}
.cbtn .circ::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--shu);
  transform:scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.cbtn .circ svg{position:relative;z-index:1;width:20px;height:20px;transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cbtn:hover .circ{border-color:var(--shu);}
.cbtn:hover .circ::before{transform:scale(1);}
.cbtn:hover .circ svg{transform:translateX(3px);}
.cbtn .lbl{font-size:14px;font-weight:400;letter-spacing:.12em;}
.cbtn.sm .circ{width:44px;height:44px;} .cbtn.sm .circ svg{width:16px;height:16px;} .cbtn.sm .lbl{font-size:12px;letter-spacing:.18em;text-transform:uppercase;}

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;}
@media(min-width:900px){.hero-media{max-height:88vh;}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-media::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(10,15,26,.45) 0%,rgba(10,15,26,0) 26%,rgba(10,15,26,0) 62%,rgba(17,26,43,.6) 92%,var(--navy) 100%);}
.sound{position:absolute;right:14px;bottom:14px;z-index:4;background:rgba(10,15,26,.5);border:1px solid var(--line);
  color:var(--w-d);font-family:var(--body);font-size:9px;letter-spacing:.2em;text-transform:uppercase;padding:7px 12px;cursor:pointer;}

/* 参考サイトのコンセプト面：見出し左・写真右 */
.lead-sec{position:relative;padding-top:clamp(30px,5vw,70px);}
.lead-grid{display:grid;gap:clamp(26px,4vw,50px);align-items:start;}
@media(min-width:1000px){.lead-grid{grid-template-columns:1fr 1fr;gap:clamp(40px,5vw,80px);}}
.lead-h{font-family:var(--disp);font-weight:400;line-height:1.28;font-size:clamp(30px,5.4vw,62px);letter-spacing:-.01em;}
.lead-h em{font-style:normal;display:block;}
.lead-shot{position:relative;}
.lead-shot img{width:100%;aspect-ratio:16/11;object-fit:cover;}
@media(min-width:1000px){.lead-shot{margin-right:calc(var(--gut) * -1);}}
.hero-name{margin-top:clamp(26px,4vw,44px);padding-top:20px;border-top:1px solid var(--line);
  font-family:var(--disp);font-weight:500;font-size:clamp(16px,2.2vw,23px);line-height:1.5;color:var(--gold);}
.hero-meta{margin-top:10px;display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--body);font-size:10px;
  letter-spacing:.2em;text-transform:uppercase;color:var(--w-f);}
.hero-meta b{color:var(--w-d);font-weight:400;}

/* ---------- interior band（内観） ---------- */
.band-photo{position:relative;width:100%;}
.band-photo img{width:100%;aspect-ratio:21/9;object-fit:cover;}
@media(max-width:760px){.band-photo img{aspect-ratio:4/3;}}
.band-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,15,26,.15) 0%,rgba(10,15,26,.55) 62%,rgba(10,15,26,.8) 100%);}
.band-txt{position:absolute;right:0;top:50%;transform:translateY(-50%);z-index:2;width:100%;}
.band-txt .in{max-width:520px;margin-left:auto;}
@media(max-width:760px){.band-photo::after{background:linear-gradient(180deg,rgba(10,15,26,.2) 0%,rgba(10,15,26,.75) 100%);}}
.band-over{margin-top:clamp(-40px,-4vw,-20px);position:relative;z-index:3;}
/* 写真をずらして重ねるコラージュ */
.collage{display:grid;gap:clamp(20px,3vw,40px);align-items:center;}
@media(min-width:1000px){.collage{grid-template-columns:.9fr 1.1fr;}}
.collage-imgs{position:relative;}
.collage-imgs .a{width:100%;aspect-ratio:16/10;object-fit:cover;}
.collage-imgs .b{position:absolute;right:calc(var(--gut) * -0.5);bottom:-34px;width:44%;aspect-ratio:4/3;
  object-fit:cover;border:6px solid var(--navy);}
@media(max-width:760px){.collage-imgs .b{position:static;width:70%;margin:12px 0 0 auto;border:none;}}

/* ---------- menu ---------- */
.cg{border-top:1px solid var(--line);padding-top:clamp(30px,4.5vw,54px);margin-top:clamp(30px,4.5vw,54px);}
.cg:first-of-type{border-top:none;margin-top:0;padding-top:0;}
.cg-head{display:grid;gap:22px;align-items:end;}
@media(min-width:900px){.cg-head{grid-template-columns:1fr 1fr;gap:48px;}}
.cg-photo{aspect-ratio:16/10;overflow:hidden;background:var(--navy-2);}
.cg-photo img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s cubic-bezier(.16,1,.3,1);}
.cg:hover .cg-photo img{transform:scale(1.035);}
.cg-name{font-family:var(--disp);font-weight:500;font-size:clamp(22px,3vw,34px);line-height:1.25;margin-top:10px;}
.cg-lead{margin-top:10px;font-size:13.5px;line-height:2;color:var(--w-d);}
.item{border-top:1px solid var(--line);}
.item:last-child{border-bottom:1px solid var(--line);}
.item-btn{width:100%;background:none;border:none;cursor:pointer;color:inherit;text-align:left;display:flex;align-items:center;gap:14px;padding:19px 0;font-family:inherit;}
.item-btn:hover .item-name{color:var(--gold);}
.item-name{flex:1;font-family:var(--disp);font-size:17px;line-height:1.4;transition:color .3s;}
.item-tag{font-family:var(--body);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:var(--shu);padding:4px 9px;flex-shrink:0;white-space:nowrap;}
.item-price{font-family:var(--disp);font-size:15.5px;color:var(--gold);flex-shrink:0;}
.item-x{width:11px;height:11px;flex-shrink:0;position:relative;}
.item-x::before,.item-x::after{content:'';position:absolute;background:var(--gold);transition:transform .35s;}
.item-x::before{left:0;top:5px;width:11px;height:1px;}
.item-x::after{left:5px;top:0;width:1px;height:11px;}
.item.open .item-x::after{transform:scaleY(0);}
.item-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.16,1,.3,1);}
.item.open .item-body{max-height:900px;}
.item-inner{padding:0 0 26px;}
.flow{counter-reset:f;}
.flow-row{display:grid;grid-template-columns:26px 1fr;gap:12px;align-items:baseline;padding:9px 0;border-top:1px dotted rgba(242,240,236,.11);}
.flow-row:first-child{border-top:none;}
.fl-n{counter-increment:f;font-family:var(--disp);font-size:10px;color:var(--gold);}
.fl-n::before{content:counter(f,decimal-leading-zero);}
.fl-t{font-size:13px;line-height:1.85;color:var(--w-d);}
.item-note{margin-top:15px;font-size:12px;color:var(--w-f);}

/* ---------- badges / voices ---------- */
.badges{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px;}
.badge{border:1px solid rgba(200,168,106,.4);color:var(--gold);font-family:var(--body);font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:8px 15px;}
.rev-grid{display:grid;gap:14px;margin-top:32px;}
@media(min-width:820px){.rev-grid{grid-template-columns:repeat(2,1fr);}}
.rev{border:1px solid var(--line);padding:24px 22px;background:rgba(242,240,236,.02);}
.stars{color:var(--gold);font-size:13px;letter-spacing:2px;}
.rev-src{font-family:var(--body);font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--w-f);margin-left:9px;}
.rev p{font-family:var(--disp);font-size:15px;line-height:1.85;margin:13px 0 14px;}
.rev cite{font-style:normal;font-family:var(--body);font-size:11px;color:var(--w-f);}
.score{display:flex;flex-wrap:wrap;gap:30px;align-items:center;justify-content:center;text-align:center;margin-top:34px;padding-top:30px;border-top:1px solid var(--line);}
.score b{display:block;font-family:var(--disp);font-size:32px;color:var(--gold);font-weight:500;line-height:1;}
.score span{display:block;margin-top:8px;font-family:var(--body);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-f);}

/* ---------- story / access ---------- */
.split{display:grid;gap:clamp(28px,5vw,66px);align-items:center;}
@media(min-width:900px){.split{grid-template-columns:1.05fr .95fr;} .split.rev-o>*:first-child{order:2;}}
.frame img{width:100%;aspect-ratio:4/5;object-fit:cover;}
.quote{font-family:var(--disp);font-size:clamp(18px,2.5vw,25px);line-height:1.65;border-left:2px solid var(--shu);padding-left:24px;margin:28px 0 10px;}
.by{font-family:var(--body);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);padding-left:26px;}
.blocks{display:grid;gap:30px;margin-top:38px;}
@media(min-width:820px){.blocks{grid-template-columns:repeat(3,1fr);gap:42px;}}
.blocks h4{font-family:var(--body);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
.info{display:grid;gap:clamp(28px,5vw,56px);}
@media(min-width:900px){.info{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:120px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--line);}
@media(max-width:520px){.dl div{grid-template-columns:1fr;gap:5px;}}
.dl dt{font-family:var(--body);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-f);padding-top:4px;}
.dl dd{font-size:13.5px;line-height:1.85;}
.dl dd a{color:var(--gold);border-bottom:1px solid rgba(200,168,106,.35);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--line);}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- footer（参考サイト構成：左ブランド／右ナビ） ---------- */
footer{background:var(--navy-3);padding:clamp(56px,8vw,110px) 0 clamp(30px,4vw,52px);}
.ft-grid{display:grid;gap:clamp(34px,5vw,60px);}
@media(min-width:820px){.ft-grid{grid-template-columns:1.4fr 1fr;}}
.ft-small{font-family:var(--body);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-f);}
.ft-name{font-family:var(--disp);font-weight:500;font-size:clamp(24px,3.6vw,40px);line-height:1.2;margin-top:4px;}
.ft-addr{margin-top:22px;font-size:12.5px;line-height:2;color:var(--w-f);}
.ft-addr a{color:var(--gold);}
.ft-nav{display:grid;gap:2px;}
@media(min-width:820px){.ft-nav{justify-items:start;margin-left:auto;}}
.ft-nav a{font-family:var(--disp);font-size:clamp(15px,1.8vw,19px);letter-spacing:.06em;padding:9px 0;color:var(--w-d);transition:color .3s;}
.ft-nav a:hover{color:var(--w);}
.ft-bar{margin-top:clamp(38px,5vw,66px);padding-top:22px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-family:var(--body);font-size:10px;letter-spacing:.14em;color:rgba(242,240,236,.3);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header class="hd" id="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top"><b>Omakase</b><i>Wagyu &amp; Sushi</i></a>
    <div class="hd-r">
      <div class="langs" role="group" aria-label="Language">
        {% for l in ui.langs %}{% if not loop.first %}<span class="sep" aria-hidden="true">/</span>{% endif %}<button class="lang" data-lang-btn="{{ l.code }}"{% if l.code == 'en' %} aria-current="true"{% endif %}>{{ l.short }}</button>{% endfor %}
      </div>
      <button class="pill" onclick="openReserve('header')" data-ga-event="reserve_click" data-ga-location="header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3v3M16 3v3M3.5 9h17M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5z" stroke-linecap="round"/></svg>
        <span data-i18n="nav.reserve">Reserve</span>
      </button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
        <span class="bl"></span><span class="bl"></span><span class="btx" id="btx">MENU</span>
      </button>
    </div>
  </div>
</header>

<div class="ovl" id="ovl">
  <div class="ovl-in wrap">
    <nav>

---
pagination:
  data: stores.pagesTestA
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  is_form_reserve: "{{ 'true' if store.reserve_system == 'form' else 'false' }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Omakase sushi and wagyu, Muslim-friendly and alcohol-free, in {{ store.city }}."/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-a'});
</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Shippori+Mincho:wght@400;600&family=Jost:wght@300;400;500&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet"/>

<style>
:root{
  --ink:#12100e; --ink-2:#1a1714; --ink-3:#221e1a;
  --kinari:#e9e3d6; --kinari-d:rgba(233,227,214,.60); --kinari-f:rgba(233,227,214,.38);
  --brass:#a98a52; --brass-l:#c4a874; --shu:#9c3a2e;
  --line:rgba(233,227,214,.13);
  --disp:'Marcellus',serif; --body:'Jost',sans-serif; --jp:'Shippori Mincho',serif;
  --rv-bg:var(--ink-2); --rv-panel:var(--ink); --rv-line:var(--line);
  --rv-text:var(--kinari); --rv-muted:var(--kinari-f); --rv-accent:var(--brass);
  --rv-on-accent:#12100e; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:4px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--ink);color:var(--kinari);font-family:var(--body);font-weight:300;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.85;}
html[data-lang="ja"] body{font-family:var(--jp);}
html[data-lang="zh"] body{font-family:'Noto Serif SC',serif;}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--brass-l);outline-offset:3px;}

.wrap{width:min(1180px,90vw);margin-inline:auto;}
.narrow{width:min(720px,88vw);margin-inline:auto;}

/* ---------- type ---------- */
.eyebrow{font-family:var(--body);font-size:10px;font-weight:400;letter-spacing:.42em;
  text-transform:uppercase;color:var(--brass);}
.h-en{font-family:var(--disp);font-weight:400;line-height:1.24;letter-spacing:.005em;
  font-size:clamp(27px,4.4vw,50px);}
.h-jp{font-family:var(--jp);font-weight:400;font-size:13px;letter-spacing:.2em;color:var(--kinari-d);}
.p{font-size:14.5px;line-height:2.15;color:var(--kinari-d);font-weight:300;}
html[data-lang="ja"] .p,html[data-lang="zh"] .p{font-size:14px;line-height:2.25;}

/* rule that draws in — used once per section heading */
.rule{display:block;width:0;height:1px;background:var(--brass);margin:22px 0 0;
  transition:width 1.1s cubic-bezier(.16,1,.3,1) .15s;}
.in .rule{width:56px;}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}.rule{width:56px;transition:none;}}

html.no-js .reveal{opacity:1;transform:none;}
html.no-js .rule{width:56px;}
/* ---------- header ---------- */
.hd{position:fixed;top:0;left:0;right:0;z-index:80;padding:16px 0;
  transition:background .45s ease,padding .45s ease,border-color .45s ease;
  border-bottom:1px solid transparent;}
.hd.solid{background:rgba(18,16,14,.93);backdrop-filter:blur(14px);padding:11px 0;border-bottom-color:var(--line);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:14px;}
.mark{display:flex;flex-direction:column;line-height:1.15;}
.mark b{font-family:var(--disp);font-size:15px;letter-spacing:.1em;font-weight:400;color:var(--kinari);}
.mark i{font-style:normal;font-family:var(--body);font-size:8.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--brass);}
.hd-r{display:flex;align-items:center;gap:12px;}
.langs{display:flex;gap:2px;}
.lang{background:none;border:none;cursor:pointer;font-family:var(--body);font-size:10px;
  letter-spacing:.16em;color:var(--kinari-f);padding:5px 7px;transition:color .3s;}
.lang[aria-pressed="true"]{color:var(--brass-l);border-bottom:1px solid var(--brass);}
.lang:hover{color:var(--kinari);}
.hd-cta{border:1px solid rgba(169,138,82,.55);color:var(--brass-l);font-family:var(--body);
  font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;padding:9px 17px;cursor:pointer;
  background:transparent;transition:background .3s,color .3s;}
.hd-cta:hover{background:var(--brass);color:var(--ink);}
.burger{width:32px;height:32px;background:none;border:none;cursor:pointer;display:flex;
  flex-direction:column;justify-content:center;gap:5px;padding:0;}
.burger span{display:block;height:1px;background:var(--kinari);transition:transform .35s,opacity .35s;}
.burger span:nth-child(1){width:22px;} .burger span:nth-child(2){width:15px;margin-left:auto;}
.nav-open .burger span:nth-child(1){transform:translateY(3px) rotate(45deg);width:22px;}
.nav-open .burger span:nth-child(2){transform:translateY(-3px) rotate(-45deg);width:22px;margin-left:0;}
@media(max-width:700px){.hd-cta{display:none;}}

.drawer{position:fixed;inset:0;z-index:79;background:rgba(18,16,14,.985);
  display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .5s ease;}
.drawer.open{opacity:1;pointer-events:auto;}
.drawer nav{text-align:center;}
.drawer a{display:block;font-family:var(--disp);font-size:clamp(22px,5vw,34px);
  padding:11px 0;color:var(--kinari);transition:color .3s;}
.drawer a:hover{color:var(--brass-l);}
.drawer small{display:block;font-family:var(--body);font-size:9px;letter-spacing:.32em;
  text-transform:uppercase;color:var(--kinari-f);margin-top:-4px;}

/* ---------- hero ---------- */
.hero{position:relative;background:#000;}
.hero-media{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;}
@media(min-width:900px){.hero-media{max-height:90vh;}}
.hero-media video,.hero-media img{width:100%;height:100%;object-fit:cover;}
.hero-media::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(0,0,0,.34) 0%,rgba(0,0,0,0) 26%,rgba(0,0,0,0) 52%,rgba(18,16,14,.72) 92%,var(--ink) 100%);}
/* 縦書きの標識 — このページの署名 */
.tate{position:absolute;left:clamp(10px,2.4vw,30px);top:11%;z-index:3;
  writing-mode:vertical-rl;font-family:var(--jp);font-size:clamp(12px,1.35vw,16px);
  letter-spacing:.55em;color:rgba(233,227,214,.82);text-shadow:0 2px 18px rgba(0,0,0,.85);
  padding-bottom:36px;}
.tate::after{content:'';position:absolute;left:50%;bottom:0;width:1px;height:26px;background:rgba(233,227,214,.5);}
.hero-cap{position:relative;z-index:3;padding:26px 0 34px;}
@media(min-width:900px){
  .hero-cap{position:absolute;left:0;right:0;bottom:0;padding-bottom:52px;}
}
.hero-cap .eyebrow{display:block;margin-bottom:14px;}
.hero-h{font-family:var(--disp);font-weight:400;line-height:1.16;
  font-size:clamp(30px,5.6vw,64px);letter-spacing:.004em;}
.hero-sub{margin-top:14px;font-size:13px;letter-spacing:.12em;color:var(--kinari-d);}
.hero-meta{margin-top:22px;display:flex;flex-wrap:wrap;gap:10px 26px;align-items:center;
  font-family:var(--body);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--kinari-f);}
.hero-meta b{color:var(--brass-l);font-weight:400;}
.sound{position:absolute;right:12px;bottom:12px;z-index:4;background:rgba(18,16,14,.6);
  border:1px solid var(--line);color:var(--kinari-d);font-family:var(--body);font-size:9px;
  letter-spacing:.2em;text-transform:uppercase;padding:7px 12px;cursor:pointer;backdrop-filter:blur(6px);}

/* ---------- sections ---------- */
section{position:relative;}
.pad{padding:clamp(76px,11vw,140px) 0;}
.sec-head{max-width:640px;}
.sec-head .eyebrow{display:block;margin-bottom:16px;}

.split{display:grid;gap:clamp(30px,5vw,72px);align-items:center;}
@media(min-width:900px){.split{grid-template-columns:1.06fr .94fr;}
  .split.rev>*:first-child{order:2;}}
.frame{position:relative;overflow:hidden;background:var(--ink-2);}
.frame img,.frame video{width:100%;height:100%;object-fit:cover;aspect-ratio:4/5;}
.frame.wide img,.frame.wide video{aspect-ratio:16/10;}

/* ---------- menu ---------- */
.course-group{border-top:1px solid var(--line);padding-top:clamp(34px,5vw,58px);
  margin-top:clamp(34px,5vw,58px);}
.course-group:first-of-type{border-top:none;margin-top:0;padding-top:0;}
.cg-head{display:grid;gap:26px;align-items:end;}
@media(min-width:900px){.cg-head{grid-template-columns:1fr 1fr;gap:52px;}}
.cg-photo{aspect-ratio:16/10;overflow:hidden;background:var(--ink-2);}
.cg-photo img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s cubic-bezier(.16,1,.3,1);}
.course-group:hover .cg-photo img{transform:scale(1.035);}
.cg-name{font-family:var(--disp);font-size:clamp(23px,3.2vw,34px);line-height:1.2;}
.cg-lead{margin-top:12px;font-size:13.5px;line-height:2.05;color:var(--kinari-d);}

.item{border-top:1px solid var(--line);}
.item:last-child{border-bottom:1px solid var(--line);}
.item-btn{width:100%;background:none;border:none;cursor:pointer;color:inherit;text-align:left;
  display:flex;align-items:baseline;gap:16px;padding:19px 0;font-family:inherit;}
.item-btn:hover .item-name{color:var(--brass-l);}
.item-name{flex:1;font-family:var(--disp);font-size:16.5px;letter-spacing:.02em;transition:color .3s;}
html[data-lang="ja"] .item-name,html[data-lang="zh"] .item-name{font-family:inherit;font-size:15px;}
.item-tag{font-family:var(--body);font-size:9px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--shu);border:1px solid rgba(156,58,46,.5);padding:2px 7px;flex-shrink:0;}
.item-price{font-family:var(--disp);font-size:15px;color:var(--brass-l);flex-shrink:0;}
.item-x{width:11px;height:11px;flex-shrink:0;position:relative;}
.item-x::before,.item-x::after{content:'';position:absolute;background:var(--brass);transition:transform .35s;}
.item-x::before{left:0;top:5px;width:11px;height:1px;}
.item-x::after{left:5px;top:0;width:1px;height:11px;}
.item.open .item-x::after{transform:scaleY(0);}
.item-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.16,1,.3,1);}
.item.open .item-body{max-height:760px;}
.item-inner{padding:0 0 24px;}
.flow{counter-reset:f;}
.flow-row{display:grid;grid-template-columns:26px 78px 1fr;gap:12px;align-items:baseline;
  padding:8px 0;border-top:1px dotted rgba(233,227,214,.11);}
.flow-row:first-child{border-top:none;}
@media(max-width:620px){.flow-row{grid-template-columns:22px 1fr;}.flow-row .fl-lab{grid-column:2;}}
.fl-n{counter-increment:f;font-family:var(--disp);font-size:10px;color:var(--brass);letter-spacing:.08em;}
.fl-n::before{content:counter(f,decimal-leading-zero);}
.fl-lab{font-family:var(--jp);font-size:11px;letter-spacing:.18em;color:var(--brass-l);}
.fl-txt{font-size:13px;line-height:1.85;color:var(--kinari-d);}
.item-note{margin-top:16px;font-size:12px;color:var(--kinari-f);line-height:1.9;}
.item-go{margin-top:18px;background:none;border:1px solid rgba(169,138,82,.5);color:var(--brass-l);
  font-family:var(--body);font-size:10px;letter-spacing:.22em;text-transform:uppercase;
  padding:11px 22px;cursor:pointer;transition:background .3s,color .3s;}
.item-go:hover{background:var(--brass);color:var(--ink);}

/* ---------- quiet bands ---------- */
.band{background:var(--ink-2);}
.stat-row{display:grid;gap:1px;background:var(--line);border:1px solid var(--line);}
@media(min-width:700px){.stat-row{grid-template-columns:repeat(3,1fr);}}
.stat{background:var(--ink);padding:28px 22px;text-align:center;}
.stat b{display:block;font-family:var(--disp);font-size:27px;color:var(--brass-l);font-weight:400;line-height:1.2;}
.stat span{display:block;margin-top:7px;font-family:var(--body);font-size:9.5px;letter-spacing:.24em;
  text-transform:uppercase;color:var(--kinari-f);}

/* ---------- info ---------- */
.info{display:grid;gap:clamp(30px,5vw,60px);}
@media(min-width:900px){.info{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:96px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--line);}
.dl dt{font-family:var(--body);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--kinari-f);padding-top:4px;}
.dl dd{font-size:13.5px;line-height:1.85;color:var(--kinari);}
.dl dd a{color:var(--brass-l);border-bottom:1px solid rgba(169,138,82,.35);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--line);}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;filter:grayscale(88%) contrast(1.05) brightness(.86);}

/* ---------- closing ---------- */
.close-cta{text-align:center;}
.btn-solid{display:inline-block;background:var(--brass);color:var(--ink);border:none;cursor:pointer;
  font-family:var(--body);font-size:12px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;
  padding:19px 52px;transition:filter .3s,transform .2s;}
.btn-solid:hover{filter:brightness(1.09);}
.btn-solid:active{transform:translateY(1px);}

footer{border-top:1px solid var(--line);padding:46px 0 34px;}
.ft{display:flex;flex-wrap:wrap;gap:22px;justify-content:space-between;align-items:flex-start;}
.ft-nav{display:flex;flex-wrap:wrap;gap:18px;}
.ft-nav a{font-family:var(--body);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--kinari-f);}
.ft-nav a:hover{color:var(--brass-l);}
.ft-c{margin-top:26px;font-family:var(--body);font-size:9.5px;letter-spacing:.16em;color:rgba(233,227,214,.26);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header class="hd" id="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top">
      <b>Omakase</b><i data-i18n="brand.sub">Wagyu &amp; Sushi</i>
    </a>
    <div class="hd-r">
      <div class="langs" role="group" aria-label="Language">
        <button class="lang" data-lang-btn="en" aria-pressed="true">EN</button>
        <button class="lang" data-lang-btn="ja" aria-pressed="false">日本語</button>
        <button class="lang" data-lang-btn="zh" aria-pressed="false">中文</button>
      </div>
      <button class="hd-cta" onclick="openReserve('header')" data-i18n="nav.reserve">Reserve</button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>
</header>

<div class="drawer" id="drawer">
  <nav>
    <a href="#concept" data-nav>Concept<small data-i18n="nav.concept.s">コンセプト</small></a>
    <a href="#menu" data-nav>Menu<small data-i18n="nav.menu.s">お品書き</small></a>
    <a href="#counter" data-nav>The Counter<small data-i18n="nav.counter.s">カウンター</small></a>
    <a href="#access" data-nav>Access<small data-i18n="nav.access.s">店舗情報</small></a>
    <a href="#reserve" data-nav>Reserve<small data-i18n="nav.reserve.s">ご予約</small></a>
  </nav>
</div>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-media">
    <video id="heroVid" autoplay muted loop playsinline preload="metadata" poster="/images/top.jpg">
      <source src="/images/hero1.mp4" type="video/mp4"/>
    </video>
    <span class="tate" aria-hidden="true">旬を、握る。</span>
    <button class="sound" id="soundBtn" data-i18n="hero.sound">Sound on</button>
  </div>
  <div class="wrap">
    <div class="hero-cap">
      <span class="eyebrow">{{ store.region_label }}</span>
      <h1 class="hero-h" data-i18n="hero.h">Wagyu and sushi,<br/>one counter.</h1>
      <p class="hero-sub" data-i18n="hero.sub">Muslim-friendly omakase — every dish alcohol-free.</p>
      <div class="hero-meta">
        <span><b>{{ store.rating }}</b> &nbsp;Google · {{ store.rating_count }}</span>
        <span data-i18n="hero.m2">Halal-conscious kitchen</span>
        <span data-i18n="hero.m3">English &amp; Chinese spoken</span>
      </div>
    </div>
  </div>
</section>

<!-- ============ CONCEPT ============ -->
<section class="pad" id="concept">
  <div class="wrap split">
    <div class="frame reveal">
      <video autoplay muted loop playsinline preload="none" poster="/images/sushi1.jpg">
        <source src="/images/hero2.mp4" type="video/mp4"/>
      </video>
    </div>
    <div class="sec-head reveal">
      <span class="eyebrow">Concept</span>
      <h2 class="h-en" data-i18n="con.h">Two crafts,<br/>one seating.</h2>
      <span class="rule"></span>
      <p class="p" style="margin-top:26px;" data-i18n="con.p1">Most restaurants ask you to choose. Sushi, or beef. Here the same counter does both: nigiri shaped by hand on the board, wagyu finished on the iron plate a metre away — served in one continuous course.</p>
      <p class="p" style="margin-top:18px;" data-i18n="con.p2">Everything is prepared without alcohol or pork, so a table of mixed dietary needs can order from the same menu without asking a single awkward question.</p>
    </div>
  </div>
</section>

<!-- ============ MENU ============ -->
<section class="pad band" id="menu">
  <div class="wrap">
    <div class="sec-head reveal" style="margin-bottom:clamp(46px,7vw,84px);">
      <span class="eyebrow">Menu</span>
      <h2 class="h-en" data-i18n="menu.h">What the counter serves</h2>
      <span class="rule"></span>
      <p class="p" style="margin-top:26px;" data-i18n="menu.p">Three directions, eight courses. Each runs eight dishes over about seventy minutes, and the ingredients shift with the season.</p>
    </div>

    {% for cat in courses.cats %}
    <div class="course-group reveal">
      <div class="cg-head">
        <div class="cg-photo"><img src="{{ cat.img }}" alt="{{ cat.label.en }}" loading="lazy"/></div>
        <div>
          <span class="eyebrow">{{ "0" + (loop.index | string) }} &nbsp;/&nbsp; {{ courses.cats | length }}</span>
          <h3 class="cg-name" style="margin-top:12px;" data-i18n="cat.{{ cat.key }}.label">{{ cat.label.en }}</h3>
          <p class="cg-lead" data-i18n="cat.{{ cat.key }}.lead">{{ cat.lead.en }}</p>
        </div>
      </div>

      <div style="margin-top:clamp(24px,3.4vw,40px);">
      {% for c in courses.list %}{% if c.cat == cat.key %}
        <div class="item" id="item-{{ c.id }}">
          <button class="item-btn" type="button" data-item="{{ c.id }}" aria-expanded="false" aria-controls="body-{{ c.id }}">
            <span class="item-name" data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</span>
            {% if c.web_only %}<span class="item-tag" data-i18n="tag.web">Web only</span>{% endif %}
            {% if c.lunch_only %}<span class="item-tag" data-i18n="tag.lunch">Lunch</span>{% endif %}
            {% if showPrice %}{% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}<span class="item-price">&yen;{{ yen(p) }}</span>{% endif %}
            <span class="item-x" aria-hidden="true"></span>
          </button>
          <div class="item-body" id="body-{{ c.id }}">
            <div class="item-inner">
              <p class="p" style="font-size:13.5px;margin-bottom:18px;" data-i18n="course.{{ c.id }}.lead">{{ c.lead.en }}</p>
              <div class="flow">
                {% for r in c.rows %}
                <div class="flow-row">
                  <span class="fl-n"></span>
                  <span class="fl-lab" data-i18n="course.{{ c.id }}.r{{ loop.index0 }}.l">{{ r.label.en }}</span>
                  <span class="fl-txt" data-i18n="course.{{ c.id }}.r{{ loop.index0 }}.t">{{ r.text.en }}</span>
                </div>
                {% endfor %}
              </div>
              <p class="item-note">
                <span data-i18n="course.meta">8 dishes · about 70 minutes</span>{% if showPrice %}{% set p2 = c.base + (0 if c.noadj else (store.price_adjust or 0)) %} · &yen;{{ yen((p2 * 1.1) | round(0,"floor") | int) }} <span data-i18n="course.incl">incl. tax</span>{% endif %}
              </p>
              <button class="item-go" type="button" onclick="openReserve('menu_{{ c.id }}','{{ c.id }}')" data-i18n="course.book">Book this course</button>
            </div>
          </div>
        </div>
      {% endif %}{% endfor %}
      </div>
    </div>
    {% endfor %}

    <p class="p reveal" style="margin-top:40px;font-size:12.5px;" data-i18n="menu.foot">Every course is Muslim-friendly and alcohol-free. Tell us about allergies when you book and the chef will adjust the course.</p>
  </div>
</section>

<!-- ============ THE COUNTER ============ -->
<section class="pad" id="counter">
  <div class="wrap split rev">
    <div class="sec-head reveal">
      <span class="eyebrow">The Counter</span>
      <h2 class="h-en" data-i18n="cnt.h">Cooked an arm's<br/>length away.</h2>
      <span class="rule"></span>
      <p class="p" style="margin-top:26px;" data-i18n="cnt.p1">The counter seats a dozen. There is no pass, no service window — the chef works the board and the plate in front of you, and hands each piece over directly.</p>
      <p class="p" style="margin-top:18px;" data-i18n="cnt.p2">Ask what you are eating. Where the fish came in from that morning, why the fillet rests before it is cut. Our chefs answer in English, and often in Chinese.</p>
    </div>
    <div class="frame reveal">
      <video autoplay muted loop playsinline preload="none" poster="/images/chef1.jpg">
        <source src="/images/hero3.mp4" type="video/mp4"/>
      </video>
    </div>
  </div>

  <div class="wrap" style="margin-top:clamp(50px,7vw,92px);">
    <div class="stat-row reveal">
      <div class="stat"><b>{{ store.rating }}</b><span>Google · {{ store.rating_count }} reviews</span></div>
      <div class="stat"><b data-i18n="st2.b">No alcohol</b><span data-i18n="st2.s">In any dish or sauce</span></div>
      <div class="stat"><b data-i18n="st3.b">{{ store.max_guests }} seats</b><span data-i18n="st3.s">Counter only</span></div>
    </div>
  </div>
</section>

<!-- ============ HALAL ============ -->
<section class="pad band" id="halal">

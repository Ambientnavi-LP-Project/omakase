          <p class="cg-lead" style="font-size:12.5px;color:var(--gold);" data-i18n="cat.{{ cat.key }}.note">{{ cat.note.en }}</p>
        </div>
      </div>
      <div style="margin-top:clamp(20px,3vw,36px);">
      {% for c in courses.list %}{% if c.cat == cat.key %}
        <div class="item">
          <button class="item-btn" type="button" data-item="{{ c.id }}" aria-expanded="false" aria-controls="body-{{ c.id }}">

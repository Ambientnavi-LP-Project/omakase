---
pagination:
  data: stores.pagesTestA
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% if store.theme == "wagyu" %}
{% set IMG = {
  heroMain: "/images/course-kobe-premium.jpg",
  hero:    "/images/ロコ_あり和牛.mp4",
  poster:  "/images/ロコ_あり和牛-poster.jpg",
  lead:    "/images/wagyu-lead.jpg",
  concept: "/images/course-kobe-premium.jpg",
  band:    "/images/cat-wagyu.jpg",
  col_a:   "/images/course-wagyu-standard.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/chef3.jpg",
  courses: ["/images/course-wagyu-standard.jpg","/images/course-kobe-premium.jpg","/images/wagyu-lead.jpg","/images/cat-wagyu.jpg"]
} %}
{% else %}
{% set IMG = {
  heroMain: "/images/course-sushi-premium.jpg",
  hero:    "/images/ロコ_あり寿司.mp4",
  poster:  "/images/ロコ_あり寿司-poster.jpg",
  lead:    "/images/sushi1.jpg",
  concept: "/images/sushi2.jpg",
  band:    "/images/cat-sushi.jpg",
  col_a:   "/images/course-sushi-premium.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/sushi4.jpg",
  courses: ["/images/course-sushi-standard.jpg","/images/course-sushi-premium.jpg","/images/sushi1.jpg","/images/sushi2.jpg"]
} %}
{% endif %}
{% set SHOW_PERFORMANCE = false %}   {# パフォーマンスセクションの表示切替。true で復活 #}
{% set TH = courses.themes[store.theme] or courses.themes.all %}
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
{% macro circ() %}<span class="circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Sushi &amp; Wagyu Halal Omakase Experience — {{ store.name_full_en }}"/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-a',theme:'{{ store.theme }}'});</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/>

<style>
:root{
  /* 黒基調 × えんじ × 金 */
  --navy:#0c0a09; --navy-2:#15100f; --navy-3:#070605;
  --paper:#efe9dc;
  --w:#f4f1ea; --w-d:rgba(244,241,234,.86); --w-f:rgba(244,241,234,.60);
  --shu:#7d2231; --shu-l:#9c2c3d; --gold:#c9a96e; --gold-l:#e0c793;
  --line:rgba(244,241,234,.18);
  --disp:'Lora',serif; --body:'Jost',sans-serif;
  --gut:clamp(24px,6vw,104px);
  --rv-bg:var(--navy-2); --rv-panel:var(--navy-3); --rv-line:var(--line);
  --rv-text:var(--w); --rv-muted:var(--w-f); --rv-accent:var(--shu-l);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:4px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--navy);color:var(--w);font-family:var(--body);font-weight:400;line-height:1.8;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
  background-image:repeating-radial-gradient(circle at 16% 34%,rgba(201,169,110,.035) 0 1px,transparent 1px 58px);}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
.wrap{width:100%;max-width:1160px;margin-inline:auto;padding-inline:var(--gut);}
.narrow{width:100%;max-width:800px;margin-inline:auto;padding-inline:var(--gut);}
.pad{padding:clamp(66px,10vw,142px) 0;}

.eyebrow{display:inline-block;font-family:var(--body);font-weight:500;font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);}
.h-en{font-family:var(--disp);font-weight:400;line-height:1.28;font-size:clamp(26px,4.2vw,50px);letter-spacing:-.006em;}
.p{font-size:16px;line-height:1.95;color:var(--w-d);}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
html.no-js .reveal{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}



/* ---------- えんじのアクセント ---------- */
.eyebrow{position:relative;padding-left:22px;}
.eyebrow::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:14px;height:2px;background:var(--shu-l);}
.h-en{position:relative;}
.sec-mark{display:block;width:44px;height:2px;background:var(--shu-l);margin-top:18px;}
.hd{border-bottom:1px solid var(--line);box-shadow:inset 0 -3px 0 -2px var(--shu);}
.s-dots button.on{background:var(--shu-l);width:44px;}
.ccard-price{color:var(--shu-l);}
.ccard{border-left:2px solid transparent;transition:border-color .35s;}
.ccard:hover{border-left-color:var(--shu-l);}
.halal-icon{color:var(--shu-l);}
.scar-1{color:var(--shu-l);}
.cbtn:hover .lbl{color:var(--shu-l);}
.sec-light .cbtn:hover .lbl{color:var(--shu);}
.sec-light .ccard-price{color:var(--shu);}
.sec-light .eyebrow::before{background:var(--shu);}
.sec-light .scar-1{color:var(--shu);}
footer{border-top:2px solid var(--shu);}
.g-num{color:var(--gold);}
.rev{border-left:2px solid rgba(156,44,61,.45);}
.flow-row .fl-n{color:var(--shu-l);}
.sec-light .flow-row .fl-n{color:var(--shu);}
.item-tag{display:inline-block;background:var(--shu);color:#fff;font-family:var(--body);font-weight:600;
  font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;padding:5px 11px;vertical-align:middle;}
.ccard-tag{background:var(--shu);}

/* ---------- header ---------- */
.hd{position:sticky;top:0;z-index:95;padding:14px 0;background:var(--navy);
  border-bottom:1px solid var(--line);transition:padding .4s,box-shadow .4s;}
.hd.solid{padding:10px 0;box-shadow:0 10px 30px -18px rgba(0,0,0,.9);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:clamp(10px,2vw,26px);}
/* 左上：ロゴ＋フル店名。折り返して全文を出す（省略しない） */
.mark{display:flex;align-items:center;flex-shrink:0;}
.mark img{width:clamp(58px,7vw,96px);height:auto;}
.mark b{display:block;font-family:var(--disp);font-weight:500;line-height:1.3;
  font-size:clamp(10.5px,1.15vw,15px);letter-spacing:.005em;
  white-space:normal;overflow-wrap:anywhere;word-break:normal;}
@media(max-width:900px){.mark{max-width:none;}}
@media(max-width:520px){.mark img{width:34px;} .mark b{font-size:10px;line-height:1.28;}}
.hd-r{display:flex;align-items:center;gap:clamp(8px,1.4vw,22px);flex-shrink:0;}

/* 言語：ボタン＋選択シート */
.langbtn{display:flex;align-items:center;gap:7px;background:transparent;border:1px solid var(--line);
  cursor:pointer;color:var(--w);font-family:var(--body);font-weight:500;font-size:13.5px;letter-spacing:.04em;padding:10px 14px;transition:color .3s,border-color .3s;}
.langbtn:hover{color:var(--w);border-color:rgba(242,240,236,.35);}
.langbtn svg{width:15px;height:15px;flex-shrink:0;color:var(--gold);}
@media(max-width:560px){.langbtn span{display:none;} .langbtn{padding:10px 12px;}}
.sheet{position:fixed;inset:0;z-index:96;display:none;place-items:center;padding:20px;background:rgba(6,5,4,.75);backdrop-filter:blur(4px);}
.sheet.open{display:grid;}
.sheet-in{background:var(--navy-2);border:1px solid var(--line);width:100%;max-width:400px;padding:26px;
  animation:sheetUp .34s cubic-bezier(.16,1,.3,1) both;}
@keyframes sheetUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
@media(prefers-reduced-motion:reduce){.sheet-in{animation:none;}}
.sheet-in h4{font-family:var(--disp);font-weight:500;font-size:20px;}
.sheet-in p{font-size:13.5px;line-height:1.75;color:var(--w-d);margin:5px 0 18px;}
.sheet-list{display:grid;gap:2px;}
.sheet-list button{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;
  background:none;border:none;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--w);text-align:left;padding:13px 14px;transition:background .25s;}
.sheet-list button:hover{background:rgba(242,240,236,.06);}
.sheet-list button[aria-current="true"]{background:rgba(200,168,106,.14);color:var(--gold);}
.sheet-list .code{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.1em;color:var(--w-d);}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(242,240,236,.55);background:transparent;
  color:var(--w);cursor:pointer;font-family:var(--body);font-weight:500;font-size:13px;letter-spacing:.06em;
  padding:10px 20px;transition:background .3s,color .3s,border-color .3s;}
.pill svg{width:15px;height:15px;}
.pill:hover{background:var(--w);color:var(--navy);border-color:var(--w);}
@media(max-width:700px){.pill span{display:none;} .pill{padding:10px 12px;}}

.burger{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;padding:2px 0;width:44px;}
.burger .bl{width:30px;height:1.5px;background:var(--w);transition:transform .4s cubic-bezier(.16,1,.3,1),opacity .3s;}
.burger .btx{font-family:var(--body);font-size:9px;letter-spacing:.16em;color:var(--w);line-height:1;margin-top:1px;}
.nav-open .burger .bl:nth-child(1){transform:translateY(4px) rotate(45deg);}
.nav-open .burger .bl:nth-child(2){transform:translateY(-2.5px) rotate(-45deg);}

/* ---------- full-screen overlay menu ---------- */
.ovl{position:fixed;inset:0;z-index:90;display:flex;flex-direction:column;justify-content:center;padding:clamp(78px,11vh,120px) 0 clamp(22px,4vh,44px);overflow-y:auto;background:rgba(6,5,4,.965);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s;}
.ovl.open{opacity:1;visibility:visible;}
.ovl-in{margin:auto 0;width:100%;}
.ovl a{display:block;width:max-content;font-family:var(--disp);font-weight:400;letter-spacing:-.005em;
  font-size:clamp(28px,5.4vw,60px);line-height:1.5;color:var(--w);
  opacity:0;transform:translateY(16px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1),color .3s;}
.ovl.open a{opacity:1;transform:none;}
.ovl.open a:nth-child(1){transition-delay:.10s;}
.ovl.open a:nth-child(2){transition-delay:.16s;}
.ovl.open a:nth-child(3){transition-delay:.22s;}
.ovl.open a:nth-child(4){transition-delay:.28s;}
.ovl.open a:nth-child(5){transition-delay:.34s;}
.ovl.open a:nth-child(6){transition-delay:.40s;}
.ovl a:hover{color:var(--gold-l);}
.ovl-foot{width:100%;margin-top:clamp(22px,4vh,44px);padding-top:clamp(18px,3vh,30px);border-top:1px solid rgba(255,255,255,.14);}
.ovl-logo{width:clamp(84px,10vw,128px);height:auto;margin-bottom:12px;opacity:.85;}
.ovl-foot p{font-size:12.5px;line-height:1.9;color:var(--w-f);}

/* ---------- circle chevron button ---------- */
.cbtn{display:inline-flex;align-items:center;gap:clamp(14px,2vw,24px);background:none;border:none;cursor:pointer;
  color:var(--w);font-family:var(--body);padding:0;}
.cbtn .circ{position:relative;flex-shrink:0;width:clamp(52px,6vw,72px);height:clamp(52px,6vw,72px);border-radius:50%;
  border:1px solid rgba(242,240,236,.45);display:grid;place-items:center;overflow:hidden;transition:border-color .4s;}
.cbtn .circ::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--shu-l);
  transform:scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.cbtn .circ svg{position:relative;z-index:1;width:20px;height:20px;transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cbtn:hover .circ{border-color:var(--gold);}
.cbtn:hover .circ::before{transform:scale(1);}
.cbtn:hover .circ svg{transform:translateX(3px);}
.cbtn .lbl{font-size:15px;font-weight:500;letter-spacing:.1em;}
.cbtn.sm .circ{width:46px;height:46px;} .cbtn.sm .circ svg{width:17px;height:17px;} .cbtn.sm .lbl{font-size:13px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;}

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;}
@media(min-width:900px){.hero-media{max-height:calc(92vh - 72px);}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-media::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(0,0,0,0) 0%,rgba(0,0,0,0) 60%,rgba(12,10,9,.55) 90%,var(--navy) 100%);}

/* 参考サイトのコンセプト面：見出し左・写真右 */
.lead-sec{position:relative;padding-top:clamp(34px,5vw,72px);}
.lead-grid{display:grid;gap:clamp(26px,4vw,50px);align-items:start;}
@media(min-width:1000px){.lead-grid{grid-template-columns:1fr 1fr;gap:clamp(40px,5vw,80px);}}
.lead-h{font-family:var(--disp);font-weight:400;line-height:1.3;font-size:clamp(23px,3.4vw,40px);letter-spacing:-.01em;overflow-wrap:anywhere;}
.lead-h em{font-style:normal;display:block;}
.lead-shot{position:relative;padding-bottom:clamp(26px,3.4vw,46px);}
.lead-shot .main{width:78%;aspect-ratio:4/3;object-fit:cover;}
.lead-shot .sub{position:absolute;right:0;bottom:0;width:44%;aspect-ratio:4/3;object-fit:cover;
  border:5px solid var(--navy);box-shadow:0 18px 44px -22px rgba(0,0,0,.9);}
@media(max-width:760px){
  .lead-shot{padding-bottom:0;}
  .lead-shot .main{width:100%;aspect-ratio:16/10;}
  .lead-shot .sub{position:static;width:62%;margin:10px 0 0 auto;border:none;box-shadow:none;}
}
.hero-meta{margin-top:20px;display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--body);font-weight:500;font-size:11.5px;
  letter-spacing:.14em;text-transform:uppercase;color:var(--w-d);}
.hero-meta b{color:var(--gold);font-weight:600;}

/* ---------- interior band（内観） ---------- */
@media(max-width:760px){
      }


/* ---------- 内観スライドショー ---------- */
.slider{position:relative;width:100%;overflow:hidden;background:var(--navy-3);}
.slides{position:relative;width:100%;aspect-ratio:16/9;}
.slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;
  transition:opacity 1.1s cubic-bezier(.4,0,.2,1);}
.slides img.on{opacity:1;}
.s-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:46px;height:46px;border-radius:50%;
  border:1px solid rgba(242,240,236,.4);background:rgba(6,5,4,.45);backdrop-filter:blur(6px);
  color:var(--w);display:grid;place-items:center;cursor:pointer;transition:background .3s,border-color .3s;}
.s-nav svg{width:18px;height:18px;}
.s-nav:hover{background:var(--shu-l);border-color:var(--shu-l);}
.s-nav.prev{left:14px;} .s-nav.next{right:14px;}
@media(max-width:600px){.s-nav{width:38px;height:38px;} .s-nav.prev{left:8px;} .s-nav.next{right:8px;}}
.s-dots{position:absolute;left:0;right:0;bottom:14px;z-index:3;display:flex;justify-content:center;gap:8px;}
.s-dots button{width:28px;height:2px;border:none;padding:0;cursor:pointer;background:rgba(242,240,236,.35);transition:background .3s,width .3s;}
.s-dots button.on{background:var(--gold);width:44px;}

/* ---------- パフォーマンス ---------- */
.reels{display:grid;gap:clamp(16px,2.6vw,30px);margin-top:clamp(28px,4vw,46px);}
@media(min-width:700px){.reels{grid-template-columns:repeat(2,1fr);max-width:840px;}}
.reel{position:relative;overflow:hidden;background:#000;border:1px solid var(--line);}
.reel video{width:100%;aspect-ratio:9/16;object-fit:cover;display:block;}
.reel::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(6,5,4,.28) 0%,rgba(6,5,4,0) 22%,rgba(6,5,4,0) 74%,rgba(6,5,4,.62) 100%);}
.reel-cap{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:18px 20px;}
.reel-cap b{display:block;font-family:var(--disp);font-weight:500;font-size:clamp(15px,1.9vw,19px);line-height:1.35;color:#fff;}
.reel-cap span{display:block;margin-top:5px;font-family:var(--body);font-weight:500;font-size:11px;
  letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.72);}

/* ---------- Google レビュー ---------- */
.gcard{max-width:520px;margin:clamp(28px,4.5vw,48px) auto 0;background:rgba(242,240,236,.04);
  border:1px solid rgba(242,240,236,.16);border-radius:12px;padding:clamp(26px,4vw,38px) clamp(22px,3.4vw,34px);text-align:center;}
.gword{font-family:var(--body);font-weight:500;font-size:clamp(22px,3vw,28px);letter-spacing:-.01em;line-height:1;}
.gword i{font-style:normal;}
.g1{color:#4285F4}.g2{color:#EA4335}.g3{color:#FBBC05}.g4{color:#4285F4}.g5{color:#34A853}.g6{color:#EA4335}
.g-sub{font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--w-d);margin-top:8px;}
.g-row{display:flex;align-items:center;justify-content:center;gap:clamp(14px,2.4vw,22px);margin-top:20px;}
.g-num{font-family:var(--disp);font-weight:500;font-size:clamp(50px,8vw,74px);line-height:.88;letter-spacing:-.03em;}
.g-right{text-align:left;}
.g-stars{display:flex;gap:3px;}
.g-stars svg{width:20px;height:20px;fill:#FBBC05;}
.g-out{font-family:var(--body);font-size:12.5px;color:var(--w-d);margin-top:5px;letter-spacing:.04em;}
.g-count{margin-top:16px;padding-top:16px;border-top:1px solid rgba(242,240,236,.14);
  font-family:var(--disp);font-size:clamp(17px,2.2vw,22px);}
.g-count small{display:block;font-family:var(--body);font-weight:500;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--w-d);margin-top:5px;}
.g-link{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-family:var(--body);font-weight:500;font-size:13px;
  letter-spacing:.08em;color:var(--gold);border-bottom:1px solid rgba(201,169,110,.45);padding-bottom:2px;}


/* ---------- 常時表示のフローティングCTA（既存デザイン踏襲） ---------- */
.fab{position:fixed;right:clamp(12px,2vw,24px);bottom:clamp(12px,2vw,24px);z-index:78;
  display:flex;flex-direction:column;align-items:flex-start;gap:2px;
  background:var(--gold,#c9a96e);color:#0b0908;border:none;cursor:pointer;text-decoration:none;
  font-family:var(--body);border-radius:14px;padding:11px 18px;overflow:hidden;
  box-shadow:0 10px 30px rgba(0,0,0,.45),0 0 0 1px rgba(201,169,110,.45);
  transition:transform .2s ease,box-shadow .2s ease,background .2s;}

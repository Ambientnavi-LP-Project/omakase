---
pagination:
  data: stores.pagesTestB
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% if store.theme == "wagyu" %}
{% set IMG = {
  lead:    "/images/sukiyaki.jpg",
  concept: "/images/course-kobe-premium.jpg",
  band:    "/images/cat-wagyu.jpg",
  col_a:   "/images/course-wagyu-standard.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/chef3.jpg"
} %}
{% else %}
{% set IMG = {
  lead:    "/images/sushi1.jpg",
  concept: "/images/sushi2.jpg",
  band:    "/images/cat-sushi.jpg",
  col_a:   "/images/course-sushi-premium.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/sushi4.jpg"
} %}
{% endif %}
{% set TCATS = courses.themes[store.theme] or courses.themes.all %}
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro circ() %}<span class="circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endmacro %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Sushi &amp; Wagyu Halal Omakase Experience — {{ store.name_full_en }}"/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-b',theme:'{{ store.theme }}'});</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
:root{
  --paper:#f4efe5; --paper-2:#fffdf9; --paper-3:#eae2d4;
  --sumi:#191512; --sumi-2:#5b5148; --sumi-3:#8d8177;
  --shu:#a8342a; --shu-d:#8b2820; --shu-l:#c9463a; --brass:#96793f;
  --line:rgba(25,21,18,.13);
  --disp:'Zen Old Mincho',serif; --body:'Jost',sans-serif;
  --gut:clamp(24px,6vw,72px);
  --rv-bg:var(--paper-2); --rv-panel:var(--paper); --rv-line:var(--line);
  --rv-text:var(--sumi); --rv-muted:var(--sumi-3); --rv-accent:var(--shu);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:6px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--sumi);font-family:var(--body);line-height:1.8;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;padding-bottom:78px;}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--shu);outline-offset:2px;}

.wrap{width:100%;max-width:1120px;margin-inline:auto;padding-inline:var(--gut);}
.narrow{width:100%;max-width:740px;margin-inline:auto;padding-inline:var(--gut);}
.pad{padding:clamp(52px,8vw,96px) 0;}
.center{text-align:center;}

.eyebrow{display:inline-block;font-family:var(--body);font-size:10px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:var(--shu);}
h2.sh{font-family:var(--disp);font-weight:600;font-size:clamp(22px,3.4vw,34px);line-height:1.42;margin-top:12px;}
.lead{font-size:14.5px;line-height:2;color:var(--sumi-2);margin-top:14px;}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
html.no-js .reveal{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}


/* ---------- strip / header ---------- */
.strip{background:var(--sumi);color:var(--paper);font-size:11px;letter-spacing:.05em;text-align:center;padding:8px 16px;line-height:1.55;}
.strip b{color:#e7c98c;font-weight:500;}
.hd{position:sticky;top:0;z-index:70;background:rgba(244,239,229,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;}
.mark b{display:block;font-family:var(--disp);font-weight:600;font-size:15px;letter-spacing:.04em;}
.mark i{font-style:normal;font-size:8.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--sumi-3);}
.hd-r{display:flex;align-items:center;gap:9px;}
.hd-cta{background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);font-weight:600;
  font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:11px 16px;border-radius:4px;}
@media(max-width:620px){.hd-cta{display:none;}}
.burger{width:34px;height:34px;background:none;border:none;cursor:pointer;display:flex;flex-direction:column;justify-content:center;gap:5px;}
.burger span{display:block;height:1.5px;background:var(--sumi);transition:transform .35s,width .35s;}
.burger span:nth-child(1){width:22px;} .burger span:nth-child(2){width:14px;margin-left:auto;}

.langbtn{display:flex;align-items:center;gap:7px;background:var(--paper-2);border:1px solid var(--line);border-radius:4px;
  cursor:pointer;color:var(--sumi-2);font-family:var(--body);font-size:12.5px;font-weight:500;padding:10px 13px;transition:border-color .3s;}
.langbtn:hover{border-color:var(--sumi-3);}
.langbtn svg{width:15px;height:15px;flex-shrink:0;color:var(--shu);}
@media(max-width:560px){.langbtn span{display:none;} .langbtn{padding:10px 11px;}}
.sheet{position:fixed;inset:0;z-index:96;display:none;place-items:center;padding:20px;background:rgba(25,21,18,.5);}
.sheet.open{display:grid;}
.sheet-in{background:var(--paper-2);border-radius:8px;width:100%;max-width:400px;padding:26px;
  box-shadow:0 30px 70px -20px rgba(25,21,18,.45);animation:sheetUp .34s cubic-bezier(.16,1,.3,1) both;}
@keyframes sheetUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
@media(prefers-reduced-motion:reduce){.sheet-in{animation:none;}}
.sheet-in h4{font-family:var(--disp);font-weight:600;font-size:19px;}
.sheet-in p{font-size:12.5px;line-height:1.8;color:var(--sumi-3);margin:5px 0 16px;}
.sheet-list{display:grid;gap:3px;}
.sheet-list button{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;background:none;border:none;
  border-radius:6px;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--sumi);text-align:left;padding:12px 13px;transition:background .25s;}
.sheet-list button:hover{background:var(--paper-3);}
.sheet-list button[aria-current="true"]{background:rgba(168,52,42,.09);color:var(--shu);font-weight:600;}
.sheet-list .code{font-size:11px;letter-spacing:.12em;color:var(--sumi-3);}
.burger{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;width:44px;padding:2px 0;}
.burger .bl{width:28px;height:1.5px;background:var(--sumi);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.burger .btx{font-size:9px;font-weight:600;letter-spacing:.14em;color:var(--sumi);line-height:1;}
.nav-open .burger .bl:nth-child(1){transform:translateY(4px) rotate(45deg);}
.nav-open .burger .bl:nth-child(2){transform:translateY(-2.5px) rotate(-45deg);}

/* circle chevron button */
.cbtn{display:inline-flex;align-items:center;gap:16px;background:none;border:none;cursor:pointer;color:var(--sumi);font-family:var(--body);padding:0;}
.cbtn .circ{position:relative;flex-shrink:0;width:clamp(46px,5vw,60px);height:clamp(46px,5vw,60px);border-radius:50%;
  border:1px solid rgba(25,21,18,.3);display:grid;place-items:center;overflow:hidden;transition:border-color .4s,color .4s;}
.cbtn .circ::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--shu);transform:scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.cbtn .circ svg{position:relative;z-index:1;width:18px;height:18px;transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cbtn:hover .circ{border-color:var(--shu);color:#fff;}
.cbtn:hover .circ::before{transform:scale(1);}
.cbtn:hover .circ svg{transform:translateX(3px);}
.cbtn .lbl{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;}
.final .cbtn,.final .cbtn .circ{color:var(--paper);}
.final .cbtn .circ{border-color:rgba(244,239,229,.4);}

/* ---------- overlay menu ---------- */
.ovl{position:fixed;inset:0;z-index:90;background:rgba(25,21,18,.97);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s;}
.ovl.open{opacity:1;visibility:visible;}
.ovl-in{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);}
.ovl a{display:block;width:max-content;font-family:var(--disp);font-weight:600;font-size:clamp(26px,5vw,54px);
  line-height:1.5;color:var(--paper);opacity:0;transform:translateY(16px);
  transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1),color .3s;}
.ovl.open a{opacity:1;transform:none;}
.ovl.open a:nth-child(1){transition-delay:.10s;} .ovl.open a:nth-child(2){transition-delay:.16s;}
.ovl.open a:nth-child(3){transition-delay:.22s;} .ovl.open a:nth-child(4){transition-delay:.28s;}
.ovl.open a:nth-child(5){transition-delay:.34s;} .ovl.open a:nth-child(6){transition-delay:.40s;}
.ovl a:hover{color:var(--shu-l);}
.ovl-foot{position:absolute;left:0;right:0;bottom:clamp(24px,5vw,52px);}
.ovl-foot p{font-size:12.5px;line-height:1.9;color:rgba(244,239,229,.5);}
.ovl-foot a{color:#e7c98c;}

/* ---------- interior band ---------- */
.band-photo{position:relative;width:100%;}
.band-photo img{width:100%;aspect-ratio:21/9;object-fit:cover;}
@media(max-width:760px){.band-photo img{aspect-ratio:4/3;}}
.band-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(25,21,18,.1) 0%,rgba(25,21,18,.55) 60%,rgba(25,21,18,.82) 100%);}
@media(max-width:760px){.band-photo::after{background:linear-gradient(180deg,rgba(25,21,18,.15) 0%,rgba(25,21,18,.8) 100%);}}
.band-txt{position:absolute;right:0;top:50%;transform:translateY(-50%);z-index:2;width:100%;color:var(--paper);}
.band-txt .in{max-width:500px;margin-left:auto;}
.band-txt .lead{color:rgba(244,239,229,.78);}
.band-txt h2{color:var(--paper);}
.collage{display:grid;gap:clamp(20px,3vw,40px);align-items:center;}
@media(min-width:1000px){.collage{grid-template-columns:.9fr 1.1fr;}}
.collage-imgs{position:relative;}
.collage-imgs .a{width:100%;aspect-ratio:16/10;object-fit:cover;}
.collage-imgs .b{position:absolute;right:calc(var(--gut) * -0.5);bottom:-30px;width:44%;aspect-ratio:4/3;object-fit:cover;border:6px solid var(--paper);}
@media(max-width:760px){.collage-imgs .b{position:static;width:70%;margin:12px 0 0 auto;border:none;}}

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;}
@media(min-width:1000px){.hero-media{max-height:72vh;}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-body{padding-top:26px;padding-bottom:8px;}
.hero-h{font-family:var(--disp);font-weight:700;font-size:clamp(25px,5vw,42px);line-height:1.34;}
.hero-h em{font-style:normal;color:var(--shu);}
.hero-p{margin-top:12px;font-size:14.5px;line-height:1.95;color:var(--sumi-2);}
.hero-name{margin-top:20px;padding-top:18px;border-top:1px solid var(--line);
  font-family:var(--disp);font-weight:600;font-size:clamp(15px,2.2vw,20px);line-height:1.5;color:var(--shu);}
.trust{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--paper-2);
  border-radius:100px;padding:7px 13px;font-size:11.5px;font-weight:500;color:var(--sumi-2);}
.chip b{color:var(--shu);font-weight:600;}

.cta-lg{display:inline-flex;flex-direction:column;align-items:center;gap:2px;width:100%;max-width:420px;
  background:var(--shu);color:#fff;border:none;cursor:pointer;padding:17px 22px;border-radius:6px;
  font-family:var(--body);box-shadow:0 4px 0 var(--shu-d);transition:transform .12s,box-shadow .12s,background .2s;}
.cta-lg:hover{background:var(--shu-l);}
.cta-lg:active{transform:translateY(3px);box-shadow:0 1px 0 var(--shu-d);}
.cta-lg strong{font-size:15px;font-weight:600;letter-spacing:.06em;}
.cta-lg span{font-size:10.5px;opacity:.85;}
.cta-sub{margin-top:10px;font-size:11.5px;color:var(--sumi-3);}

/* ---------- cards ---------- */
.grid3{display:grid;gap:14px;}
@media(min-width:820px){.grid3{grid-template-columns:repeat(3,1fr);}}
.card{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:24px 22px;}
.card h3{font-family:var(--disp);font-weight:600;font-size:16.5px;line-height:1.5;margin:0 0 9px;}
.card p{font-size:13px;line-height:1.95;color:var(--sumi-2);}

/* ---------- courses ---------- */
.pick{display:grid;gap:16px;}
@media(min-width:700px){.pick{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));align-items:start;max-width:840px;margin-inline:auto;}}
.pc{position:relative;background:var(--paper-2);border:1px solid var(--line);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;}
.pc.best{border:2px solid var(--shu);box-shadow:0 8px 30px rgba(168,52,42,.13);}
.pc-flag{position:absolute;right:0;top:0;z-index:2;background:var(--shu);color:#fff;font-size:10px;font-weight:600;
  letter-spacing:.14em;text-transform:uppercase;padding:6px 12px;border-radius:0 0 0 6px;}
.pc-img{aspect-ratio:16/10;overflow:hidden;background:var(--paper-3);}
.pc-img img{width:100%;height:100%;object-fit:cover;}
.pc-in{padding:20px 20px 22px;display:flex;flex-direction:column;flex:1;}
.pc-cat{font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--brass);}
.pc-name{font-family:var(--disp);font-weight:600;font-size:18px;line-height:1.45;margin-top:7px;}
.pc-price{margin-top:11px;font-family:var(--disp);font-size:26px;font-weight:600;color:var(--shu);line-height:1;}
.pc-price small{font-family:var(--body);font-size:11px;font-weight:400;color:var(--sumi-3);margin-left:6px;}
.pc-lead{margin-top:11px;font-size:12.8px;line-height:1.9;color:var(--sumi-2);}
.pc-list{margin-top:13px;border-top:1px solid var(--line);padding-top:11px;flex:1;}
.pc-list li{list-style:none;display:flex;gap:8px;font-size:12.2px;line-height:1.7;color:var(--sumi-2);padding:3px 0;}
.pc-list li::before{content:'\2014';color:var(--shu);flex-shrink:0;}
.pc-btn{margin-top:16px;width:100%;background:var(--sumi);color:var(--paper);border:none;cursor:pointer;
  font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:15px;border-radius:5px;transition:background .2s;}
.pc-btn:hover{background:#000;}
.pc.best .pc-btn{background:var(--shu);box-shadow:0 3px 0 var(--shu-d);}
.pc.best .pc-btn:hover{background:var(--shu-l);}

.tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:26px;}
table.cmp{width:100%;min-width:420px;max-width:840px;margin-inline:auto;border-collapse:collapse;background:var(--paper-2);border:1px solid var(--line);font-size:12.6px;}
table.cmp th,table.cmp td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;}
table.cmp thead th{background:var(--paper-3);font-family:var(--disp);font-weight:600;font-size:13px;}
table.cmp tbody th{font-weight:500;color:var(--sumi-3);font-size:11px;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;width:1%;}
table.cmp .hi{color:var(--shu);font-weight:600;}

/* ---------- reviews ---------- */
.rev-wrap{display:grid;gap:14px;margin-top:26px;}
@media(min-width:820px){.rev-wrap{grid-template-columns:repeat(2,1fr);}}
.rev{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:22px 21px;}
.stars{color:#d99b20;font-size:14px;letter-spacing:2px;}
.rev-src{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--sumi-3);margin-left:8px;}
.rev p{font-family:var(--disp);font-size:14.5px;line-height:1.95;margin:12px 0 14px;}
.rev cite{font-style:normal;font-size:11.5px;color:var(--sumi-3);}
.score{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:clamp(18px,4vw,42px);
  margin-top:clamp(26px,4vw,44px);padding:clamp(26px,4vw,40px) clamp(20px,3vw,34px);
  background:var(--paper-2);border:1px solid var(--line);border-radius:8px;}
.score-n{font-family:var(--disp);font-weight:600;font-size:clamp(56px,10vw,98px);line-height:.9;color:var(--shu);letter-spacing:-.02em;}
.score-r{display:flex;flex-direction:column;gap:7px;}
.score-stars{color:#d99b20;font-size:clamp(17px,2.2vw,22px);letter-spacing:4px;line-height:1;}
.score-src{font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--sumi-2);}
.score-count{font-family:var(--disp);font-weight:600;font-size:clamp(19px,2.6vw,26px);line-height:1.2;color:var(--sumi);}
.score-count small{display:block;font-family:var(--body);font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--sumi-3);margin-top:5px;}

/* ---------- faq / access ---------- */
.faq{border-top:1px solid var(--line);margin-top:24px;}
.faq details{border-bottom:1px solid var(--line);}
.faq summary{cursor:pointer;list-style:none;padding:17px 32px 17px 0;position:relative;font-family:var(--disp);font-weight:600;font-size:15px;line-height:1.6;}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:'+';position:absolute;right:4px;top:15px;color:var(--shu);font-size:20px;font-weight:400;}
.faq details[open] summary::after{content:'\2212';}
.faq p{padding:0 0 19px;font-size:13px;line-height:1.95;color:var(--sumi-2);}
.acc{display:grid;gap:22px;margin-top:24px;}
@media(min-width:860px){.acc{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:104px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid var(--line);}
@media(max-width:520px){.dl div{grid-template-columns:1fr;gap:4px;}}
.dl dt{font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--sumi-3);padding-top:4px;}
.dl dd{font-size:13.4px;line-height:1.8;}
.dl dd a{color:var(--shu);border-bottom:1px solid rgba(168,52,42,.3);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- final / footer ---------- */
.final{background:var(--sumi);color:var(--paper);}
.final h2,.final .sh{color:var(--paper);}
.final .lead{color:rgba(244,239,229,.72);}
.final .cta-sub{color:rgba(244,239,229,.55);}
footer{background:var(--sumi);color:rgba(244,239,229,.55);padding:clamp(52px,8vw,104px) 0 clamp(28px,4vw,48px);font-size:12.5px;}
.ft-grid{display:grid;gap:clamp(32px,5vw,58px);}
@media(min-width:820px){.ft-grid{grid-template-columns:1.4fr 1fr;}}
.ft-small{font-size:12px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,239,229,.5);}
.ft-name{font-family:var(--disp);font-weight:600;font-size:clamp(22px,3.4vw,38px);line-height:1.22;color:var(--paper);margin-top:4px;}
.ft-addr{margin-top:20px;line-height:2;color:rgba(244,239,229,.5);}
.ft-addr a{color:#e7c98c;}
.ft-nav{display:grid;gap:2px;}
@media(min-width:820px){.ft-nav{justify-items:start;margin-left:auto;}}
.ft-nav a{font-family:var(--disp);font-weight:600;font-size:clamp(15px,1.8vw,19px);letter-spacing:.05em;padding:9px 0;color:rgba(244,239,229,.75);transition:color .3s;}
.ft-nav a:hover{color:#fff;}
.ft-bar{margin-top:clamp(34px,5vw,60px);padding-top:20px;border-top:1px solid rgba(244,239,229,.14);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-size:10px;letter-spacing:.14em;color:rgba(244,239,229,.32);}

/* ---------- sticky ---------- */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:75;background:rgba(25,21,18,.96);backdrop-filter:blur(12px);
  border-top:1px solid rgba(244,239,229,.16);display:flex;align-items:center;gap:12px;padding:10px var(--gut);
  transform:translateY(110%);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.sticky.show{transform:none;}
.sticky-t{flex:1;min-width:0;color:var(--paper);line-height:1.35;}
.sticky-t b{display:block;font-size:12px;font-weight:600;}
.sticky-t span{display:block;font-size:10px;color:rgba(244,239,229,.6);}
.sticky-b{flex-shrink:0;background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);font-weight:600;
  font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:14px 20px;border-radius:5px;box-shadow:0 3px 0 var(--shu-d);}
.sticky-b:active{transform:translateY(2px);box-shadow:0 1px 0 var(--shu-d);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="strip"><span data-i18n="strip.line"><b>Reservations recommended 2 weeks in advance.</b> Walk-ins welcome subject to availability.</span></div>

<header class="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top"><b>Omakase</b><i>Wagyu &amp; Sushi</i></a>
    <div class="hd-r">
      <button class="langbtn" id="langOpen" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.5 2.6 2.5 15 0 17.2M12 3.4c-2.5 2.6-2.5 15 0 17.2"/></svg>
        <span id="langNow">English</span>
      </button>
      <button class="hd-cta" onclick="openReserve('header')" data-i18n="nav.reserve">Reserve</button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span class="bl"></span><span class="bl"></span><span class="btx" id="btx">MENU</span></button>
    </div>
  </div>
</header>

<div class="sheet" id="langSheet" role="dialog" aria-modal="true" aria-label="Language">
  <div class="sheet-in">
    <h4 data-i18n="lang.h">Language</h4>
    <p data-i18n="lang.p">The menu and information are the same in every language.</p>
    <div class="sheet-list" id="langList"></div>
  </div>
</div>

<div class="ovl" id="ovl">
  <div class="ovl-in wrap">
    <nav>
      <a href="#courses" data-nav data-i18n="nav.menu">Menu</a>
      <a href="#interior" data-nav data-i18n="nav.interior">Interior</a>
      <a href="#voices" data-nav data-i18n="voices.label">Guest Voices</a>
      <a href="#halal" data-nav data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#faq" data-nav>FAQ</a>
      <a href="#access" data-nav data-i18n="nav.access">Access</a>
    </nav>
  </div>
  <div class="ovl-foot wrap">
    <p>{{ store.name_full_en }}<br/>{{ store.address_en_line1 }}{% if store.tel_display != 'TBD' %} &middot; <a href="tel:{{ store.tel_raw }}">{{ store.tel_display }}</a>{% endif %}</p>
  </div>
</div>

<!-- ================= HERO ================= -->
<section id="top">
  <div class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/top.jpg"><source src="/images/hero1.mp4" type="video/mp4"/></video>
  </div>
  <div class="wrap hero-body">
    <p class="eyebrow" data-i18n="hero.tour">Gastronomic Tour of Japan</p>
    <h1 class="hero-h"><em data-i18n="theme.{{ store.theme }}">{{ store.theme | capitalize }}</em> <span data-i18n="hero.halal">Halal Omakase Experience</span></h1>
    <p class="hero-p" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
    <p class="hero-name">{{ store.name_full_en }}</p>
    <div class="trust">
      <span class="chip"><b>&#9733; {{ store.rating }}</b> Google &middot; {{ store.rating_count }} <span data-i18n="ui.reviews">reviews</span></span>
      <span class="chip" data-i18n="badge.mf">Muslim-friendly</span>
      <span class="chip" data-i18n="badge.nopork">No pork</span>
      <span class="chip" data-i18n="badge.noalc">No alcohol in food</span>
    </div>
    <div style="margin-top:22px;">
      <button class="cta-lg" onclick="openReserve('hero')" data-ga-event="reserve_click" data-ga-location="hero">
        <strong data-i18n="{% if store.reserve_system == 'form' %}reserve.btn{{ store.theme | capitalize }}{% else %}reserve.btnTc{% endif %}">{% if store.reserve_system == 'form' %}Reserve Your Omakase{% else %}Reserve on TableCheck{% endif %}</strong>
        <span data-i18n="menu.note">All Muslim-friendly &middot; Seasonal menu</span>
      </button>
      <p class="cta-sub" data-i18n="{% if store.reserve_system == 'form' %}reserve.noteForm{% else %}reserve.noteTc{% endif %}">{% if store.reserve_system == 'form' %}* Reservation is confirmed after email from {{ stores.brand.brand_name }}.{% else %}* Reservation handled by TableCheck — secure &amp; instant.{% endif %}</p>
    </div>
  </div>
</section>

<!-- ================= EXPERIENCE ================= -->
<section class="pad">
  <div class="wrap">
    <div class="center reveal" style="max-width:660px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="exp.label">The Experience</span>
      {% if store.projection_mapping %}
      <h2 class="sh" data-i18n="exp.pm.h">Sushi &amp; Wagyu Course &times; Projection Mapping</h2>
      <p class="lead" data-i18n="exp.pm.p">Not just a meal — a journey through Japan.</p>
      {% else %}
      <h2 class="sh" data-i18n="exp.h">A Journey Through Japan</h2>
      <p class="lead" data-i18n="exp.p">A journey through Japan's food culture — wagyu, sushi, and projection-mapped dining. Muslim-friendly omakase, crafted for travelers from around the world.</p>
      {% endif %}
    </div>
    <div class="grid3 reveal" style="margin-top:30px;">
      <div class="card">
        <h3 data-i18n="story.q.label">Our Commitment to Quality</h3>
        <p data-i18n="story.q.p">I visit livestock farms all over Japan and purchase only Wagyu that I truly accept by the whole head.</p>
      </div>
      <div class="card">
        <h3 data-i18n="halal.label">Muslim-Friendly Dining</h3>
        <p data-i18n="halal.p1">We thoughtfully prepare pork-free, alcohol-free dishes.</p>
      </div>
      <div class="card">
        <h3 data-i18n="story.w.label">For Everyone in the World</h3>
        <p data-i18n="story.w.p">This restaurant was born to share authentic Japanese food culture with everyone.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= INTERIOR ================= -->
<section id="interior">
  <div class="band-photo reveal">
    <img src="{{ IMG.band }}" alt="" loading="lazy"/>
    <div class="band-txt"><div class="wrap"><div class="in">
      <span class="eyebrow" data-i18n="nav.interior">Interior</span>
      <h2 class="sh" data-i18n="menu.premiumH">&ldquo;Sushi &amp; Wagyu Indulgence&rdquo;</h2>
      <p class="lead" data-i18n="menu.premiumP">Within our signature courses, you'll also find premium dishes — crafted with the finest seasonal ingredients for an extraordinary experience.</p>
    </div></div></div>
  </div>
  <div class="wrap pad">
    <div class="collage reveal">
      <div>
        <span class="eyebrow" data-i18n="exp.label">The Experience</span>
        <h3 class="sh" style="font-size:clamp(20px,2.8vw,30px);" data-i18n="exp.h">A Journey Through Japan</h3>
        <p class="lead" data-i18n="exp.p">A journey through Japan's food culture — wagyu, sushi, and projection-mapped dining. Muslim-friendly omakase, crafted for travelers from around the world.</p>
        <div style="margin-top:22px;"><a class="cbtn" href="#courses">{{ circ() }}<span class="lbl" data-i18n="nav.menu">Menu</span></a></div>
      </div>
      <div class="collage-imgs">
        <img class="a" src="{{ IMG.col_a }}" alt="" loading="lazy"/>
        <img class="b" src="{{ IMG.col_b }}" alt="" loading="lazy"/>
      </div>
    </div>
  </div>
</section>

<!-- ================= COURSES ================= -->
<section class="pad" style="background:var(--paper-3);" id="courses">
  <div class="wrap">
    <div class="center reveal" style="max-width:660px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="menu.chefs">Chef&rsquo;s Omakase</span>
      <h2 class="sh" data-i18n="menu.{{ store.theme }}H">Omakase Course</h2>
      <p class="lead" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
    </div>

    {% if store.theme == "wagyu" %}
    {% set FEATURED = ["wagyu-standard","kobe-premium"] %}
    {% else %}
    {% set FEATURED = ["sushi-standard","sushi-premium"] %}
    {% endif %}
    <div class="pick reveal" style="margin-top:30px;">
      {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}
      {% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}
      <div class="pc{% if loop.index0 == 1 %} best{% endif %}">
        {% if c.web_only %}<span class="pc-flag" data-i18n="tag.web">Web exclusive</span>{% endif %}
        {% if c.premium %}<span class="pc-flag" data-i18n="tag.recommended">Recommended</span>{% endif %}
        <div class="pc-img"><img src="{{ c.img }}" alt="" loading="lazy"/></div>
        <div class="pc-in">
          <span class="pc-cat" data-i18n="cat.{{ c.cat }}.label">{% for cc in courses.cats %}{% if cc.key == c.cat %}{{ cc.label.en }}{% endif %}{% endfor %}</span>
          <h3 class="pc-name" data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</h3>
          {% if showPrice %}<p class="pc-price">&yen;{{ yen(p) }}<small>&yen;{{ yen((p * 1.1) | round(0,"floor") | int) }} <span data-i18n="course.incl">incl. tax</span></small></p>{% endif %}
          <p class="pc-lead" data-i18n="course.{{ c.id }}.lead">{{ c.lead.en }}</p>
          <ul class="pc-list">
            {% for r in c.rows %}{% if loop.index0 == 2 or loop.index0 == 3 or loop.index0 == 4 %}<li>{{ r }}</li>{% endif %}{% endfor %}
          </ul>
          <button class="pc-btn" onclick="openReserve('course_{{ c.id }}','{{ c.id }}')" data-i18n="course.reserve">Reserve this course</button>
        </div>
      </div>
      {% endif %}{% endfor %}{% endfor %}
    </div>

    <div class="tbl-scroll reveal" id="cmp">
      <table class="cmp">
        <thead><tr><th></th>
          {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}<th data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</th>{% endif %}{% endfor %}{% endfor %}
        </tr></thead>
        <tbody>
          {% if store.theme == "wagyu" %}
          <tr><th data-i18n="cmp.beef">Beef</th><td>Wagyu</td><td class="hi">Kobe Beef</td></tr>
          <tr><th data-i18n="cmp.steak">Fillet steak</th><td>100g</td><td class="hi">100g</td></tr>
          <tr><th data-i18n="cmp.sukiyaki">Sukiyaki</th><td>Wagyu</td><td class="hi">Kobe Beef</td></tr>
          <tr><th data-i18n="cmp.spring">Spring roll</th><td>Wagyu</td><td class="hi">Kobe Beef</td></tr>
          <tr><th data-i18n="cmp.nikuzushi">Nikuzushi</th><td>Wagyu 20g</td><td class="hi">Kobe Beef 20g</td></tr>
          {% else %}
          <tr><th data-i18n="cmp.nigiri">Nigiri</th><td>10</td><td>10</td></tr>
          <tr><th data-i18n="cmp.roll">Hand roll</th><td>Salmon &amp; Ikura</td><td class="hi">Sea Urchin &middot; Salmon &amp; Ikura</td></tr>
          <tr><th data-i18n="cmp.extra">Sea urchin &amp; crab</th><td>&mdash;</td><td class="hi">&#10003;</td></tr>
          <tr><th data-i18n="cmp.chawan">Chawanmushi</th><td>Shrimp</td><td class="hi">Snow Crab</td></tr>
          {% endif %}
          {% if showPrice %}
          <tr><th data-i18n="cmp.price">Price</th>
            {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}{% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}<td>&yen;{{ yen(p) }}</td>{% endif %}{% endfor %}{% endfor %}
          </tr>{% endif %}
        </tbody>
      </table>
    </div>

    <div class="center reveal">
      <p class="lead" style="font-size:12.5px;" data-i18n="menu.season">* Ingredients may vary depending on the season.</p>
      <a class="cbtn" href="#faq" style="margin-top:8px;">{{ circ() }}<span class="lbl" data-i18n="ui.viewMore">View more</span></a>
    </div>
  </div>
</section>

<!-- ================= VOICES ================= -->
<section class="pad" id="voices">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="voices.label">Guest Voices</span>
      <h2 class="sh" data-i18n="voices.h">From Around the World</h2>
      <p class="lead" data-i18n="voices.p">A selection of impressions shared by our guests.</p>
    </div>
    <div class="rev-wrap reveal">
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p>Beautifully presented Wagyu, thoughtfully served. The Muslim-friendly menu meant my family from Dubai could fully enjoy the experience. Truly felt at home.</p><cite>Dubai, UAE</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p>The course was theatrical — watching the chef carve the wagyu felt like a performance. The quality of the beef is on another level. Worth every yen.</p><cite>New York, USA</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p>真正的日本和牛體驗，完全不同於香港吃到的。低溫慢煮帶出的甘甜讓人難忘。師傅對每一片肉的態度就像對藝術品一樣。</p><cite>Hong Kong</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p>As a Muslim food lover, finding an authentic Muslim-friendly omakase in Japan was a dream. The attention to dietary detail and respect for our needs really showed. The wagyu itself was sublime.</p><cite>Kuala Lumpur</cite></div>
    </div>
    <div class="score reveal">
      <span class="score-n">{{ store.rating }}</span>
      <span class="score-r">
        <span class="score-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="score-src">Google</span>
      </span>
      <span class="score-count">{{ store.rating_count }}<small data-i18n="ui.reviews">reviews</small></span>
    </div>
  </div>
</section>

<!-- ================= MUSLIM-FRIENDLY ================= -->
<section class="pad" style="background:var(--paper-3);" id="halal">
  <div class="narrow center reveal">
    <span class="eyebrow" data-i18n="halal.label">Muslim-Friendly Dining</span>
    <h2 class="sh" data-i18n="halal.h">A Muslim-Friendly Dining Experience in {{ store.city.split(',')[0] }}</h2>
    <p class="lead" data-i18n="halal.p1">Welcome to our restaurant — a warm, inclusive space where guests from all cultures can dine with peace of mind.</p>
    <p class="lead" data-i18n="halal.p2">Please feel free to share any dietary preferences or restrictions when making your reservation — we will do our best to accommodate.</p>
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:20px;">
      <span class="chip" data-i18n="badge.nopork">No pork</span>
      <span class="chip" data-i18n="badge.noalc">No alcohol in food</span>
      <span class="chip" data-i18n="badge.mf">Muslim-friendly</span>
    </div>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section class="pad" id="faq">
  <div class="narrow">
    <div class="center reveal">
      <span class="eyebrow">FAQ</span>
      <h2 class="sh" data-i18n="faq.h">Before you reserve</h2>
    </div>
    <div class="faq reveal">
      <details><summary data-i18n="faq.q1">Is the food Muslim-friendly?</summary><p data-i18n="halal.p1">We thoughtfully prepare pork-free, alcohol-free dishes.</p></details>
      <details><summary data-i18n="faq.q2">Can you accommodate dietary restrictions?</summary><p data-i18n="halal.p2">Please feel free to share any dietary preferences or restrictions when making your reservation.</p></details>
      <details><summary data-i18n="faq.q3">How far in advance should I book?</summary><p data-i18n="reserve.p">Reservations recommended 2 weeks in advance. Walk-ins welcome subject to availability.</p></details>
      <details><summary data-i18n="faq.q4">What is the cancellation policy?</summary><p><span data-i18n="rv.cx48">Within 48 hours: &yen;5,000 / person</span><br/><span data-i18n="rv.cx24">Within 24 hours: &yen;10,000 / person</span></p></details>
      <details><summary data-i18n="faq.q5">Do the courses change?</summary><p data-i18n="menu.season">* Ingredients may vary depending on the season.</p></details>
    </div>
  </div>
</section>

<!-- ================= ACCESS ================= -->
<section class="pad" style="background:var(--paper-3);" id="access">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="access.label">Access</span>
      <h2 class="sh" data-i18n="access.h">Find Us</h2>
    </div>
    <div class="acc reveal">
      <div>
        <dl class="dl">
          <div><dt data-i18n="access.name">Restaurant</dt><dd>{{ store.name_full_en }}</dd></div>
          <div><dt data-i18n="access.addr">Address</dt><dd>&#12306;{{ store.address_postal }}<br/>{{ store.address_en_line1 }}<br/><span style="color:var(--sumi-3);">{{ store.address_jp_line1 }}</span></dd></div>
          <div><dt data-i18n="access.hours">Hours</dt><dd>{{ store.hours }}</dd></div>
          {% if store.tel_display != 'TBD' %}<div><dt data-i18n="access.tel">Tel</dt><dd><a href="tel:{{ store.tel_raw }}" data-ga-event="tel_click" data-ga-location="access">{{ store.tel_display }}</a></dd></div>{% endif %}
          <div><dt data-i18n="access.stations">Nearest station</dt><dd>{% for s in store.stations %}{{ s.name }} &mdash; {{ s.min }} <span data-i18n="access.min">min</span>{% if not loop.last %}<br/>{% endif %}{% endfor %}</dd></div>
        </dl>
        {% if store.maps_link != 'TBD' %}
        <a class="cbtn" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="directions_click" data-ga-location="access">{{ circ() }}<span class="lbl" data-i18n="access.maps">Open in Google Maps</span></a>
        {% endif %}
      </div>
      <div class="mapbox"><iframe src="{{ store.maps_embed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe></div>
    </div>
  </div>
</section>

<!-- ================= FINAL ================= -->
<section class="pad final" id="reserve">
  <div class="narrow center reveal">
    <span class="eyebrow" style="color:#e7c98c;" data-i18n="reserve.label">Reserve</span>
    <h2 class="sh" data-i18n="reserve.h">Begin Your Experience</h2>
    <p class="lead" data-i18n="reserve.p">Reservations recommended 2 weeks in advance. Walk-ins welcome subject to availability.</p>
    <p class="ft-name" style="margin-top:18px;color:#e7c98c;">{{ store.name_full_en }}</p>
    <div style="margin-top:24px;">
      <button class="cta-lg" onclick="openReserve('reservation_section')" data-ga-event="reserve_click" data-ga-location="reservation_section">
        <strong data-i18n="{% if store.reserve_system == 'form' %}reserve.btn{{ store.theme | capitalize }}{% else %}reserve.btnTc{% endif %}">{% if store.reserve_system == 'form' %}Reserve Your Omakase{% else %}Reserve on TableCheck{% endif %}</strong>
      </button>
      {% if store.tel_display != 'TBD' %}
      <p class="cta-sub"><span data-i18n="reserve.tel">Prefer to call?</span> <a href="tel:{{ store.tel_raw }}" style="color:#e7c98c;" data-ga-event="tel_click" data-ga-location="reservation_section">{{ store.tel_display }}</a></p>
      {% endif %}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="ft-grid">
      <div>
        <p class="ft-small">Omakase</p>
        <p class="ft-name">{{ store.name_full_en }}</p>
        <p class="ft-addr">
          &#12306;{{ store.address_postal }}<br/>{{ store.address_en_line1 }}<br/>
          {{ store.hours }}{% if store.tel_display != 'TBD' %}<br/><a href="tel:{{ store.tel_raw }}">{{ store.tel_display }}</a>{% endif %}<br/>
          <span style="opacity:.7;">&copy; {{ stores.brand.brand_name }} all rights reserved.</span>
        </p>
      </div>
      <nav class="ft-nav">
        <a href="#courses" data-i18n="nav.menu">Menu</a>
        <a href="#interior" data-i18n="nav.interior">Interior</a>
        <a href="#voices" data-i18n="voices.label">Guest Voices</a>
        <a href="#halal" data-i18n="nav.halal">Muslim-Friendly</a>
        <a href="#faq">FAQ</a>
        <a href="#access" data-i18n="nav.access">Access</a>
        <a href="#reserve" data-i18n="nav.reserve">Reserve</a>
      </nav>
    </div>
    <div class="ft-bar">
      <span>{{ store.region_label }}</span>
      <span>{% for l in ui.langs %}{% if not loop.first %} / {% endif %}<a href="#" data-lang-btn="{{ l.code }}">{{ l.short }}</a>{% endfor %}</span>
    </div>
  </div>
</footer>

<div class="sticky" id="sticky">
  <div class="sticky-t">
    <b>{{ store.name_full_en }}</b>
    <span>{{ store.hours }} &middot; {{ store.station_en }}</span>
  </div>
  <button class="sticky-b" onclick="openReserve('sticky')" data-i18n="nav.reserve" data-ga-event="reserve_click" data-ga-location="sticky">Reserve</button>
</div>

<script>
document.documentElement.classList.remove('no-js');

window.I18N = {{ ui.dict | dump | safe }};
window.LANGS = {{ ui.langs | dump | safe }};
{% for L in courses.langs %}
{% for cat in courses.cats %}
window.I18N["{{ L }}"]["cat.{{ cat.key }}.label"] = {{ cat.label[L] | dump | safe }};
{% endfor %}
{% for c in courses.list %}
window.I18N["{{ L }}"]["course.{{ c.id }}.name"] = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.opt"]  = {{ c.name[L] | dump | safe }};
window.I18N["{{ L }}"]["course.{{ c.id }}.lead"] = {{ c.lead[L] | dump | safe }};
{% endfor %}
{% endfor %}

/* このページ固有の見出し（既存コピーの範囲内で組み替えたもの） */
var EXTRA = {
  en:{"strip.line":"<b>Reservations recommended 2 weeks in advance.</b> Walk-ins welcome subject to availability.",
      "faq.h":"Before you reserve","faq.q1":"Is the food Muslim-friendly?","faq.q2":"Can you accommodate dietary restrictions?",
      "faq.q3":"How far in advance should I book?","faq.q4":"What is the cancellation policy?","faq.q5":"Do the courses change?",
      "cmp.extra":"Sea urchin & crab","cmp.beef":"Beef","cmp.spring":"Spring roll","cmp.nikuzushi":"Nikuzushi","cmp.chawan":"Chawanmushi","cmp.nigiri":"Nigiri","cmp.steak":"Fillet steak","cmp.sukiyaki":"Sukiyaki","cmp.roll":"Hand roll","cmp.book":"Booking","cmp.price":"Price",
      },
  zhs:{"strip.line":"<b>建议提前两周预约。</b>现场候位视空位情况欢迎光临。",
      "faq.h":"预约前须知","faq.q1":"料理是穆斯林友善的吗？","faq.q2":"可以配合饮食限制吗？",
      "faq.q3":"需要提前多久预约？","faq.q4":"取消规定为何？","faq.q5":"套餐内容会变动吗？",
      "cmp.extra":"海胆与蟹","cmp.beef":"牛肉","cmp.spring":"春卷","cmp.nikuzushi":"肉寿司","cmp.chawan":"茶碗蒸","cmp.nigiri":"握寿司","cmp.steak":"菲力牛排","cmp.sukiyaki":"寿喜烧","cmp.roll":"手卷","cmp.book":"预约方式","cmp.price":"价格",
      },
  zht:{"strip.line":"<b>建議提前兩週預約。</b>現場候位視空位情況歡迎光臨。",
      "faq.h":"預約前須知","faq.q1":"料理是穆斯林友善的嗎？","faq.q2":"可以配合飲食限制嗎？",
      "faq.q3":"需要提前多久預約？","faq.q4":"取消規定為何？","faq.q5":"套餐內容會變動嗎？",
      "cmp.extra":"海膽與蟹","cmp.beef":"牛肉","cmp.spring":"春捲","cmp.nikuzushi":"肉壽司","cmp.chawan":"茶碗蒸","cmp.nigiri":"握壽司","cmp.steak":"菲力牛排","cmp.sukiyaki":"壽喜燒","cmp.roll":"手卷","cmp.book":"預約方式","cmp.price":"價格",
      },
  ko:{"strip.line":"<b>2주 전 예약을 권장합니다.</b> 워크인은 좌석 상황에 따라 안내해 드립니다.",
      "faq.h":"예약 전 확인","faq.q1":"음식은 무슬림 프렌들리인가요?","faq.q2":"식이 제한도 배려해 주시나요?",
      "faq.q3":"얼마나 미리 예약해야 하나요?","faq.q4":"취소 규정은 어떻게 되나요?","faq.q5":"코스 내용이 바뀌나요?",
      "cmp.extra":"성게 & 게","cmp.beef":"소고기","cmp.spring":"춘권","cmp.nikuzushi":"니쿠즈시","cmp.chawan":"차완무시","cmp.nigiri":"니기리","cmp.steak":"안심 스테이크","cmp.sukiyaki":"스키야키","cmp.roll":"핸드롤","cmp.book":"예약","cmp.price":"가격",
      },
  id:{"strip.line":"<b>Reservasi disarankan 2 minggu sebelumnya.</b> Tamu tanpa reservasi kami terima sesuai ketersediaan.",
      "faq.h":"Sebelum Anda memesan","faq.q1":"Apakah makanannya ramah Muslim?","faq.q2":"Bisakah menyesuaikan pantangan makanan?",
      "faq.q3":"Seberapa jauh hari sebaiknya memesan?","faq.q4":"Bagaimana kebijakan pembatalannya?","faq.q5":"Apakah isi kursus berubah?",
      "cmp.extra":"Bulu babi & kepiting","cmp.beef":"Daging sapi","cmp.spring":"Lumpia","cmp.nikuzushi":"Nikuzushi","cmp.chawan":"Chawanmushi","cmp.nigiri":"Nigiri","cmp.steak":"Steak fillet","cmp.sukiyaki":"Sukiyaki","cmp.roll":"Hand roll","cmp.book":"Pemesanan","cmp.price":"Harga",
      }
};
Object.keys(EXTRA).forEach(function(L){ Object.keys(EXTRA[L]).forEach(function(k){ window.I18N[L][k] = EXTRA[L][k]; }); });

var VARS = { brand: {{ stores.brand.brand_name | dump | safe }}, city: {{ (store.city.split(',')[0]) | dump | safe }}, tel: {{ store.tel_display | dump | safe }} };
function fill(s){ return String(s).replace(/\{brand\}/g,VARS.brand).replace(/\{city\}/g,VARS.city).replace(/\{tel\}/g,VARS.tel); }

window.CURRENT_LANG = 'en';
function applyLang(code){
  var meta = window.LANGS.filter(function(l){ return l.code === code; })[0];
  if(!meta || !window.I18N[code]) { code = 'en'; meta = window.LANGS[0]; }
  window.CURRENT_LANG = code;
  var d = window.I18N[code];
  document.documentElement.setAttribute('lang', meta.html);
  document.documentElement.setAttribute('data-lang', code);
  if(meta.font) loadFont(meta.font, code);
  document.querySelectorAll('[data-i18n]').forEach(function(el){ var v = d[el.getAttribute('data-i18n')]; if(v != null) el.innerHTML = fill(v); });
  document.querySelectorAll('[data-i18n-ph]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-ph')]; if(v != null) el.setAttribute('placeholder', fill(v)); });
  document.querySelectorAll('[data-i18n-og]').forEach(function(el){ var v = d[el.getAttribute('data-i18n-og')]; if(v != null) el.setAttribute('label', fill(v)); });
  document.querySelectorAll('[data-lang-btn]').forEach(function(b){ b.setAttribute('aria-current', String(b.getAttribute('data-lang-btn') === code)); });
  document.getElementById('langNow').textContent = meta.short;
  try{ localStorage.setItem('omakase_lang', code); }catch(e){}
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({event:'lang_switch', lang:code});
}
var FONTS = {};
function loadFont(family, code){
  if(FONTS[family]) return; FONTS[family] = 1;
  var l = document.createElement('link'); l.rel='stylesheet';
  l.href = 'https://fonts.googleapis.com/css2?family=' + family + '&display=swap';
  document.head.appendChild(l);
  var st = document.createElement('style');
  st.textContent = 'html[data-lang="' + code + '"] body{font-family:"' + family.split(':')[0].replace(/\+/g,' ') + '",serif;}';
  document.head.appendChild(st);
}
function initLang(){
  var q = new URLSearchParams(location.search).get('lang');
  var saved = null; try{ saved = localStorage.getItem('omakase_lang'); }catch(e){}
  var n = (navigator.language || 'en').toLowerCase(), auto = 'en';
  if(n.indexOf('ko') === 0) auto = 'ko';
  else if(n.indexOf('id') === 0 || n.indexOf('in') === 0) auto = 'id';
  else if(n.indexOf('zh') === 0) auto = (n.indexOf('tw') > -1 || n.indexOf('hk') > -1 || n.indexOf('hant') > -1) ? 'zht' : 'zhs';
  applyLang(q || saved || auto);
}
/* 言語選択シート */
(function(){
  var list = document.getElementById('langList');
  window.LANGS.forEach(function(l){
    var b = document.createElement('button');
    b.setAttribute('data-lang-btn', l.code);
    b.innerHTML = '<span>' + l.label + '</span><span class="code">' + l.short + '</span>';
    b.addEventListener('click', function(){ applyLang(l.code); closeSheet(); });
    list.appendChild(b);
  });
})();
var sheet = document.getElementById('langSheet');
function closeSheet(){ sheet.classList.remove('open'); document.body.style.overflow = ''; }
document.getElementById('langOpen').addEventListener('click', function(){ sheet.classList.add('open'); document.body.style.overflow = 'hidden'; });
sheet.addEventListener('click', function(e){ if(e.target === sheet) closeSheet(); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeSheet(); });
document.querySelectorAll('[data-lang-btn]:not(.sheet-list button)').forEach(function(b){
  b.addEventListener('click', function(e){ e.preventDefault(); applyLang(b.getAttribute('data-lang-btn')); });
});

/* overlay menu */
var ovl = document.getElementById('ovl'), burger = document.getElementById('burger'), btx = document.getElementById('btx');
function openMenu(){ ovl.classList.add('open'); document.body.classList.add('nav-open'); document.body.style.overflow='hidden'; burger.setAttribute('aria-expanded','true'); btx.textContent='CLOSE'; }
window.closeMenu = function(){ ovl.classList.remove('open'); document.body.classList.remove('nav-open'); document.body.style.overflow=''; burger.setAttribute('aria-expanded','false'); btx.textContent='MENU'; };
burger.addEventListener('click', function(){ ovl.classList.contains('open') ? closeMenu() : openMenu(); });
document.querySelectorAll('[data-nav]').forEach(function(a){ a.addEventListener('click', closeMenu); });
document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });

/* reveal */
(function(){
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {threshold:.12, rootMargin:'0px 0px -6% 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
})();

/* sticky bar */
(function(){
  var bar = document.getElementById('sticky'), anchor = document.querySelector('.hero-body .cta-lg');
  if(!bar || !anchor) return;
  new IntersectionObserver(function(es){ bar.classList.toggle('show', !es[0].isIntersecting); }, {threshold:0}).observe(anchor);
})();

document.addEventListener('click', function(e){
  var t = e.target.closest('[data-ga-event]'); if(!t) return;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({event:t.getAttribute('data-ga-event'), event_label:t.getAttribute('data-ga-location')||''});
});
document.addEventListener('DOMContentLoaded', initLang);
</script>

{% if store.reserve_system == 'form' %}
  {% include "partials/reserve-v2.njk" %}
{% else %}
  <script>
  window.openReserve = window.openReserveModal = function(label, courseId){
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({event:'reserve_click', event_label: label || '', course_id: courseId || ''});
    window.location.href = '{{ tablecheck_with_utm | safe }}';
  };
  </script>
{% endif %}
</body>
</html>

---
pagination:
  data: stores.pagesTestB
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  is_form_reserve: "{{ 'true' if store.reserve_system == 'form' else 'false' }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Muslim-friendly omakase in {{ store.city }} — wagyu and Edomae sushi at one counter. Alcohol-free. Reserve online."/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-b'});
</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;600;700&family=Jost:wght@300;400;500;600&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet"/>

<style>
:root{
  --paper:#f4efe5; --paper-2:#fffdf9; --paper-3:#eae2d4;
  --sumi:#191512; --sumi-2:#5b5148; --sumi-3:#8d8177;
  --shu:#a8342a; --shu-d:#8b2820; --shu-l:#c9463a;
  --brass:#96793f;
  --line:rgba(25,21,18,.13);
  --disp:'Zen Old Mincho',serif; --body:'Jost',sans-serif;
  --rv-bg:var(--paper-2); --rv-panel:var(--paper); --rv-line:var(--line);
  --rv-text:var(--sumi); --rv-muted:var(--sumi-3); --rv-accent:var(--shu);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:6px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--sumi);font-family:var(--body);font-weight:400;
  -webkit-font-smoothing:antialiased;line-height:1.8;overflow-x:hidden;padding-bottom:76px;}
html[data-lang="zh"] body{font-family:'Noto Serif SC',serif;}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--shu);outline-offset:2px;}
.wrap{width:min(1080px,92vw);margin-inline:auto;}
.narrow{width:min(700px,92vw);margin-inline:auto;}
.pad{padding:clamp(52px,7.5vw,92px) 0;}

.eyebrow{display:inline-block;font-family:var(--body);font-size:10px;font-weight:600;
  letter-spacing:.3em;text-transform:uppercase;color:var(--shu);}
h2.sh{font-family:var(--disp);font-weight:600;font-size:clamp(23px,3.6vw,36px);line-height:1.4;margin-top:12px;}
.lead{font-size:14.5px;line-height:2;color:var(--sumi-2);margin-top:14px;}
.center{text-align:center;}

/* 判子（朱印）— このページの署名要素 */
.seal{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;
  background:var(--shu);color:#fff;font-family:var(--disp);font-weight:600;font-size:11px;
  line-height:1.25;text-align:center;border-radius:3px;transform:rotate(-4deg);
  box-shadow:0 2px 0 rgba(139,40,32,.35);letter-spacing:.02em;}

.reveal{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}

html.no-js .reveal{opacity:1;transform:none;}
/* ---------- top strip ---------- */
.strip{background:var(--sumi);color:var(--paper);font-size:11px;letter-spacing:.06em;
  text-align:center;padding:8px 14px;line-height:1.5;}
.strip b{color:#e7c98c;font-weight:500;}

/* ---------- header ---------- */
.hd{position:sticky;top:0;z-index:70;background:rgba(244,239,229,.94);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;}
.mark b{display:block;font-family:var(--disp);font-weight:600;font-size:15px;letter-spacing:.04em;}
.mark i{font-style:normal;font-size:9px;letter-spacing:.24em;text-transform:uppercase;color:var(--sumi-3);}
.hd-r{display:flex;align-items:center;gap:10px;}
.langs{display:flex;border:1px solid var(--line);border-radius:4px;overflow:hidden;}
.lang{background:transparent;border:none;cursor:pointer;font-family:var(--body);font-size:10px;
  font-weight:500;letter-spacing:.1em;color:var(--sumi-3);padding:7px 9px;}
.lang[aria-pressed="true"]{background:var(--sumi);color:var(--paper);}
.hd-cta{background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);
  font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:11px 18px;border-radius:4px;}
@media(max-width:560px){.hd-cta{display:none;}}

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;}
@media(min-width:1000px){.hero-media{max-height:74vh;}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-badge{position:absolute;left:14px;top:14px;z-index:2;display:flex;align-items:center;gap:7px;
  background:rgba(25,21,18,.72);backdrop-filter:blur(6px);color:#fff;font-size:10.5px;font-weight:500;
  letter-spacing:.1em;padding:7px 12px;border-radius:100px;}
.dot{width:7px;height:7px;border-radius:50%;background:#4ea36c;box-shadow:0 0 0 0 rgba(78,163,108,.6);animation:pl 2s infinite;}
@keyframes pl{70%{box-shadow:0 0 0 8px rgba(78,163,108,0);}100%{box-shadow:0 0 0 0 rgba(78,163,108,0);}}
@media(prefers-reduced-motion:reduce){.dot{animation:none;}}

.hero-body{padding:26px 0 6px;}
.hero-h{font-family:var(--disp);font-weight:700;font-size:clamp(26px,5.2vw,44px);line-height:1.35;letter-spacing:.01em;}
.hero-h em{font-style:normal;color:var(--shu);}
.hero-p{margin-top:14px;font-size:14.5px;line-height:1.95;color:var(--sumi-2);}
.trust{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--paper-2);
  border-radius:100px;padding:7px 13px;font-size:11.5px;font-weight:500;color:var(--sumi-2);}
.chip b{color:var(--shu);font-weight:600;}

.cta-lg{display:inline-flex;flex-direction:column;align-items:center;gap:2px;width:100%;max-width:420px;
  background:var(--shu);color:#fff;border:none;cursor:pointer;padding:17px 24px;border-radius:6px;
  font-family:var(--body);box-shadow:0 4px 0 var(--shu-d);transition:transform .12s,box-shadow .12s;}
.cta-lg:hover{background:var(--shu-l);}
.cta-lg:active{transform:translateY(3px);box-shadow:0 1px 0 var(--shu-d);}
.cta-lg strong{font-size:15px;font-weight:600;letter-spacing:.08em;}
.cta-lg span{font-size:10.5px;opacity:.86;letter-spacing:.04em;}
.cta-sub{margin-top:10px;font-size:11.5px;color:var(--sumi-3);}

/* ---------- reasons ---------- */
.grid3{display:grid;gap:14px;}
@media(min-width:800px){.grid3{grid-template-columns:repeat(3,1fr);}}
.card{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:24px 22px;}
.card h3{font-family:var(--disp);font-weight:600;font-size:17px;line-height:1.5;margin-bottom:9px;}
.card p{font-size:13px;line-height:1.95;color:var(--sumi-2);}
.card .seal{margin-bottom:16px;}

/* ---------- courses ---------- */
.pick{display:grid;gap:16px;}
@media(min-width:840px){.pick{grid-template-columns:repeat(3,1fr);align-items:start;}}
.pc{position:relative;background:var(--paper-2);border:1px solid var(--line);border-radius:6px;overflow:hidden;
  display:flex;flex-direction:column;}
.pc.best{border:2px solid var(--shu);box-shadow:0 8px 30px rgba(168,52,42,.13);}
.pc-flag{position:absolute;right:0;top:0;z-index:2;background:var(--shu);color:#fff;font-size:10px;
  font-weight:600;letter-spacing:.16em;text-transform:uppercase;padding:6px 12px;border-radius:0 0 0 6px;}
.pc-img{aspect-ratio:16/10;overflow:hidden;background:var(--paper-3);}
.pc-img img{width:100%;height:100%;object-fit:cover;}
.pc-in{padding:20px 20px 22px;display:flex;flex-direction:column;flex:1;}
.pc-cat{font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--brass);}
.pc-name{font-family:var(--disp);font-weight:600;font-size:18.5px;line-height:1.45;margin-top:7px;}
.pc-price{margin-top:12px;font-family:var(--disp);font-size:27px;font-weight:600;color:var(--shu);line-height:1;}
.pc-price small{font-family:var(--body);font-size:11px;font-weight:400;color:var(--sumi-3);margin-left:6px;}
.pc-lead{margin-top:12px;font-size:12.8px;line-height:1.9;color:var(--sumi-2);flex:1;}
.pc-list{margin-top:14px;border-top:1px solid var(--line);padding-top:12px;}
.pc-list li{list-style:none;display:flex;gap:8px;font-size:12.2px;line-height:1.75;color:var(--sumi-2);padding:3px 0;}
.pc-list li::before{content:'—';color:var(--shu);flex-shrink:0;}
.pc-btn{margin-top:18px;width:100%;background:var(--sumi);color:var(--paper);border:none;cursor:pointer;
  font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  padding:15px;border-radius:5px;transition:background .2s;}
.pc-btn:hover{background:#000;}
.pc.best .pc-btn{background:var(--shu);box-shadow:0 3px 0 var(--shu-d);}
.pc.best .pc-btn:hover{background:var(--shu-l);}
.pc-more{margin-top:9px;background:none;border:none;cursor:pointer;font-family:var(--body);font-size:11px;
  color:var(--sumi-3);text-decoration:underline;text-underline-offset:3px;padding:4px;}

.tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:28px;}
table.cmp{width:100%;min-width:520px;border-collapse:collapse;background:var(--paper-2);
  border:1px solid var(--line);font-size:12.6px;}
table.cmp th,table.cmp td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;}
table.cmp thead th{background:var(--paper-3);font-family:var(--disp);font-weight:600;font-size:13px;}
table.cmp tbody th{font-weight:500;color:var(--sumi-3);font-size:11px;letter-spacing:.1em;
  text-transform:uppercase;white-space:nowrap;width:1%;}
table.cmp .hi{color:var(--shu);font-weight:600;}

/* ---------- reviews ---------- */
.rev-wrap{display:grid;gap:14px;margin-top:26px;}
@media(min-width:800px){.rev-wrap{grid-template-columns:repeat(2,1fr);}}
.rev{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:22px 21px;}
.stars{color:#d99b20;font-size:14px;letter-spacing:2px;}
.rev-src{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--sumi-3);margin-left:8px;}
.rev p{font-family:var(--disp);font-size:14.5px;line-height:1.95;margin:12px 0 14px;}
.rev cite{font-style:normal;font-size:11.5px;color:var(--sumi-3);letter-spacing:.06em;}
.score{display:flex;flex-wrap:wrap;justify-content:center;gap:28px;align-items:center;margin-top:30px;
  border-top:1px solid var(--line);padding-top:26px;}
.score b{display:block;font-family:var(--disp);font-size:33px;font-weight:600;line-height:1;}
.score span{display:block;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--sumi-3);margin-top:6px;}

/* ---------- steps ---------- */
.steps{display:grid;gap:2px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden;margin-top:26px;}
@media(min-width:800px){.steps{grid-template-columns:repeat(3,1fr);}}
.step{background:var(--paper-2);padding:26px 22px;}
.step b{display:block;font-family:var(--disp);font-size:12px;color:var(--shu);letter-spacing:.14em;margin-bottom:10px;}
.step h4{font-family:var(--disp);font-weight:600;font-size:16px;margin-bottom:8px;}
.step p{font-size:12.6px;line-height:1.9;color:var(--sumi-2);}

/* ---------- faq ---------- */
.faq{border-top:1px solid var(--line);margin-top:26px;}
.faq details{border-bottom:1px solid var(--line);}
.faq summary{cursor:pointer;list-style:none;padding:17px 30px 17px 0;position:relative;
  font-family:var(--disp);font-weight:600;font-size:15px;line-height:1.6;}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:'+';position:absolute;right:4px;top:16px;color:var(--shu);font-size:19px;font-weight:400;}
.faq details[open] summary::after{content:'\2212';}
.faq p{padding:0 0 19px;font-size:13px;line-height:1.95;color:var(--sumi-2);}

/* ---------- access ---------- */
.acc{display:grid;gap:22px;margin-top:26px;}
@media(min-width:840px){.acc{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:88px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid var(--line);}
.dl dt{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--sumi-3);padding-top:4px;}
.dl dd{font-size:13.4px;line-height:1.8;}
.dl dd a{color:var(--shu);border-bottom:1px solid rgba(168,52,42,.3);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- final ---------- */
.final{background:var(--sumi);color:var(--paper);}
.final h2{color:var(--paper);}
.final .lead{color:rgba(244,239,229,.72);}
.final .cta-sub{color:rgba(244,239,229,.55);}

footer{background:var(--sumi);color:rgba(244,239,229,.5);padding:0 0 40px;font-size:11px;letter-spacing:.05em;}
footer a{color:rgba(244,239,229,.75);}

/* ---------- sticky bar ---------- */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:75;background:rgba(25,21,18,.96);
  backdrop-filter:blur(12px);border-top:1px solid rgba(244,239,229,.16);
  display:flex;align-items:center;gap:12px;padding:10px 14px;
  transform:translateY(110%);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.sticky.show{transform:none;}
.sticky-t{flex:1;min-width:0;color:var(--paper);line-height:1.35;}
.sticky-t b{display:block;font-size:12px;font-weight:600;letter-spacing:.04em;}
.sticky-t span{display:block;font-size:10px;color:rgba(244,239,229,.6);}
.sticky-b{flex-shrink:0;background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);
  font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:14px 22px;border-radius:5px;
  box-shadow:0 3px 0 var(--shu-d);}
.sticky-b:active{transform:translateY(2px);box-shadow:0 1px 0 var(--shu-d);}

/* ---------- exit ---------- */
.exit{position:fixed;inset:0;z-index:9980;background:rgba(25,21,18,.7);display:none;
  align-items:center;justify-content:center;padding:20px;}
.exit.open{display:flex;}
.exit-in{background:var(--paper-2);border-radius:8px;max-width:400px;width:100%;padding:30px 26px;text-align:center;position:relative;}
.exit-x{position:absolute;top:10px;right:10px;background:none;border:none;font-size:22px;color:var(--sumi-3);cursor:pointer;}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="strip"><span data-i18n="strip">Counter seats only &#183; <b>Free cancellation up to 48 hours before</b> &#183; No payment online</span></div>

<header class="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top"><b>Omakase</b><i data-i18n="brand.sub">Wagyu &amp; Sushi</i></a>
    <div class="hd-r">
      <div class="langs" role="group" aria-label="Language">
        <button class="lang" data-lang-btn="en" aria-pressed="true">EN</button>
        <button class="lang" data-lang-btn="ja" aria-pressed="false">JA</button>
        <button class="lang" data-lang-btn="zh" aria-pressed="false">中文</button>
      </div>
      <button class="hd-cta" onclick="openReserve('header')" data-i18n="nav.reserve">Reserve</button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section id="top">
  <div class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/top.jpg">
      <source src="/images/hero1.mp4" type="video/mp4"/>
    </video>
    <span class="hero-badge"><span class="dot"></span><span data-i18n="hero.badge">Seats open this week</span></span>
  </div>
  <div class="wrap hero-body">
    <p class="eyebrow">{{ store.region_label }}</p>
    <h1 class="hero-h" data-i18n="hero.h">Wagyu <em>and</em> Edomae sushi,<br/>at the same counter.</h1>
    <p class="hero-p" data-i18n="hero.p">Muslim-friendly omakase — no pork, no alcohol, not even in the sauces. Eight dishes in about seventy minutes, {{ store.station_en }} nearby.</p>
    <div class="trust">
      <span class="chip"><b>&#9733; {{ store.rating }}</b> Google · {{ store.rating_count }}</span>
      <span class="chip" data-i18n="chip.halal">Halal-conscious kitchen</span>
      <span class="chip" data-i18n="chip.lang">English &amp; Chinese</span>
      <span class="chip" data-i18n="chip.walk">{{ store.stations[0].min }} min from {{ store.station_en }}</span>
    </div>
    <div style="margin-top:24px;">
      <button class="cta-lg" onclick="openReserve('hero')">
        <strong data-i18n="cta.main">Check available seats</strong>
        <span data-i18n="cta.mainSub">Takes about 60 seconds · no payment now</span>
      </button>
      <p class="cta-sub" data-i18n="cta.underHero">We reply by email once the counter is confirmed.</p>
    </div>
  </div>
</section>

<!-- ============ WHY ============ -->
<section class="pad">
  <div class="wrap">
    <div class="center reveal" style="max-width:640px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="why.eye">Why guests book here</span>
      <h2 class="sh" data-i18n="why.h">Three things you will not find together anywhere else</h2>
    </div>
    <div class="grid3 reveal" style="margin-top:32px;">
      <div class="card">
        <span class="seal" data-i18n="why.s1">寿司<br/>和牛</span>
        <h3 data-i18n="why.h1">Both, in one sitting</h3>
        <p data-i18n="why.p1">Nigiri shaped on the board and wagyu finished on the iron plate, served as one continuous course. Nobody at the table has to compromise.</p>
      </div>
      <div class="card">
        <span class="seal" data-i18n="why.s2">無<br/>酒精</span>
        <h3 data-i18n="why.h2">Alcohol-free throughout</h3>
        <p data-i18n="why.p2">Mirin and cooking sake are replaced in every dish, marinade and sauce. No pork, no lard. You will not need to ask about a single plate.</p>
      </div>
      <div class="card">
        <span class="seal" data-i18n="why.s3">対面<br/>調理</span>
        <h3 data-i18n="why.h3">Cooked in front of you</h3>
        <p data-i18n="why.p3">Counter seating only, {{ store.max_guests }} places. The chef hands each piece over directly and answers in English or Chinese.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ COURSES ============ -->
<section class="pad" style="background:var(--paper-3);" id="courses">
  <div class="wrap">
    <div class="center reveal" style="max-width:640px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="cs.eye">Choose your course</span>
      <h2 class="sh" data-i18n="cs.h">Three ways in</h2>
      <p class="lead" data-i18n="cs.p">Every course runs eight dishes over about seventy minutes. Pick one now — you can change it later by replying to your confirmation email.</p>
    </div>

    {% set FEATURED = ["sushi-wagyu-light","sushi-wagyu-standard","sushi-kobe-premium"] %}
    <div class="pick reveal" style="margin-top:32px;">
      {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}
      {% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}
      <div class="pc{% if loop.index0 == 1 %} best{% endif %}">
        {% if c.web_only %}<span class="pc-flag" data-i18n="flag.web">Web only</span>{% endif %}
        <div class="pc-img"><img src="{{ c.img }}" alt="" loading="lazy"/></div>
        <div class="pc-in">
          <span class="pc-cat" data-i18n="cat.{{ c.cat }}.label">{% for cc in courses.cats %}{% if cc.key == c.cat %}{{ cc.label.en }}{% endif %}{% endfor %}</span>
          <h3 class="pc-name" data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</h3>
          {% if showPrice %}
          <p class="pc-price">&yen;{{ yen(p) }}<small>&yen;{{ yen((p * 1.1) | round(0,"floor") | int) }} <span data-i18n="course.incl">incl. tax</span></small></p>
          {% endif %}
          <p class="pc-lead" data-i18n="course.{{ c.id }}.lead">{{ c.lead.en }}</p>
          <ul class="pc-list">
            {% for r in c.rows %}{% if loop.index0 == 2 or loop.index0 == 3 or loop.index0 == 5 %}
            <li data-i18n="course.{{ c.id }}.r{{ loop.index0 }}.t">{{ r.text.en }}</li>
            {% endif %}{% endfor %}
          </ul>
          <button class="pc-btn" onclick="openReserve('course_{{ c.id }}','{{ c.id }}')" data-i18n="cs.btn">Reserve this course</button>
          <button class="pc-more" onclick="document.getElementById('cmp').scrollIntoView({behavior:'smooth'})" data-i18n="cs.more">See the full comparison</button>
        </div>
      </div>
      {% endif %}{% endfor %}{% endfor %}
    </div>

    <div class="tbl-scroll reveal" id="cmp">
      <table class="cmp">
        <thead>
          <tr>
            <th></th>
            {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}
            <th data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</th>
            {% endif %}{% endfor %}{% endfor %}
          </tr>
        </thead>
        <tbody>
          <tr><th data-i18n="cmp.nigiri">Nigiri</th><td>3</td><td class="hi">5</td><td class="hi">5 + crab</td></tr>
          <tr><th data-i18n="cmp.steak">Steak</th><td>50g</td><td class="hi">100g</td><td class="hi">100g Kobe</td></tr>
          <tr><th data-i18n="cmp.beef">Beef grade</th><td data-i18n="cmp.wagyu">Wagyu</td><td data-i18n="cmp.wagyu2">Wagyu</td><td class="hi" data-i18n="cmp.kobe">Certified Kobe</td></tr>
          <tr><th data-i18n="cmp.extra">Sea urchin</th><td>—</td><td>—</td><td class="hi" data-i18n="cmp.yes">Hand roll</td></tr>
          <tr><th data-i18n="cmp.book">Booking</th><td class="hi" data-i18n="cmp.webonly">Online only</td><td data-i18n="cmp.any">Any time</td><td data-i18n="cmp.any2">Any time</td></tr>
          {% if showPrice %}
          <tr><th data-i18n="cmp.price">Price</th>
            {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}
            {% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}
            <td>&yen;{{ yen(p) }}</td>
            {% endif %}{% endfor %}{% endfor %}
          </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

    <p class="lead center reveal" style="margin-top:22px;font-size:12.5px;" data-i18n="cs.foot">Sushi-only and wagyu-only courses are also available. Choose them in the reservation form.</p>
  </div>
</section>

<!-- ============ REVIEWS ============ -->
<section class="pad">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="rev.eye">Guest reviews</span>
      <h2 class="sh" data-i18n="rev.h">What people say after the last piece</h2>
    </div>
    <div class="rev-wrap reveal">
      <div class="rev">
        <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p data-i18n="rev.1">Beautifully presented wagyu, thoughtfully served. The Muslim-friendly menu meant my family from Dubai could enjoy the whole course. We felt at home.</p>
        <cite>Ahmed K. — Dubai</cite>
      </div>
      <div class="rev">
        <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p data-i18n="rev.2">Watching the chef carve the wagyu was half the meal. The quality of the beef is on another level — worth every yen.</p>
        <cite>Jennifer M. — New York</cite>
      </div>
      <div class="rev">
        <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p data-i18n="rev.3">As a Muslim food lover, finding an authentic Muslim-friendly omakase in Japan was a dream. The attention to dietary detail really showed.</p>
        <cite>Farah S. — Kuala Lumpur</cite>
      </div>
      <div class="rev">
        <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p data-i18n="rev.4">真正的日本和牛體驗，完全不同於香港吃到的。低溫慢煮帶出的甘甜讓人難忘。師傅對每一片肉的態度就像對藝術品一樣。</p>
        <cite>Lin H. — Hong Kong</cite>
      </div>
    </div>
    <div class="score reveal">
      <div class="center"><b>{{ store.rating }}</b><span>Google · {{ store.rating_count }} reviews</span></div>
      <div class="center"><b>No.1</b><span data-i18n="score.tripadvisor">Tripadvisor Tokyo &#183; flagship</span></div>
    </div>
  </div>
</section>

<!-- ============ STEPS ============ -->
<section class="pad" style="background:var(--paper-3);">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="st.eye">How booking works</span>
      <h2 class="sh" data-i18n="st.h">Three steps, about a minute</h2>
    </div>
    <div class="steps reveal">
      <div class="step"><b>01</b><h4 data-i18n="st.h1">Send your request</h4><p data-i18n="st.p1">Pick a date, time, party size and course. No card details, no account.</p></div>
      <div class="step"><b>02</b><h4 data-i18n="st.h2">We confirm the counter</h4><p data-i18n="st.p2">You get a confirmation email once your seats are held — usually within a few hours.</p></div>
      <div class="step"><b>03</b><h4 data-i18n="st.h3">Just arrive</h4><p data-i18n="st.p3">Pay at the restaurant. Cancel free of charge up to 48 hours before.</p></div>
    </div>
    <div class="center" style="margin-top:32px;">
      <button class="cta-lg" onclick="openReserve('steps')">
        <strong data-i18n="cta.main">Check available seats</strong>
        <span data-i18n="cta.mainSub">Takes about 60 seconds · no payment now</span>
      </button>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="pad">
  <div class="narrow">
    <div class="center reveal">
      <span class="eyebrow" data-i18n="faq.eye">Questions</span>
      <h2 class="sh" data-i18n="faq.h">Before you book</h2>
    </div>
    <div class="faq reveal">
      <details><summary data-i18n="faq.q1">Is the restaurant halal certified?</summary><p data-i18n="faq.a1">We describe ourselves as Muslim-friendly rather than certified. No pork or lard is used anywhere in the kitchen, and alcohol — including mirin and cooking sake — is replaced in every dish, sauce and dessert. If you have a specific requirement, tell us in the reservation notes and we will answer honestly before you come.</p></details>
      <details><summary data-i18n="faq.q2">Can you handle allergies?</summary><p data-i18n="faq.a2">Yes, in most cases. Write the allergy in the request form and the chef will adjust the course. For severe shellfish or sesame allergies please also call us, since the counter handles these ingredients constantly.</p></details>
      <details><summary data-i18n="faq.q3">How long does the course take?</summary><p data-i18n="faq.a3">About seventy minutes for eight dishes. Arriving on time matters — the course is served in sequence and the counter turns over between seatings.</p></details>
      <details><summary data-i18n="faq.q4">Can I book for today?</summary><p data-i18n="faq.a4">{% if store.same_day_reserve %}Same-day requests are accepted online for slots that have not started yet. If the form shows nothing available, call us and we will check the counter directly.{% else %}Same-day bookings are taken by phone only. Please call the restaurant and we will check the counter for you.{% endif %}</p></details>
      <details><summary data-i18n="faq.q5">What if my plans change?</summary><p data-i18n="faq.a5">Cancel free of charge up to 48 hours before. Within 48 hours the fee is ¥5,000 per person, and within 24 hours ¥10,000 per person. Reply to your confirmation email to change the date instead.</p></details>
      <details><summary data-i18n="faq.q6">Is there a prayer space?</summary><p data-i18n="faq.a6">We can arrange a quiet space on request, and time your seating around prayer. Mention it in the reservation notes.</p></details>
    </div>
  </div>
</section>

<!-- ============ ACCESS ============ -->
<section class="pad" style="background:var(--paper-3);" id="access">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="ac.eye">Getting here</span>
      <h2 class="sh">{{ store.region_label }}</h2>
    </div>
    <div class="acc reveal">
      <div>
        <dl class="dl">
          <div><dt data-i18n="ac.addr">Address</dt><dd>&#12306;{{ store.address_postal }}<br/>{{ store.address_en_line1 }}<br/><span style="color:var(--sumi-3);">{{ store.address_jp_line1 }}</span></dd></div>
          <div><dt data-i18n="ac.hours">Hours</dt><dd>{{ store.hours }} <span style="color:var(--sumi-3);" data-i18n="ac.hoursNote">(open daily)</span></dd></div>
          {% if store.tel_display != 'TBD' %}<div><dt data-i18n="ac.tel">Tel</dt><dd><a href="tel:{{ store.tel_raw }}" data-ga-event="tel_click" data-ga-location="access">{{ store.tel_display }}</a></dd></div>{% endif %}
          <div><dt data-i18n="ac.train">Stations</dt><dd>{% for s in store.stations %}{{ s.name }} — {{ s.min }} min{% if not loop.last %}<br/>{% endif %}{% endfor %}</dd></div>
        </dl>
        <a class="pc-btn" style="display:block;text-align:center;margin-top:20px;" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="maps_click" data-i18n="ac.maps">Open in Google Maps</a>
      </div>
      <div class="mapbox"><iframe src="{{ store.maps_embed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe></div>
    </div>
  </div>
</section>

<!-- ============ FINAL ============ -->
<section class="pad final" id="reserve">
  <div class="narrow center reveal">
    <span class="eyebrow" style="color:#e7c98c;" data-i18n="fin.eye">Reservation</span>
    <h2 class="sh" data-i18n="fin.h">The counter seats {{ store.max_guests }}</h2>
    <p class="lead" data-i18n="fin.p">Send your date and we will confirm by email. No payment now, and free cancellation up to 48 hours before.</p>
    <div style="margin-top:28px;">
      <button class="cta-lg" onclick="openReserve('final')">
        <strong data-i18n="cta.main">Check available seats</strong>
        <span data-i18n="cta.mainSub">Takes about 60 seconds · no payment now</span>
      </button>
      {% if store.tel_display != 'TBD' %}
      <p class="cta-sub"><span data-i18n="fin.tel">Same-day or a large party?</span> <a href="tel:{{ store.tel_raw }}" style="color:#e7c98c;">{{ store.tel_display }}</a></p>
      {% endif %}
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <p>{{ store.name_full_en }}<br/>{{ store.address_en_line1 }}{% if store.tel_display != 'TBD' %} · <a href="tel:{{ store.tel_raw }}">{{ store.tel_display }}</a>{% endif %}</p>
    <p style="margin-top:14px;opacity:.6;">&copy; {{ stores.brand.brand_name }}</p>
  </div>
</footer>

<div class="sticky" id="sticky">
  <div class="sticky-t">
    <b data-i18n="sticky.t">Counter seats, {{ store.hours }}</b>
    <span data-i18n="sticky.s">Free cancellation up to 48h before</span>
  </div>
  <button class="sticky-b" onclick="openReserve('sticky')" data-i18n="sticky.b">Reserve</button>
</div>

<div class="exit" id="exit">
  <div class="exit-in">
    <button class="exit-x" onclick="closeExit()" aria-label="Close">&#215;</button>
    <span class="seal" data-i18n="exit.seal">残席<br/>あり</span>
    <h3 style="font-family:var(--disp);font-weight:600;font-size:19px;margin:16px 0 10px;" data-i18n="exit.h">Still deciding?</h3>
    <p style="font-size:13px;line-height:1.9;color:var(--sumi-2);" data-i18n="exit.p">Sending a request does not commit you to anything. There is no payment, and you can cancel free of charge up to 48 hours before.</p>
    <button class="cta-lg" style="margin-top:20px;" onclick="closeExit();openReserve('exit_intent');">
      <strong data-i18n="cta.main">Check available seats</strong>
      <span data-i18n="cta.mainSub">Takes about 60 seconds · no payment now</span>
    </button>
  </div>
</div>


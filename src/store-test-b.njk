  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
})();

/* 右下の常時予約ボタン */
document.addEventListener('DOMContentLoaded', function(){
  var fab = document.getElementById('fab'); if(!fab) return;
  var anchor = document.querySelector('.hero-stage') || document.querySelector('.hero-media');
  if(!anchor){ fab.classList.add('show'); return; }
  new IntersectionObserver(function(es){
    fab.classList.toggle('show', es[0].intersectionRatio < .15);
  }, {threshold:[0,.15,.5,1]}).observe(anchor);
});


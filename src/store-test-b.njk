---
pagination:
  data: stores.pagesTestB
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}index.html"
eleventyComputed:
  title: "{{ store.name_full_en }}"
  tablecheck_with_utm: "{% if store.tablecheck_url and store.tablecheck_url != 'TBD' %}{{ store.tablecheck_url }}?utm_source={{ store.channel_utm_source }}&utm_medium=referral{% else %}#{% endif %}"
---
{% if store.theme == "wagyu" %}
{% set IMG = {
  heroMain: "/images/course-kobe-premium.jpg",
  hero:    "/images/ロコ_あり和牛.mp4",
  poster:  "/images/ロコ_あり和牛-poster.jpg",
  lead:    "/images/wagyu-lead.jpg",
  concept: "/images/course-kobe-premium.jpg",
  band:    "/images/cat-wagyu.jpg",
  col_a:   "/images/course-wagyu-standard.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/chef3.jpg",
  courses: ["/images/course-wagyu-standard.jpg","/images/course-kobe-premium.jpg","/images/wagyu-lead.jpg","/images/cat-wagyu.jpg"]
} %}
{% else %}
{% set IMG = {
  heroMain: "/images/course-sushi-premium.jpg",
  hero:    "/images/ロコ_あり寿司.mp4",
  poster:  "/images/ロコ_あり寿司-poster.jpg",
  lead:    "/images/sushi1.jpg",
  concept: "/images/sushi2.jpg",
  band:    "/images/cat-sushi.jpg",
  col_a:   "/images/course-sushi-premium.jpg",
  col_b:   "/images/chef2.jpg",
  story:   "/images/chef1.jpg",
  halal:   "/images/sushi4.jpg",
  courses: ["/images/course-sushi-standard.jpg","/images/course-sushi-premium.jpg","/images/sushi1.jpg","/images/sushi2.jpg"]
} %}
{% endif %}
{% set SHOW_PERFORMANCE = false %}   {# パフォーマンスセクションの表示切替。true で復活 #}
{% set TH = courses.themes[store.theme] or courses.themes.all %}
{% set showPrice = (not store.hide_prices) or store.force_prices %}
{% macro circ() %}<span class="circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endmacro %}
{% macro yen(n) %}{% set s = (n | string) %}{% set L = s | length %}{% for i in range(0, L) %}{% if i > 0 and (L - i) % 3 == 0 %},{% endif %}{{ s[i] }}{% endfor %}{% endmacro %}
<!DOCTYPE html>
<html lang="en" data-lang="en" class="no-js">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>{{ store.name_full_en }}</title>
<meta name="description" content="Sushi &amp; Wagyu Halal Omakase Experience — {{ store.name_full_en }}"/>
<meta name="robots" content="noindex,follow"/>
<link rel="canonical" href="https://{{ stores.brand.domain }}/{{ store.region }}/{{ store.slug }}/"/>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-TJKTLQJ6');</script>
<script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({store_name:'{{ store.slug }}',store_area:'{{ store.region }}',brand:'{{ stores.brand.brand_slug }}',channel:'{{ store.channel_id }}',design:'test-b',theme:'{{ store.theme }}'});</script>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
:root{
  --paper:#f4efe5; --paper-2:#fffdf9; --paper-3:#eae2d4;
  --sumi:#131010; --sumi-2:#4a4139; --sumi-3:#6e645b;
  --shu:#8c2230; --shu-d:#6d1926; --shu-l:#a62c3d; --brass:#a5843f;
  --line:rgba(20,17,16,.18);
  --disp:'Lora',serif; --body:'Jost',sans-serif;
  --gut:clamp(24px,6vw,104px);
  --rv-bg:var(--paper-2); --rv-panel:var(--paper); --rv-line:var(--line);
  --rv-text:var(--sumi); --rv-muted:var(--sumi-3); --rv-accent:var(--shu);
  --rv-on-accent:#fff; --rv-display:var(--disp); --rv-body:var(--body); --rv-radius:6px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--paper);color:var(--sumi);font-family:var(--body);font-weight:400;line-height:1.78;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;padding-bottom:clamp(84px,10vw,108px);}
img,video{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
:focus-visible{outline:2px solid var(--shu);outline-offset:2px;}

.wrap{width:100%;max-width:1160px;margin-inline:auto;padding-inline:var(--gut);}
.narrow{width:100%;max-width:800px;margin-inline:auto;padding-inline:var(--gut);}
.pad{padding:clamp(52px,8vw,96px) 0;}
.center{text-align:center;}

.eyebrow{display:inline-block;font-family:var(--body);font-size:11.5px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--shu);}
h2.sh{font-family:var(--disp);font-weight:600;font-size:clamp(21px,3.2vw,32px);line-height:1.36;letter-spacing:-.006em;margin-top:12px;}
.lead{font-size:16px;line-height:1.92;color:var(--sumi-2);margin-top:14px;}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s cubic-bezier(.16,1,.3,1);}
.reveal.in{opacity:1;transform:none;}
html.no-js .reveal{opacity:1;transform:none;}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none;}}



/* ---------- えんじのアクセント ---------- */
.eyebrow{position:relative;padding-left:22px;}
.eyebrow::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);
  width:14px;height:2px;background:var(--shu);}
.center .eyebrow{padding-left:0;}
.center .eyebrow::before{position:static;transform:none;display:block;margin:0 auto 10px;width:36px;}
.hd{box-shadow:inset 0 -3px 0 -2px var(--shu);}
.s-dots button.on{background:var(--shu);}
.card{border-top:2px solid var(--shu);}
.rev{border-left:2px solid rgba(140,34,48,.45);}
.step b{color:var(--shu);}
.faq summary::after{color:var(--shu);}
.pc.best{box-shadow:0 8px 30px rgba(140,34,48,.16);}
.strip{border-bottom:2px solid var(--shu);}
footer{border-top:2px solid var(--shu);}
.g-num{color:var(--shu);}

/* ---------- strip / header ---------- */
.strip{background:var(--sumi);color:var(--paper);font-size:12.5px;letter-spacing:.03em;text-align:center;padding:10px 16px;line-height:1.6;}
.strip b{color:#e7c98c;font-weight:500;}
.hd{position:sticky;top:0;z-index:70;background:rgba(244,239,229,.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);}
.hd-in{display:flex;align-items:center;justify-content:space-between;gap:clamp(10px,2vw,22px);padding:10px 0;}
/* 左上：ロゴ＋フル店名。折り返して全文を出す（省略しない） */
.mark{display:flex;align-items:center;flex-shrink:0;}
.mark img{width:clamp(56px,6.6vw,92px);height:auto;}
.mark b{display:block;font-family:var(--disp);font-weight:600;line-height:1.3;
  font-size:clamp(10.5px,1.1vw,14.5px);letter-spacing:.005em;
  white-space:normal;overflow-wrap:anywhere;word-break:normal;}
@media(max-width:900px){.mark{max-width:none;}}
@media(max-width:520px){.mark img{width:32px;} .mark b{font-size:10px;line-height:1.28;}}
.hd-r{display:flex;align-items:center;gap:clamp(8px,1.2vw,14px);flex-shrink:0;}
.hd-cta{background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);font-weight:600;
  font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:11px 16px;border-radius:4px;}
@media(max-width:620px){.hd-cta{display:none;}}
.burger{width:34px;height:34px;background:none;border:none;cursor:pointer;display:flex;flex-direction:column;justify-content:center;gap:5px;}
.burger span{display:block;height:1.5px;background:var(--sumi);transition:transform .35s,width .35s;}
.burger span:nth-child(1){width:22px;} .burger span:nth-child(2){width:14px;margin-left:auto;}

.langbtn{display:flex;align-items:center;gap:7px;background:var(--paper-2);border:1px solid var(--line);border-radius:4px;
  cursor:pointer;color:var(--sumi);font-family:var(--body);font-size:13.5px;font-weight:500;padding:10px 13px;transition:border-color .3s;}
.langbtn:hover{border-color:var(--sumi-3);}
.langbtn svg{width:15px;height:15px;flex-shrink:0;color:var(--shu);}
@media(max-width:560px){.langbtn span{display:none;} .langbtn{padding:10px 11px;}}
.sheet{position:fixed;inset:0;z-index:96;display:none;place-items:center;padding:20px;background:rgba(25,21,18,.5);}
.sheet.open{display:grid;}
.sheet-in{background:var(--paper-2);border-radius:8px;width:100%;max-width:400px;padding:26px;
  box-shadow:0 30px 70px -20px rgba(25,21,18,.45);animation:sheetUp .34s cubic-bezier(.16,1,.3,1) both;}
@keyframes sheetUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:none;}}
@media(prefers-reduced-motion:reduce){.sheet-in{animation:none;}}
.sheet-in h4{font-family:var(--disp);font-weight:600;font-size:19px;}
.sheet-in p{font-size:13.5px;line-height:1.75;color:var(--sumi-2);margin:5px 0 16px;}
.sheet-list{display:grid;gap:3px;}
.sheet-list button{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;background:none;border:none;
  border-radius:6px;cursor:pointer;font-family:var(--body);font-size:15px;color:var(--sumi);text-align:left;padding:12px 13px;transition:background .25s;}
.sheet-list button:hover{background:var(--paper-3);}
.sheet-list button[aria-current="true"]{background:rgba(168,52,42,.09);color:var(--shu);font-weight:600;}
.sheet-list .code{font-size:11px;letter-spacing:.12em;color:var(--sumi-3);}
.burger{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;width:44px;padding:2px 0;}
.burger .bl{width:28px;height:1.5px;background:var(--sumi);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.burger .btx{font-size:9px;font-weight:600;letter-spacing:.14em;color:var(--sumi);line-height:1;}
.nav-open .burger .bl:nth-child(1){transform:translateY(4px) rotate(45deg);}
.nav-open .burger .bl:nth-child(2){transform:translateY(-2.5px) rotate(-45deg);}

/* circle chevron button */
.cbtn{display:inline-flex;align-items:center;gap:16px;background:none;border:none;cursor:pointer;color:var(--sumi);font-family:var(--body);padding:0;}
.cbtn .circ{position:relative;flex-shrink:0;width:clamp(46px,5vw,60px);height:clamp(46px,5vw,60px);border-radius:50%;
  border:1px solid rgba(25,21,18,.3);display:grid;place-items:center;overflow:hidden;transition:border-color .4s,color .4s;}
.cbtn .circ::before{content:'';position:absolute;inset:-1px;border-radius:50%;background:var(--shu);transform:scale(0);transition:transform .5s cubic-bezier(.16,1,.3,1);}
.cbtn .circ svg{position:relative;z-index:1;width:18px;height:18px;transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cbtn:hover .circ{border-color:var(--shu);color:#fff;}
.cbtn:hover .circ::before{transform:scale(1);}
.cbtn:hover .circ svg{transform:translateX(3px);}
.cbtn .lbl{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;}
.final .cbtn,.final .cbtn .circ{color:var(--paper);}
.final .cbtn .circ{border-color:rgba(244,239,229,.4);}

/* ---------- overlay menu ---------- */
.ovl{position:fixed;inset:0;z-index:90;background:rgba(25,21,18,.97);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .5s ease,visibility .5s;}
.ovl.open{opacity:1;visibility:visible;}
.ovl-in{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);}
.ovl a{display:block;width:max-content;font-family:var(--disp);font-weight:500;letter-spacing:-.005em;font-size:clamp(25px,4.8vw,50px);
  line-height:1.5;color:var(--paper);opacity:0;transform:translateY(16px);
  transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1),color .3s;}
.ovl.open a{opacity:1;transform:none;}
.ovl.open a:nth-child(1){transition-delay:.10s;} .ovl.open a:nth-child(2){transition-delay:.16s;}
.ovl.open a:nth-child(3){transition-delay:.22s;} .ovl.open a:nth-child(4){transition-delay:.28s;}
.ovl.open a:nth-child(5){transition-delay:.34s;} .ovl.open a:nth-child(6){transition-delay:.40s;}
.ovl a:hover{color:var(--shu-l);}
.ovl-foot{position:absolute;left:0;right:0;bottom:clamp(24px,5vw,52px);}
.ovl-logo{width:clamp(96px,12vw,150px);height:auto;margin-bottom:14px;opacity:.9;}
.ovl-foot p{font-size:12.5px;line-height:1.9;color:rgba(244,239,229,.5);}
.ovl-foot a{color:#e7c98c;}

@media(max-width:760px){
      }

/* ---------- hero ---------- */
.hero-media{position:relative;width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;}
@media(min-width:1000px){.hero-media{max-height:72vh;}}
.hero-media video{width:100%;height:100%;object-fit:cover;}
.hero-body{padding-top:26px;padding-bottom:8px;}
.hero-h{font-family:var(--disp);font-weight:600;font-size:clamp(22px,3.3vw,36px);line-height:1.34;letter-spacing:-.008em;overflow-wrap:anywhere;}
.hero-h em{font-style:normal;color:var(--shu);}
.hero-p{margin-top:12px;font-size:16px;line-height:1.9;color:var(--sumi-2);}
.trust{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
.chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--paper-2);
  border-radius:100px;padding:8px 14px;font-size:13px;font-weight:500;color:var(--sumi);}
.chip b{color:var(--shu);font-weight:600;}

.cta-lg{display:inline-flex;flex-direction:column;align-items:center;gap:2px;width:100%;max-width:420px;
  background:var(--shu);color:#fff;border:none;cursor:pointer;padding:17px 22px;border-radius:6px;
  font-family:var(--body);box-shadow:0 4px 0 var(--shu-d);transition:transform .12s,box-shadow .12s,background .2s;}
.cta-lg:hover{background:var(--shu-l);}
.cta-lg:active{transform:translateY(3px);box-shadow:0 1px 0 var(--shu-d);}
.cta-lg strong{font-size:15px;font-weight:600;letter-spacing:.06em;}
.cta-lg span{font-size:10.5px;opacity:.85;}
.cta-sub{margin-top:10px;font-size:13px;color:var(--sumi-2);}


/* ---------- 内観スライドショー ---------- */
.slider{position:relative;width:100%;overflow:hidden;border-radius:8px;background:var(--paper-3);}
.slides{position:relative;width:100%;aspect-ratio:16/9;}
.slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.1s cubic-bezier(.4,0,.2,1);}
.slides img.on{opacity:1;}
.s-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;border-radius:50%;
  border:none;background:rgba(255,253,249,.9);color:var(--sumi);display:grid;place-items:center;cursor:pointer;
  box-shadow:0 4px 14px rgba(25,21,18,.25);transition:background .3s,color .3s;}
.s-nav svg{width:18px;height:18px;}
.s-nav:hover{background:var(--shu);color:#fff;}
.s-nav.prev{left:14px;} .s-nav.next{right:14px;}
@media(max-width:600px){.s-nav{width:36px;height:36px;} .s-nav.prev{left:8px;} .s-nav.next{right:8px;}}
.s-dots{position:absolute;left:0;right:0;bottom:14px;z-index:3;display:flex;justify-content:center;gap:8px;}
.s-dots button{width:26px;height:3px;border:none;padding:0;border-radius:2px;cursor:pointer;background:rgba(255,253,249,.55);transition:background .3s,width .3s;}
.s-dots button.on{background:var(--shu);width:42px;}

/* ---------- パフォーマンス ---------- */
.reels{display:grid;gap:clamp(16px,2.6vw,28px);margin-top:clamp(26px,3.8vw,42px);}
@media(min-width:700px){.reels{grid-template-columns:repeat(2,1fr);max-width:800px;margin-inline:auto;}}
.reel{position:relative;overflow:hidden;border-radius:8px;background:#000;box-shadow:0 16px 44px -26px rgba(25,21,18,.6);}
.reel video{width:100%;aspect-ratio:9/16;object-fit:cover;display:block;}
.reel::after{content:'';position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(20,17,16,.24) 0%,rgba(20,17,16,0) 22%,rgba(20,17,16,0) 72%,rgba(20,17,16,.66) 100%);}
.reel-cap{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:18px 20px;text-align:left;}
.reel-cap b{display:block;font-family:var(--disp);font-weight:600;font-size:clamp(15px,1.9vw,19px);line-height:1.35;color:#fff;}
.reel-cap span{display:block;margin-top:5px;font-weight:600;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.78);}

/* ---------- Google レビュー ---------- */
.gcard{max-width:520px;margin:clamp(24px,4vw,44px) auto 0;background:var(--paper-2);border:1px solid var(--line);
  border-radius:12px;padding:clamp(26px,4vw,38px) clamp(22px,3.4vw,34px);text-align:center;box-shadow:0 14px 40px -26px rgba(25,21,18,.4);}
.gword{font-family:var(--body);font-weight:500;font-size:clamp(22px,3vw,28px);letter-spacing:-.01em;line-height:1;}
.gword i{font-style:normal;}
.g1{color:#4285F4}.g2{color:#EA4335}.g3{color:#FBBC05}.g4{color:#4285F4}.g5{color:#34A853}.g6{color:#EA4335}
.g-sub{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--sumi-2);margin-top:8px;}
.g-row{display:flex;align-items:center;justify-content:center;gap:clamp(14px,2.4vw,22px);margin-top:20px;}
.g-num{font-family:var(--disp);font-weight:600;font-size:clamp(50px,8vw,74px);line-height:.88;letter-spacing:-.03em;color:var(--sumi);}
.g-right{text-align:left;}
.g-stars{display:flex;gap:3px;}
.g-stars svg{width:20px;height:20px;fill:#FBBC05;}
.g-out{font-size:12.5px;color:var(--sumi-2);margin-top:5px;}
.g-count{margin-top:16px;padding-top:16px;border-top:1px solid var(--line);font-family:var(--disp);font-weight:600;font-size:clamp(17px,2.2vw,22px);}
.g-count small{display:block;font-family:var(--body);font-weight:600;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--sumi-2);margin-top:5px;}
.g-link{display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-size:13px;font-weight:600;
  color:var(--shu);border-bottom:1px solid rgba(168,52,42,.35);padding-bottom:2px;}


/* ---------- 常時表示のフローティングCTA（既存デザイン踏襲） ---------- */
.fab{position:fixed;right:clamp(12px,2vw,24px);bottom:clamp(12px,2vw,24px);z-index:78;
  display:flex;flex-direction:column;align-items:flex-start;gap:2px;
  background:#c9a96e;color:#0b0908;border:none;cursor:pointer;text-decoration:none;
  font-family:var(--body);border-radius:14px;padding:11px 18px;overflow:hidden;
  box-shadow:0 10px 30px rgba(0,0,0,.45),0 0 0 1px rgba(201,169,110,.45);
  transition:transform .2s ease,box-shadow .2s ease,background .2s;}
.fab:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 14px 36px rgba(0,0,0,.55),0 0 0 1px rgba(201,169,110,.8);}
.fab-viewers{display:flex;align-items:center;gap:6px;position:relative;z-index:2;
  font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(11,9,8,.72);}
.fab-dot{width:7px;height:7px;border-radius:50%;background:#16a34a;box-shadow:0 0 0 0 rgba(22,163,74,.6);animation:pulseGreen 1.8s ease-in-out infinite;}
@keyframes pulseGreen{0%{box-shadow:0 0 0 0 rgba(22,163,74,.6);}70%{box-shadow:0 0 0 6px rgba(22,163,74,0);}100%{box-shadow:0 0 0 0 rgba(22,163,74,0);}}
.fab-main{position:relative;z-index:2;font-size:13.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}
.fab::before{content:'';position:absolute;top:-60%;bottom:-60%;width:38%;left:-50%;z-index:1;
  background:linear-gradient(100deg,rgba(255,255,255,0) 0%,rgba(255,255,255,.7) 50%,rgba(255,255,255,0) 100%);
  transform:skewX(-18deg);animation:shine 3.4s ease-in-out infinite;}
@keyframes shine{0%{left:-50%;}45%{left:120%;}100%{left:120%;}}
@media(prefers-reduced-motion:reduce){.fab::before{animation:none;opacity:0;}.fab-dot{animation:none;}}
@media(max-width:380px){.fab{right:10px;bottom:10px;padding:9px 14px;}.fab-main{font-size:12px;}}

/* ---------- ムスリムフレンドリー ---------- */
.halal-icon{width:42px;height:42px;color:var(--shu);margin:0 auto 18px;display:block;}


/* ---------- ヒーロー左の目次（動画に重ねる） ---------- */
.hero-stage{position:relative;overflow:hidden;}
.hero-nav a{display:block;font-family:var(--disp);font-weight:600;text-transform:uppercase;
  letter-spacing:.045em;color:#fff;transition:color .3s,transform .4s cubic-bezier(.16,1,.3,1);
  text-shadow:0 2px 22px rgba(0,0,0,.75);}
.hero-nav a:hover{color:#dcc08a;transform:translateX(8px);}
@media(min-width:900px){
  .hero-nav{position:absolute;inset:0;z-index:4;display:flex;align-items:flex-end;pointer-events:none;
    padding-bottom:clamp(14px,min(2.4vh,2.6vw),38px);}
  .hero-nav .wrap{pointer-events:auto;}
  .hero-nav a{font-size:clamp(16px,min(2.3vw,3.1vh),32px);line-height:1;
    padding:clamp(5px,min(1vh,1.05vw),13px) 0;width:max-content;}
}
/* 狭い画面ではヘッダーのハンバーガーに集約する */
@media(max-width:899px){ .hero-nav{display:none;} }
/* 左端を少し落として文字を読ませる */
.hero-media::before{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(90deg,rgba(20,17,16,.62) 0%,rgba(20,17,16,.30) 34%,rgba(20,17,16,0) 58%);}
@media(max-width:899px){.hero-media::before{display:none;}}

/* ---------- cards ---------- */
.grid3{display:grid;gap:14px;}
@media(min-width:820px){.grid3{grid-template-columns:repeat(3,1fr);}}
.card{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:24px 22px;}
.card h3{font-family:var(--disp);font-weight:600;font-size:16.5px;line-height:1.5;margin:0 0 9px;}
.card p{font-size:14.5px;line-height:1.9;color:var(--sumi-2);}

/* ---------- courses ---------- */
/* ---------- コース選択の導入（内観写真を背景に） ---------- */
.msel{position:relative;isolation:isolate;overflow:hidden;text-align:center;
  margin:clamp(30px,4vw,52px) 0 clamp(28px,3.8vw,44px);
  padding:clamp(40px,6vw,80px) clamp(22px,4vw,60px);
  background-image:url("{{ IMG.band }}");background-size:cover;background-position:center;}
.msel::before{content:'';position:absolute;inset:0;z-index:-1;
  background:linear-gradient(180deg,rgba(6,5,4,.62) 0%,rgba(6,5,4,.78) 100%);}
.msel .eyebrow{color:#e0c793;}
.msel .eyebrow::before{background:#9c2c3d;}
.msel-p{max-width:640px;margin:16px auto 0;font-size:16px;line-height:1.95;color:rgba(255,255,255,.9);}
.msel-tap{margin-top:16px;font-family:var(--body);font-weight:500;font-size:12px;letter-spacing:.1em;
  text-transform:uppercase;color:rgba(255,255,255,.66);}
.scar{margin-top:22px;padding-top:20px;border-top:1px solid rgba(255,255,255,.22);}
.scar-1{font-family:var(--body);font-weight:600;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:#e0c793;}
.scar-2{margin-top:8px;display:inline-flex;align-items:center;gap:8px;font-family:var(--body);font-weight:500;
  font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.72);}
.scar-dot{width:7px;height:7px;border-radius:50%;background:#3fae6a;box-shadow:0 0 0 3px rgba(63,174,106,.22);}
.pick{display:grid;gap:16px;}
@media(min-width:640px){.pick{grid-template-columns:repeat(2,1fr);align-items:start;}}
@media(min-width:1000px){.pick{grid-template-columns:repeat(4,1fr);}}
.pc{position:relative;background:var(--paper-2);border:1px solid var(--line);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;}
.pc.best{border:2px solid var(--shu);box-shadow:0 8px 30px rgba(168,52,42,.13);}
.pc-flag{position:absolute;right:0;top:0;z-index:2;background:var(--shu);color:#fff;font-size:10px;font-weight:600;
  letter-spacing:.14em;text-transform:uppercase;padding:6px 12px;border-radius:0 0 0 6px;}
.pc-img{aspect-ratio:4/3;overflow:hidden;background:var(--paper-3);}
.pc-img img{width:100%;height:100%;object-fit:cover;}
.pc-in{padding:20px 20px 22px;display:flex;flex-direction:column;flex:1;}
.pc-cat{font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--brass);}
.pc-name{font-family:var(--disp);font-weight:600;font-size:18px;line-height:1.45;margin-top:7px;}
.pc-price{margin-top:11px;font-family:var(--disp);font-size:26px;font-weight:600;color:var(--shu);line-height:1;}
.pc-price small{font-family:var(--body);font-size:11px;font-weight:400;color:var(--sumi-3);margin-left:6px;}
.pc-lead{margin-top:11px;font-size:14.2px;line-height:1.85;color:var(--sumi-2);}
.pc-list{margin-top:13px;border-top:1px solid var(--line);padding-top:11px;flex:1;}
.pc-list li{list-style:none;display:flex;gap:8px;font-size:13.6px;line-height:1.7;color:var(--sumi-2);padding:4px 0;}
.pc-list li::before{content:'\2014';color:var(--shu);flex-shrink:0;}
.pc-btn{margin-top:16px;width:100%;background:var(--sumi);color:var(--paper);border:none;cursor:pointer;
  font-family:var(--body);font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:15px;border-radius:5px;transition:background .2s;}
.pc-btn:hover{background:#000;}
.pc.best .pc-btn{background:var(--shu);box-shadow:0 3px 0 var(--shu-d);}
.pc.best .pc-btn:hover{background:var(--shu-l);}

.tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:26px;}
table.cmp{width:100%;min-width:420px;max-width:840px;margin-inline:auto;border-collapse:collapse;background:var(--paper-2);border:1px solid var(--line);font-size:14px;}
table.cmp th,table.cmp td{padding:13px 15px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;}
table.cmp thead th{background:var(--paper-3);font-family:var(--disp);font-weight:600;font-size:13px;}
table.cmp tbody th{font-weight:600;color:var(--sumi-2);font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;width:1%;}
table.cmp .hi{color:var(--shu);font-weight:600;}

/* ---------- reviews ---------- */
.rev-wrap{display:grid;gap:14px;margin-top:26px;}
@media(min-width:820px){.rev-wrap{grid-template-columns:repeat(2,1fr);}}
.rev{background:var(--paper-2);border:1px solid var(--line);border-radius:6px;padding:22px 21px;}
.stars{color:#c9962a;font-size:14px;letter-spacing:2px;}
.rev-src{font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--sumi-3);margin-left:8px;}
.rev p{font-family:var(--disp);font-size:16px;line-height:1.9;margin:12px 0 14px;}
.rev cite{font-style:normal;font-size:12.5px;color:var(--sumi-2);}

/* ---------- faq / access ---------- */
.faq{border-top:1px solid var(--line);margin-top:24px;}
.faq details{border-bottom:1px solid var(--line);}
.faq summary{cursor:pointer;list-style:none;padding:17px 32px 17px 0;position:relative;font-family:var(--disp);font-weight:600;font-size:15px;line-height:1.6;}
.faq summary::-webkit-details-marker{display:none;}
.faq summary::after{content:'+';position:absolute;right:4px;top:15px;color:var(--shu);font-size:20px;font-weight:400;}
.faq details[open] summary::after{content:'\2212';}
.faq p{padding:0 0 19px;font-size:14.5px;line-height:1.9;color:var(--sumi-2);}
.acc{display:grid;gap:22px;margin-top:24px;}
@media(min-width:860px){.acc{grid-template-columns:1fr 1fr;}}
.dl{border-top:1px solid var(--line);}
.dl div{display:grid;grid-template-columns:104px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid var(--line);}
@media(max-width:520px){.dl div{grid-template-columns:1fr;gap:4px;}}
.dl dt{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--sumi-3);padding-top:4px;}
.dl dd{font-size:15px;line-height:1.78;}
.dl dd a{color:var(--shu);border-bottom:1px solid rgba(168,52,42,.3);}
.mapbox{position:relative;width:100%;aspect-ratio:4/3;border:1px solid var(--line);border-radius:6px;overflow:hidden;}
.mapbox iframe{position:absolute;inset:0;width:100%;height:100%;border:0;}

/* ---------- final / footer ---------- */
.final{background:var(--sumi);color:var(--paper);}
.final h2,.final .sh{color:var(--paper);}
.final .lead{color:rgba(244,239,229,.72);}
.final .cta-sub{color:rgba(244,239,229,.55);}
footer{background:var(--sumi);color:rgba(244,239,229,.78);padding:clamp(52px,8vw,104px) 0 clamp(28px,4vw,48px);font-size:14px;}
.ft-grid{display:grid;gap:clamp(32px,5vw,58px);}
@media(min-width:820px){.ft-grid{grid-template-columns:1.4fr 1fr;}}
.ft-small{font-size:12px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,239,229,.5);}
.ft-logo{width:clamp(120px,16vw,190px);height:auto;margin-bottom:20px;}
.ft-name{font-family:var(--disp);font-weight:600;font-size:clamp(21px,3.2vw,36px);line-height:1.24;letter-spacing:-.008em;color:var(--paper);margin-top:4px;}
.ft-addr{margin-top:20px;line-height:1.95;color:rgba(244,239,229,.72);}
.ft-addr a{color:#e7c98c;}
.ft-nav{display:grid;gap:2px;}
@media(min-width:820px){.ft-nav{justify-items:start;margin-left:auto;}}
.ft-nav a{font-family:var(--disp);font-weight:600;font-size:clamp(16px,1.9vw,20px);letter-spacing:.03em;padding:9px 0;color:rgba(244,239,229,.92);transition:color .3s;}
.ft-nav a:hover{color:#fff;}
.ft-bar{margin-top:clamp(34px,5vw,60px);padding-top:20px;border-top:1px solid rgba(244,239,229,.2);
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-size:12px;letter-spacing:.1em;color:rgba(244,239,229,.6);}

  border-top:1px solid rgba(244,239,229,.16);display:flex;align-items:center;gap:12px;padding:10px var(--gut);
  transform:translateY(110%);transition:transform .4s cubic-bezier(.16,1,.3,1);}
.sticky.show{transform:none;}
.sticky-t{flex:1;min-width:0;color:var(--paper);line-height:1.35;}
.sticky-t b{display:block;font-size:13px;font-weight:600;}
.sticky-t span{display:block;font-size:11.5px;color:rgba(244,239,229,.75);}
.sticky-b{flex-shrink:0;background:var(--shu);color:#fff;border:none;cursor:pointer;font-family:var(--body);font-weight:600;
  font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:14px 20px;border-radius:5px;box-shadow:0 3px 0 var(--shu-d);}
.sticky-b:active{transform:translateY(2px);box-shadow:0 1px 0 var(--shu-d);}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJKTLQJ6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="strip"><span data-i18n="strip.line"><b>Reservations recommended 2 weeks in advance.</b> Walk-ins welcome subject to availability.</span></div>

<header class="hd">
  <div class="wrap hd-in">
    <a class="mark" href="#top" aria-label="{{ store.name_full_en }}"><img src="/images/logo-gtj.png" alt="Gastronomic Tour of JAPAN"/></a>
    <div class="hd-r">
      <button class="langbtn" id="langOpen" aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.5 2.6 2.5 15 0 17.2M12 3.4c-2.5 2.6-2.5 15 0 17.2"/></svg>
        <span id="langNow">English</span>
      </button>
      <button class="hd-cta" onclick="openReserve('header')" data-i18n="nav.reserve">Reserve</button>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><span class="bl"></span><span class="bl"></span><span class="btx" id="btx">MENU</span></button>
    </div>
  </div>
</header>

<div class="sheet" id="langSheet" role="dialog" aria-modal="true" aria-label="Language">
  <div class="sheet-in">
    <h4 data-i18n="lang.h">Language</h4>
    <p data-i18n="lang.p">The menu and information are the same in every language.</p>
    <div class="sheet-list" id="langList"></div>
  </div>
</div>

<div class="ovl" id="ovl">
  <div class="ovl-in wrap">
    <nav>
      <a href="#courses" data-nav data-i18n="nav.menu">Menu</a>
      {% if SHOW_PERFORMANCE %}<a href="#performance" data-nav data-i18n="nav.performance">Performance</a>{% endif %}
      <a href="#voices" data-nav data-i18n="voices.label">Guest Voices</a>
      <a href="#halal" data-nav data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#faq" data-nav>FAQ</a>
      <a href="#access" data-nav data-i18n="nav.access">Access</a>
    </nav>
  </div>
  <div class="ovl-foot wrap">
    <img class="ovl-logo" src="/images/logo-gtj.png" alt=""/>
    <p>{{ store.name_full_en }}<br/>{{ store.address_en_line1 }}{% if store.tel_display != 'TBD' %} &middot; <a href="tel:{{ store.tel_raw }}">{{ store.tel_display }}</a>{% endif %}</p>
  </div>
</div>

<!-- ================= HERO ================= -->
<section id="top">
  <div class="hero-stage">
  <div class="hero-media">
    <video autoplay muted loop playsinline preload="metadata" poster="{{ IMG.poster }}"><source src="{{ IMG.hero }}" type="video/mp4"/></video>
  </div>
  <nav class="hero-nav">
    <div class="wrap">
      <a href="#concept" data-i18n="nav.experience">The Experience</a>
      <a href="#courses" data-i18n="nav.menu">Menu</a>
      {% if SHOW_PERFORMANCE %}<a href="#performance" data-i18n="nav.performance">Performance</a>{% endif %}
      <a href="#voices" data-i18n="voices.label">Guest Voices</a>
      <a href="#halal" data-i18n="nav.halal">Muslim-Friendly</a>
      <a href="#faq">FAQ</a>
      <a href="#access" data-i18n="nav.access">Access</a>
      <a href="#reserve" data-i18n="nav.reserve">Reserve</a>
    </div>
  </nav>
  </div>
  <div class="wrap hero-body">
    <p class="eyebrow" data-i18n="hero.tour">Gastronomic Tour of Japan</p>
    <h1 class="hero-h">{{ store.name_full_en }}</h1>
    <p class="hero-p" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
    <div class="trust">
      <span class="chip"><b>&#9733; {{ store.rating }}</b> Google &middot; {{ store.rating_count }} <span data-i18n="ui.reviews">reviews</span></span>
    </div>
    <div style="margin-top:22px;">
      <button class="cta-lg" onclick="openReserve('hero')" data-ga-event="reserve_click" data-ga-location="hero">
        <strong data-i18n="{% if store.reserve_system == 'form' %}reserve.btn{{ store.theme | capitalize }}{% else %}reserve.btnTc{% endif %}">{% if store.reserve_system == 'form' %}Reserve Your Omakase{% else %}Reserve on TableCheck{% endif %}</strong>
        <span data-i18n="menu.note">All Muslim-friendly &middot; Seasonal menu</span>
      </button>
      <p class="cta-sub" data-i18n="{% if store.reserve_system == 'form' %}reserve.noteForm{% else %}reserve.noteTc{% endif %}">{% if store.reserve_system == 'form' %}* Reservation is confirmed after email from {{ stores.brand.brand_name }}.{% else %}* Reservation handled by TableCheck — secure &amp; instant.{% endif %}</p>
    </div>
  </div>
</section>

<!-- ================= EXPERIENCE ================= -->
<section class="pad" id="concept">
  <div class="wrap">
    <div class="center reveal" style="max-width:660px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="exp.label">The Experience</span>
      {% if store.projection_mapping %}
      <h2 class="sh" data-i18n="exp.pm.h">Sushi &amp; Wagyu Course &times; Projection Mapping</h2>
      <p class="lead" data-i18n="exp.pm.p">Not just a meal — a journey through Japan.</p>
      {% else %}
      <h2 class="sh" data-i18n="exp.h">A Journey Through Japan</h2>
      <p class="lead" data-i18n="exp.p">A journey through Japan's food culture — wagyu, sushi, and projection-mapped dining. Muslim-friendly omakase, crafted for travelers from around the world.</p>
      {% endif %}
    </div>
    <div class="slider" data-slider>
      <div class="slides">
        <img src="/images/interior-01.jpg" alt="" class="on"/>
        <img src="/images/interior-02.jpg" alt="" loading="lazy"/>
        <img src="/images/interior-03.jpg" alt="" loading="lazy"/>
        <img src="/images/interior-04.jpg" alt="" loading="lazy"/>
      </div>
      <button class="s-nav prev" data-slide-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="s-nav next" data-slide-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="s-dots" data-slide-dots></div>
    </div>

    <div class="grid3 reveal" style="margin-top:30px;">
      <div class="card">
        <h3 data-i18n="story.q.label">Our Commitment to Quality</h3>
        <p data-i18n="story.q.p">I visit livestock farms all over Japan and purchase only Wagyu that I truly accept by the whole head.</p>
      </div>
      <div class="card">
        <h3 data-i18n="halal.label">Muslim-Friendly Dining</h3>
        <p data-i18n="halal.p1">We thoughtfully prepare pork-free, alcohol-free dishes.</p>
      </div>
      <div class="card">
        <h3 data-i18n="story.w.label">For Everyone in the World</h3>
        <p data-i18n="story.w.p">This restaurant was born to share authentic Japanese food culture with everyone.</p>
      </div>
    </div>
  </div>
</section>

{% if SHOW_PERFORMANCE %}
<!-- ================= PERFORMANCE ================= -->
<section class="pad" style="background:var(--paper-3);" id="performance">
  <div class="wrap">
    <div class="center reveal" style="max-width:660px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="menu.chefs">Chef&rsquo;s Omakase</span>
      <h2 class="sh" data-i18n="nav.performance">Performance</h2>
      <p class="lead" data-i18n="exp.pm.p">Not just a meal — a journey through Japan.</p>
    </div>
    <div class="reels reveal">
      <div class="reel">
        <video autoplay muted loop playsinline preload="none" poster="/images/perf-01-poster.jpg"><source src="/images/perf-01.mp4" type="video/mp4"/></video>
        <div class="reel-cap"><b>{{ store.region_label }}</b><span data-i18n="nav.performance">Performance</span></div>
      </div>
      <div class="reel">
        <video autoplay muted loop playsinline preload="none" poster="/images/perf-02-poster.jpg"><source src="/images/perf-02.mp4" type="video/mp4"/></video>
        <div class="reel-cap"><b>{{ store.region_label }}</b><span data-i18n="nav.performance">Performance</span></div>
      </div>
    </div>
  </div>
</section>

{% endif %}

<!-- ================= COURSES ================= -->
<section class="pad" style="background:var(--paper-3);" id="courses">
  <div class="wrap">
    <div class="center reveal" style="max-width:660px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="menu.chefs">Chef&rsquo;s Omakase</span>
      <h2 class="sh" data-i18n="menu.{{ store.theme }}H">Omakase Course</h2>
      <p class="lead" data-i18n="menu.{{ store.theme }}P">Authentic omakase, served Muslim-friendly.</p>
    </div>

    <div class="reveal msel">
      <span class="eyebrow" data-i18n="menu.label">Course Selection</span>
      <p class="msel-p" data-i18n="menu.omakase">Ever heard of &ldquo;omakase&rdquo;? It's the chef's-choice course — we hand-pick the season's finest ingredients and serve only what tastes best right now.</p>
      <p class="msel-tap" data-i18n="menu.tap">Tap a course to see full details &middot; All dishes Muslim-friendly &middot; Seasonal menu</p>
      <div class="scar">
        <p class="scar-1" data-i18n="scarcity.seats">Seats are limited — reservation recommended</p>
        <p class="scar-2"><span class="scar-dot"></span><span data-i18n="scarcity.few">Only a few seats left today</span></p>
      </div>
    </div>
    </div>


    {% set FEATURED = TH.ids %}
    {% if store.theme == "wagyu" %}{% set CMP = ["wagyu-standard","kobe-premium"] %}
    {% else %}{% set CMP = ["sushi-standard","sushi-premium"] %}{% endif %}
    <div class="pick reveal" style="margin-top:30px;">
      {% for fid in FEATURED %}{% for c in courses.list %}{% if c.id == fid %}
      {% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}
      <div class="pc{% if c.premium %} best{% endif %}">
        {% if c.web_only %}<span class="pc-flag" data-i18n="tag.web">Web exclusive</span>{% endif %}
        {% if c.premium %}<span class="pc-flag" data-i18n="tag.recommended">Recommended</span>{% endif %}
        <div class="pc-img"><img src="{{ c.img }}" alt="" loading="lazy"/></div>
        <div class="pc-in">
          <span class="pc-cat" data-i18n="cat.{{ c.cat }}.label">{% for cc in courses.cats %}{% if cc.key == c.cat %}{{ cc.label.en }}{% endif %}{% endfor %}</span>
          <h3 class="pc-name" data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</h3>
          {% if showPrice %}<p class="pc-price">&yen;{{ yen(p) }}<small>&yen;{{ yen((p * 1.1) | round(0,"floor") | int) }} <span data-i18n="course.incl">incl. tax</span></small></p>{% endif %}
          <p class="pc-lead" data-i18n="course.{{ c.id }}.lead">{{ c.lead.en }}</p>
          <ul class="pc-list">
            {% for r in c.rows %}{% if loop.index0 == 2 or loop.index0 == 3 or loop.index0 == 4 %}<li>{{ r }}</li>{% endif %}{% endfor %}
          </ul>
          <a class="pc-btn" style="display:block;text-align:center;text-decoration:none;" href="/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}courses/#{{ c.id }}" data-ga-event="course_view" data-ga-location="{{ c.id }}" data-i18n="course.view">View course</a>
        </div>
      </div>
      {% endif %}{% endfor %}{% endfor %}
    </div>

    <div class="tbl-scroll reveal" id="cmp">
      <table class="cmp">
        <thead><tr><th></th>
          {% for fid in CMP %}{% for c in courses.list %}{% if c.id == fid %}<th data-i18n="course.{{ c.id }}.name">{{ c.name.en }}</th>{% endif %}{% endfor %}{% endfor %}
        </tr></thead>
        <tbody>
          {% if store.theme == "wagyu" %}
          <tr><th data-i18n="cmp.beef">Beef</th><td>Wagyu</td><td class="hi">Kobe Beef</td></tr>
          <tr><th data-i18n="cmp.steak">Fillet steak</th><td>100g</td><td class="hi">100g</td></tr>
          <tr><th data-i18n="cmp.spring">Spring roll</th><td>Wagyu</td><td class="hi">Kobe Beef</td></tr>
          <tr><th data-i18n="cmp.nikuzushi">Nikuzushi</th><td>Wagyu 20g</td><td class="hi">Kobe Beef 20g</td></tr>
          {% else %}
          <tr><th data-i18n="cmp.nigiri">Nigiri</th><td>10</td><td>10</td></tr>
          <tr><th data-i18n="cmp.roll">Hand roll</th><td>Salmon &amp; Ikura</td><td class="hi">Sea Urchin &middot; Salmon &amp; Ikura</td></tr>
          <tr><th data-i18n="cmp.extra">Sea urchin &amp; crab</th><td>&mdash;</td><td class="hi">&#10003;</td></tr>
          <tr><th data-i18n="cmp.chawan">Chawanmushi</th><td>Shrimp</td><td class="hi">Snow Crab</td></tr>
          {% endif %}
          {% if showPrice %}
          <tr><th data-i18n="cmp.price">Price</th>
            {% for fid in CMP %}{% for c in courses.list %}{% if c.id == fid %}{% set p = c.base + (0 if c.noadj else (store.price_adjust or 0)) %}<td>&yen;{{ yen(p) }}</td>{% endif %}{% endfor %}{% endfor %}
          </tr>{% endif %}
        </tbody>
      </table>
    </div>

    <div class="center reveal">
      <p class="lead" style="font-size:12.5px;" data-i18n="menu.season">* Ingredients may vary depending on the season.</p>
      <a class="cbtn" href="/{{ store.region }}/{{ store.slug }}/{{ store.channel_suffix }}courses/" style="margin-top:8px;" data-ga-event="course_view" data-ga-location="view_all">{{ circ() }}<span class="lbl" data-i18n="course.viewAll">View all courses</span></a>
    </div>
  </div>
</section>

<!-- ================= VOICES ================= -->
<section class="pad" id="voices">
  <div class="wrap">
    <div class="center reveal" style="max-width:620px;margin-inline:auto;">
      <span class="eyebrow" data-i18n="voices.label">Guest Voices</span>
      <h2 class="sh" data-i18n="voices.h">From Around the World</h2>
      <p class="lead" data-i18n="voices.p">A selection of impressions shared by our guests.</p>
    </div>
    <div class="rev-wrap reveal">
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p>Beautifully presented Wagyu, thoughtfully served. The Muslim-friendly menu meant my family from Dubai could fully enjoy the experience. Truly felt at home.</p><cite>Dubai, UAE</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p>The course was theatrical — watching the chef carve the wagyu felt like a performance. The quality of the beef is on another level. Worth every yen.</p><cite>New York, USA</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Tripadvisor</span>
        <p>真正的日本和牛體驗，完全不同於香港吃到的。低溫慢煮帶出的甘甜讓人難忘。師傅對每一片肉的態度就像對藝術品一樣。</p><cite>Hong Kong</cite></div>
      <div class="rev"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span class="rev-src">Google</span>
        <p>As a Muslim food lover, finding an authentic Muslim-friendly omakase in Japan was a dream. The attention to dietary detail and respect for our needs really showed. The wagyu itself was sublime.</p><cite>Kuala Lumpur</cite></div>
    </div>
    <div class="gcard reveal">
      <div class="gword" aria-label="Google"><i class="g1">G</i><i class="g2">o</i><i class="g3">o</i><i class="g4">g</i><i class="g5">l</i><i class="g6">e</i></div>
      <p class="g-sub" data-i18n="ui.googleReviews">Google reviews</p>
      <div class="g-row">
        <span class="g-num">{{ store.rating }}</span>
        <span class="g-right">
          <span class="g-stars"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></span>
          <span class="g-out" data-i18n="ui.outOf5">out of 5</span>
        </span>
      </div>
      <p class="g-count">{{ store.rating_count }}<small data-i18n="ui.reviews">reviews</small></p>
      {% if store.maps_link != 'TBD' %}
      <a class="g-link" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="reviews_click" data-ga-location="voices"><span data-i18n="ui.seeReviews">See reviews on Google</span></a>
